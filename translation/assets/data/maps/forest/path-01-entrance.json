  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Man!\\. We've been sitting here quite a while.\\. This place is pretty serene.",
       "transl": "Pfff...\\. Jetzt sitzen wir schon eine ganze Weile hier und nichts passiert."
      }
     },
     {
      "text": {
       "orig": "Yeah...\\. but does something seem different now?\\. Like was that flower there before?",
       "transl": "Ja...\\. aber irgendwas hat sich gerade verändert!\\. War die Blume da drüben vorher auch schon?"
      }
     },
     {
      "text": {
       "orig": "Which one?\\. Maybe there's been a patch recently...",
       "transl": "Welche?\\. Vielleicht haben die gerade wieder das Spiel gepatcht..."
      }
     },
     {
      "text": {
       "orig": "Something feels off.\\. What if WE were just patched in?\\. We wouldn't even remember it!",
       "transl": "Irgendwas ist hier komisch.\\. Was, wenn WIR gerade reingepatcht wurden?\\. Wir hätten das nicht mal mitgekriegt!"
      }
     },
     {
      "text": {
       "orig": "Of course not. That would be silly.",
       "transl": "Ach was. Das wäre doch albern."
      }
     },
     {
      "text": {
       "orig": "Ha!\\. Bet you were hot-fixed to say that!",
       "transl": "Ha!\\. Ich wette, du wurdest gehotfixt, um das zu sagen!"
      }
     }
    ]
   }
