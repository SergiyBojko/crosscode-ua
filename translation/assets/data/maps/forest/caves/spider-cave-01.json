   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "text": {
          "orig": "..A Trial it is you seek, and a trial you shall receive... ",
          "transl": "...Випробування ти шукаєш - випробування ти й отримаєш..."
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "text": {
          "orig": "...A warrior must stay focused even when surrounded...",
          "transl": "...Воїн має зберігати концентрацію, навіть коли в оточенні..."
         }
        },
        {
         "text": {
          "orig": "...This trial will test both strength and speed...",
          "transl": "...Це випробування перевірить твою силу та швидкість..."
         }
        },
        {
         "text": {
          "orig": "...As your foes are fast and will grow in numbers even faster...",
          "transl": "...Адже вороги твої швидкі, а їхні ряди зростатимуть ще швидше..."
         }
        },
        {
         "text": {
          "orig": "...Now step into the ring and show us your \\c[3]Vigor\\c[0]...",
          "transl": "...А тепер виходь на Ринг і продемонструй нам свою \\c[3]Витривалість\\c[0]..."
         }
        },
        null,
        {
         "thenStep": [
          {
           "message": {
            "orig": "We have to fight now? Please just let it be spiders...",
            "transl": "Ми маємо битися? Тільки б це були павуки..."
           },
           "person": {
            "person": "main.emilie",
            "expression": "BROKEN"
           }
          },
          {
           "thenStep": [
            {
             "message": {
              "orig": "Now that's a plea I never imagined hearing...",
              "transl": "Оце вже прохання, якого я точно не очікував почути..."
             },
             "person": {
              "person": "main.glasses",
              "expression": "EXHAUSTED"
             }
            }
           ],
           "elseStep": [
            {
             "thenStep": [
              {
               "message": {
                "orig": "Emilie, please. No spiders, either!",
                "transl": "Емілі, прошу. Павуків теж не треба!"
               },
               "person": {
                "person": "antagonists.sidekick",
                "expression": "SURPRISED"
               }
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     },
     {
      "event": [
       {
        "text": {
         "orig": "...A warrior must stay focused even when surrounded...",
         "transl": "...Воїн має зберігати концентрацію, навіть коли в оточенні..."
        }
       },
       {
        "text": {
         "orig": "...This trial will test both strength and speed...",
