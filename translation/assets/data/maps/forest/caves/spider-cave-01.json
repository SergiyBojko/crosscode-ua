     null,
     {
      "event": {
       "quest": [
        {
         "text": {
          "orig": "...You have completed the \\c[3]Trial of Vigor\\c[0]...",
          "transl": "...Ти подолала \\c[3]Випробування Витривалості\\c[0]..."
         }
        },
        {
         "text": {
          "orig": "...Take this token as a sign of your victory...",
          "transl": "...Прийми це як свідчення твоєї перемоги..."
         }
        }
       ]
      }
     },
     {
      "event": [
       {
        "text": {
         "orig": "...Stay ever vigilant, Seeker...",
         "transl": "...Завжди залишайся пильною, Шукачко..."
        }
       }
      ]
     },
     {
      "event": {
       "quest": [
        null,
        {
         "thenStep": [
          null,
          null,
          null,
          {
           "text": {
            "orig": "...Welcome back Seeker...",
            "transl": "...З поверненням, Шукачко..."
           }
          },
          {
           "text": {
            "orig": "...You mastered all trials and even bested our champion...",
            "transl": "...Ти підкорила всі випробування і навіть здолала нашого чемпіона..."
           }
          },
          {
           "text": {
            "orig": "...Now it is time to test your limits...",
            "transl": "...Настав час перевірити межі твоїх можливостей..."
           }
          }
         ]
        },
        null,
        {
         "thenStep": [
          {
           "text": {
            "orig": "...Changed your mind, Seeker...",
            "transl": "...То ти передумала, Шукачко..."
