      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     {
      "message": {
       "orig": "Phew!\\. That was close...\\. again!\\. Haha...",
       "transl": "Puh!\\. Das war knapp...\\. Wieder einmal!\\. Haha..."
      },
      "person": {
       "person": "party-tmp.triblader-1",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Why?",
       "transl": "Чому?"
      },
      "person": {
       "person": "main.lea",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "Oh man, I really should try to be more careful, shouldn't I?",
       "transl": "Oh Mann, ich sollte wirklich versuchen, vorsichtiger zu sein, was?"
      },
      "person": {
       "person": "party-tmp.triblader-1",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "I'll try!\\. Anyway, thanks again for the rescue! ",
       "transl": "Ich versuch's!\\. Und danke nochmal für die Hilfe!"
      },
      "person": {
       "person": "party-tmp.triblader-1",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I gotta go!",
       "transl": "Ich muss los!"
      },
      "person": {
       "person": "party-tmp.triblader-1",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...Bye...",
       "transl": "... Бувай..."
      },
      "person": {
       "person": "main.lea",
       "expression": "NERVOUS"
      }
     },
