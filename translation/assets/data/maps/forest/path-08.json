      "event": {
       "quest": [
        null,
        {
         "text": {
          "orig": "...A Trial it is you seek, and a trial you shall receive... ",
          "transl": "... Du willst dich also prüfen lassen, so wollen wir dich prüfen..."
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "text": {
          "orig": "...Agility can be both a curse and a blessing...",
          "transl": "... Geschicklichkeit kann Fluch wie Segen ein..."
         }
        },
        {
         "text": {
          "orig": "...This trial will test your speed and reaction time...",
          "transl": "... Diese Prüfung wird deine Geschwindigkeit und Reaktionszeit testen..."
         }
        },
        {
         "text": {
          "orig": "...Simply follow this bug...",
          "transl": "... Folge einfach diesem Käfer..."
         }
        },
        {
         "text": {
          "orig": "...But be aware of its trickery...",
          "transl": "... Doch sei auf der Hut vor seiner List..."
         }
        },
        {
         "text": {
          "orig": "...Approach it to begin...",
          "transl": "... Nähere dich ihm, um zu beginnen..."
         }
        },
        null,
        null,
        {
         "thenStep": [
          {
           "message": {
            "orig": "I don't want to follow the bug! I want to run away from it!!",
