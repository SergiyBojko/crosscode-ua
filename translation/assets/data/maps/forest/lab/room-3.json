       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "SMUG"
        }
       },
       {
        "message": {
         "orig": "Still gaming this game with my gamer friends.\\. And I don't like losing, so talk to someone else.",
         "transl": "Bin immer noch mit meinen Zockerinos am Zocken.\\. Und ich verliere nicht gerne, geh also zu jemand anderem."
        },
        "person": {
         "person": "lab.scientist-xbox",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...bye.",
