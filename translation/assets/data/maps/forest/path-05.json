        null,
        null,
        null,
        null,
        null,
        {
         "text": {
          "orig": "...Perception is a skill few can master...",
          "transl": "... Wahrnehmung ist eine Fähigkeit, die nur wenige beherrschen..."
         }
        },
        {
         "text": {
          "orig": "...This trial will test your awareness and wit...",
          "transl": "... Diese Prüfung testet deine Achtsamkeit und Scharfsinnigkeit..."
