         }
        },
        {
         "message": {
          "orig": "This will be the end of you and no one will ever know the truth!",
          "transl": "Das wird dein Ende sein und niemand wird je die Wahrheit erfahren!"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "DETERMINED"
         }
        },
        {
         "message": {
          "orig": "D-dude, look where we are...\\.\\. this is madness!",
          "transl": "A-Alter, guck mal, wo wir sind...\\.\\. D-Das ist Wahnsinn!"
         },
         "person": {
          "person": "baki.thief-man-dude",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Silence!\\. These expensive preparations won't go to waste.\\.\\. And I'm out of here!",
          "transl": "Schweig!\\. All die teuren Vorbereitungen werden nicht umsonst gewesen sein.\\.\\. Und ich mache mich aus dem Staub!"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Bye!",
          "transl": "Бувай!"
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
