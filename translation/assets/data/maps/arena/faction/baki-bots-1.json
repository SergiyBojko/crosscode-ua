        null,
        null,
        null,
        {
         "name": {
          "orig": "Dourk",
          "transl": "Доурк"
         },
         "person": {
          "person": "baki.thief-man-dude",
          "expression": "DEFAULT"
         }
        },
        {
         "name": {
          "orig": "Billston",
          "transl": "Біллстон"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Well, well, well.\\. Where might you lot be going?",
          "transl": "Так, так, так.\\. І куди це ви зібралися?"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "DETERMINED"
         }
        },
        {
         "message": {
          "orig": "I knew something was wrong once I noticed my communicator missing.\\. You \\v[lore.title.seeker]s are a sneaky lot, hm?",
          "transl": "Я відразу запідозрив недобре, щойно помітив зникнення комунікатора.\\. Ви, Шукачі, ще ті хитруни, еге ж?"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        null,
        {
         "message": {
          "orig": "Forget it, man!\\. You messed up!\\. This is over!",
          "transl": "Забудь про це!\\. Ти проколовся!\\. Це кінець!"
         },
         "person": {
          "person": "baki.thief-man-dude",
          "expression": "DEFAULT"
         }
        },
        null,
        {
         "message": {
          "orig": "It is,\\.\\. r-\\.right...?",
          "transl": "Це ж...\\.\\. к-\\.кінець, т-\\.так...?"
         },
         "person": {
          "person": "baki.thief-man-dude",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Oh, for you it is.\\. Me, though?\\.\\. I prepared something special just for moments like this!",
          "transl": "О, для тебе - так.\\. А от я...?\\.\\. Я підготував дещо особливе саме на такі випадки!"
         },
         "person": {
          "person": "guards.quest-male-mustache-white",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!?",
          "transl": "...!?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED"
         }
        },
