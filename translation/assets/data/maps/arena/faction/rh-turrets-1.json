  {
   "settings": {
    "analyzable": {
     "text": {
      "orig": "Guard Offcr Cedric",
      "transl": "Wm. Cedric"
     }
    },
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "name": {
         "orig": "Cedric",
         "transl": "Wm. Cedric"
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Greetings, \\v[lore.title.seeker]. I have to keep watch on the harbor and protect our citizens, so please excuse me.",
         "transl": "Grüß dich, Seeker. Ich halte hier Wache am Hafen, um die Bürger zu schützen. Also entschuldige mich bitte."
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "name": {
          "orig": "Cedric",
          "transl": "Wm. Cedric"
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-man-offcr-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hello, \\v[lore.title.seeker].\\. I assume they sent you to help me investigate this smuggling case?",
          "transl": "Hallo, Seeker.\\. Ich nehme an, du bist die Verstärkung für den Schmugglerfall?"
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-man-offcr-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Excellent.\\. I want you to examine the crates on the eastern part of the harbor.",
          "transl": "Ausgezeichnet.\\. Ich möchte, dass du die Kisten im östlichen Teil des Hafens überprüfst."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-man-offcr-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "The data signature of the suspicious goods has already been sent to you, so you should be able to sense it.",
          "transl": "Die Datensignatur der verdächtigen Güter wurde dir bereits übermittelt. Damit solltest du sie ausfindig machen können."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-man-offcr-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        },
        {
         "message": {
          "orig": "I'll be here investigating our leads to potential culprits.\\. Come back when you've found something.",
          "transl": "Ich bleibe hier und gehe die Hinweise zu möglichen Verdächtigen durch.\\. Komm zurück, wenn du was gefunden hast."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-man-offcr-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        }
       ]
      }
     },
     {
      "event": [
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "name": {
         "orig": "Cedric",
         "transl": "Wm. Cedric"
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "The crate should be somewhere around here so you better find it!",
         "transl": "Die Kiste muss hier irgendwo sein, mach dich also besser auf die Suche!"
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     null,
     {
      "event": [
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "name": {
         "orig": "Cedric",
         "transl": "Wm. Cedric"
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "You go find that suspicious dockworker!\\. I'll make sure he doesn't leave for the city.",
         "transl": "Du musst den verdächtigen Hafenarbeiter finden!\\. Ich passe hier auf, dass er den Hafen nicht verlässt."
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     null,
     null,
     {
      "event": [
       {
        "person": {
