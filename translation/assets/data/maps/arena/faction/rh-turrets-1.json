         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Well met, \\v[lore.title.seeker]. There has been no further trouble at the docks so far but we should stay vigilant.",
         "transl": "Gut gemacht, Seeker. Es gab an den Docks bisher keine Probleme mehr. Aber wir sollten wachsam sein."
        },
        "person": {
         "person": "rookie-harbor.faction-rhg-man-offcr-black",
         "expression": "DEFAULT"
        }
       }
      ]
