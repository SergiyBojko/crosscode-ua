  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "text": {
       "orig": "There is nothing on this table.",
       "transl": "Da ist nichts auf dem Tisch."
      }
     },
     {
      "text": {
       "orig": "T-the table surface is really shiny!",
       "transl": "D-Die Oberfläche des Tisches glänzt so schön!"
      }
     },
     {
      "text": {
       "orig": "Really? Is that why you have to sit on it?",
       "transl": "Echt? Hast du dich deswegen draufgesetzt?"
      }
     },
     {
      "text": {
       "orig": "Y-Yes! I have to inspect it really closely.",
       "transl": "J-Ja! Ich will ihn mir ganz genau ansehen!"
      }
     },
     {
      "text": {
       "orig": "I think I'm starting to get it.",
       "transl": "Ich glaube, ich fange an, dich zu verstehen."
      }
     },
     {
      "text": {
       "orig": "This is not about the table or what's on the table.",
       "transl": "Es geht nicht um den Tisch oder was auf dem Tisch ist."
      }
     },
     {
      "text": {
       "orig": "What?",
       "transl": "Was?"
      }
     },
     {
      "text": {
       "orig": "You just like to sit on tables, don't you?",
       "transl": "Du sitzt einfach gern auf Tischen, oder?"
      }
     },
     {
      "text": {
       "orig": "What?\\. No!\\. I just...\\. like to examine things closely.",
       "transl": "Was?\\. Nein!\\. Ich meine...\\. Ich mag's einfach, mir Sachen ganz genau anzuschauen.<<A<<[CHANGED 2021/05/22]"
      }
     },
     {
      "text": {
       "orig": "Just admit it already!",
       "transl": "Gib es einfach zu!"
      }
     }
    ]
   }
  },
  null,
  {
   "settings": {
    "npcStates": [
     {
      "event": [
       null,
       null,
       {
        "message": {
         "orig": "Good day and welcome to \\v[area.jungle-city.name], Seeker.",
         "transl": "Guten Tag und willkommen in Burg Bassin, Seeker."
        }
       },
       {
        "message": {
         "orig": "This hub serves as both a meeting place for Seekers as well as the bureau for most official business handled in the city.",
         "transl": "Dieser Hub fungiert nicht nur als Treffpunkt für Seeker, sondern auch als Büro für dienstliche Angelegenheiten der Stadt."
        }
       },
       {
        "message": {
         "orig": "Please be advised that while the mayor handles Seeker-related topics, his time is very limited.",
         "transl": "Der Bürgermeister kümmert sich auch um Seeker-Themen, bedenke aber, dass seine Zeit kostbar ist."
        }
       },
       {
        "message": {
         "orig": "As such, you are free to simply enter the Temples north of \\v[area.jungle.name] whenever you desire.",
         "transl": "Als Seeker kannst du jederzeit die Tempel im Norden von Gaias Garten besuchen."
        }
       },
       {
        "message": {
         "orig": "....",
         "transl": "...."
        }
       }
      ]
     }
    ]
