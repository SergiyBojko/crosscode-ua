     {
      "name": {
       "orig": "Claude Reynes",
       "transl": "Claude Reynes"
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "\\v[lore.title.seeker], it's good that you survived this rampage.\\. Are you feeling well?",
       "transl": "Gut, dass du diesen Amoklauf überlebt hast, Seeker.\\. Bist du ok?"
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "EXHAUSTED"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Good.\\. You've done well at least venting its anger.\\. I truly never saw such an unstoppable corrupted force before.",
       "transl": "Gut.\\. Dank deines Einsatzes konnte er zumindest seinem Ärger einmal Luft machen.\\. So eine unaufhaltbare, boshafte Kraft habe ich noch nie gesehen."
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "... Why?",
       "transl": "... Чому?"
      },
      "person": {
       "person": "main.lea",
       "expression": "THINKING"
      }
     },
     {
      "message": {
       "orig": "It was deeply corrupted, charged with massive toxic energy that even concentrated blasts of \\c[3]Wave\\c[0] could not disperse.",
       "transl": "Sie war aufgeladen mit massiver toxischer Energie, die selbst konzentrierte Wellestösse nicht zerstreuen konnten."
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Such a threat will need special treatment to pacify.\\. One that can't be found within \\v[area.jungle.name].",
       "transl": "Eine solche Bedrohung wird eine besondere Behandlung erfordern, um sie zu befrieden.\\. Eine, die nicht innerhalb von Gaias Garten gefunden werden kann."
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "... How?",
       "transl": "... Як?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_AWAY"
      }
     },
     {
      "message": {
       "orig": "To cleanse such powerful toxic energy we must apply an equally powerful force of energized salt.",
       "transl": "Um solch starke toxische Energie zu reinigen, müssen wir eine ebenso starke Kraft von energetisiertem Salz anwenden."
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Where?",
       "transl": "Де?"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     {
      "message": {
       "orig": "Go meet \\c[3]Linde\\c[0] on the \\c[3]Isle of Legend\\c[0] in \\c[3]\\v[area.beach.name]\\c[0] and help her extract it!",
       "transl": "Triff dich mit \\c[3]Linde\\c[0] auf der \\c[3]Insel der Legende\\c[0] des \\c[3]Azur-Archipels\\c[0] und hilf ihr, es zu extrahieren!"
      },
      "person": {
       "person": "greenies-jungle.male-leader-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
   }
