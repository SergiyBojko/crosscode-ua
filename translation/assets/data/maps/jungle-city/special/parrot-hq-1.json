     {
      "message": {
       "orig": "Y-yes, hello?\\. Can we help you?",
       "transl": "J-Ja, hallo?\\. Können wir dir helfen?"
      },
      "person": {
       "person": "rookie-harbor.man-small-brown",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Dear, please.\\. No, we are not buying anything.\\. Now please let us eat in peace.",
