   "settings": {
    "event": [
     {
      "message": {
       "orig": "Tiny Laser Bridge!!",
       "transl": "Крихітний Лазерний Міст!!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SMILE"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Huh...\\. a little ruin surrounded by cliffs.",
       "transl": "Хм...\\. маленькі руїни, оточені скелями."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "Must have been a neat little place to chill out, far away from all the troubles of the world...",
       "transl": "Мабуть, було гарненьке місце, щоб відпочити подалі від усіх турбот..."
      },
      "person": {
       "person": "main.emilie",
       "expression": "AWAY"
      }
     }
    ]
   }
  },
