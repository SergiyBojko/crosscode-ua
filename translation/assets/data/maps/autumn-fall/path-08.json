  {
   "settings": {
    "event": [
     null,
     {
      "name": {
       "orig": "Joe the Younger",
       "transl": "Joe der Jüngere"
      }
     },
     null,
     {
      "message": {
       "orig": "Hey, \\v[lore.title.seeker]!\\. You won't believe what I just found in our databases!",
       "transl": "Hey, Seeker!\\. Du wirst nicht glauben, was ich gerade in unserer Datenbank entdeckt habe!"
      }
     },
     {
      "message": {
       "orig": "Did you know that rolling \\v[combat.name.hedgehog]s are among the top percent of roundest mammals on \\v[lore.title.planet]?\\. So neat!",
       "transl": "Wusstest du, dass rollende Igöll zu den rundesten Säugetieren auf Shadoon gehören?\\. Wie putzig!"
      }
     },
     {
      "message": {
       "orig": "Lea...",
       "transl": "Лія..."
      }
     },
     {
      "message": {
       "orig": "Oh wait, really? You already confronted another group of the \\c[3]Flying types\\c[0]?",
       "transl": "Hm, was? Du bist noch auf eine andere Gruppe \\c[3]fliegender Igöll\\c[0] gestoßen?"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "And then you found a strange electronic device?\\. Right next to the \\c[3]Flying type\\c[0] \\v[combat.name.hedgehog]?!",
       "transl": "Und hast dabei ein seltsames Elektrogerät gefunden?\\. Direkt neben den \\c[3]fliegenden Igölln\\c[0]?!"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Wow, that's funky.\\. Totally not \\v[combat.name.hedgehog]-like.",
       "transl": "Wow, das ist irre.\\. Das passt gar nicht zu Igölln."
      }
     },
     {
      "message": {
       "orig": "Wait!",
       "transl": "Зачекай!"
      }
     },
     {
      "message": {
       "orig": "What, it gave a signal?\\. So it's one of those location pinpoint devices that are often used to pinpoint locations.",
       "transl": "Was, es hat ein Signal abgegeben? Dann muss das wohl eines dieser Ortungsgeräte sein, die häufig zur Ortung von Orten eingesetzt werden."
      }
     },
     {
      "message": {
       "orig": "It could lead you to the \\c[3]Flying types'\\c[0] lair!\\. That would be incredible!\\. Come on, do it!",
       "transl": "Es könnte dich zu ihrem \\c[3]Versteck\\c[0] führen!\\. Das wäre unglaublich! Du musst unbedingt dranbleiben!"
      }
     },
     {
      "message": {
       "orig": "Bye...",
       "transl": "Бувай..."
      }
     }
    ]
   }
  }
 ]
