  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Huh...\\. a little ruin surrounded by cliffs.",
       "transl": "Hm...\\. Eine kleine Ruine umrandet von Klippen."
      }
     },
     {
      "message": {
       "orig": "Must have been a neat little place to chill out, far away from all the troubles of the world...",
       "transl": "Muss ein schöner Ort zum Ausruhen gewesen sein, weit weg von den Sorgen der Welt..."
      }
     }
    ]
