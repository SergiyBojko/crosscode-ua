  {
   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Yo, what's up?",
         "transl": "Йо, як справи?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "I see you got the \\c[3]\\v[item.410.name]\\c[0] with you! Nice, nice!",
           "transl": "Бачу, ти дістала \\c[3]Шейд Зірки\\c[0]. Гарно, гарно!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "Well then, good luck in \\c[3]Sapphire Ridge\\c[0]! Beware of bugs!",
           "transl": "Ну, тоді успіхів у \\c[3]Сапфірному Хребті\\c[0]! Стережися жуків!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "thenStep": [
           {
            "person": {
             "person": "main.emilie",
             "expression": "SUSPICIOUS"
            }
           },
           {
            "message": {
             "orig": "Wait... What was that?",
             "transl": "Чекай... Що він щойно сказав?"
            },
            "person": {
             "person": "main.emilie",
             "expression": "SUSPICIOUS"
            }
           }
          ]
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "If you want to pass the barrier up ahead you first have to collect the \\c[3]\\v[item.410.name]\\c[0].",
           "transl": "Щоб розблокувати цей бар'єр, тобі потрібно отримати \\c[3]Шейд Зірки\\c[0]."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "You get it at the end of the \\c[3]Grand Krys'kajo\\c[0] dungeon in \\c[3]Gaia's Garden\\c[0].",
           "transl": "Ти отримаєш його у кінці \\c[3]Величного Кріс'каджо\\c[0] у \\c[3]Саду Ґайї\\c[0]."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "If you've already finished the dungeon... just revisit the \\c[3]final boss room\\c[0]. I'm sure you'll find the shades somewhere in there.",
           "transl": "Якщо ти вже пройшла підземелля... просто повернися у \\c[3]кімнату боса\\c[0]. Думаю, ти знайдеш його десь там."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "...!",
           "transl": "...!"
          },
          "person": {
           "person": "main.lea",
           "expression": "ASTONISHED"
          }
         }
        ]
       }
      ]
     }
    ]
   }
