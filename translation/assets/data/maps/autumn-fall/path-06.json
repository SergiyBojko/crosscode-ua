  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "So Tronny, how unrealistic is this rock in particular?",
       "transl": "Sag mal, Tronny, ist dieser Stein hier nicht irgendwie unrealistisch?"
      }
     },
     {
      "message": {
       "orig": "I'm not that much of an expert when it comes to rocks, honestly...",
       "transl": "Ich muss zugeben, dass ich mich mit Steinen nicht so gut auskenne..."
      }
     },
     {
      "message": {
       "orig": "I suppose it's somewhat plausible. These shapes can form with erosion over time.",
       "transl": "Sieht aber recht plausibel aus. Diese Formen können mit der Zeit durch Erosion entstehen."
      }
     },
     {
      "message": {
       "orig": "Though not so sure why you'd find Ancient ruins on top of it of all places...",
       "transl": "Wobei ich mir nicht so sicher bin, warum sich darauf Ruinen der Ahnen befinden..."
      }
     },
     {
      "message": {
       "orig": "Thanks for the input, professor!",
       "transl": "Danke für den Beitrag, Herr Professor!"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Look, another ruin of an ancient puzzle village!",
       "transl": "Guck mal, noch eine Rätselruine eines uralten Dorfs!"
      }
     },
     {
      "message": {
       "orig": "I call this one...\\. La Petite-Brick-Ville! ",
       "transl": "Ich nenne es...\\. La Petite-Brick-Ville! "
      }
     },
     {
      "message": {
       "orig": "That's cute.",
       "transl": "Das ist süß."
      }
     },
     {
      "message": {
       "orig": "Got a better name, Nerd?",
       "transl": "Fällt dir was Besseres ein, Nerd?"
      }
     },
     {
      "message": {
       "orig": "Let's see... Since it used to be an Ancient village, I'd go for something close to their traditional names, like Faj'ro or Ba'kii Kum...",
       "transl": "Mal sehen... Da es mal ein Dorf der Ahnen war, schätze ich, dass es einen eher traditionellen Namen hatte, wie Faj'ro oder Ba'kii Kum..."
      }
     },
     {
      "message": {
       "orig": "Urgh, please forget I asked...",
       "transl": "Uff, vergiss es..."
      }
     }
    ]
   }
  }
 ]
}