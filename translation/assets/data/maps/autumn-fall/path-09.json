          },
          "person": {
           "person": "main.emilie",
           "expression": "MOPING"
          }
         },
         {
          "message": {
           "orig": "But it's cute!",
           "transl": "Але ж він милий!"
          },
          "person": {
           "person": "main.glasses",
           "expression": "SURPRISED"
          }
         },
