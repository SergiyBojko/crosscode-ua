      "thenStep": [
       {
        "message": {
         "orig": "We got it!\\. Nice work!",
         "transl": "У нас вийшло!\\. Гарна робота!"
        },
        "person": {
         "person": "main.glasses",
         "expression": "SMILE"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "Still annoyed they didn't make it explode.",
           "transl": "Я все ще розчарована, що він не вибухнув."
          },
          "person": {
           "person": "main.emilie",
           "expression": "SUSPICIOUS"
          }
         },
         {
          "message": {
           "orig": "Aren't you a bit cruel?",
           "transl": "Тобі не здається, що це трохи жорстоко?"
          },
          "person": {
           "person": "main.glasses",
           "expression": "WORRIED"
          }
         },
         {
          "message": {
           "orig": "They made us chase that thing for so long! The least they could give us is a proper bunny explosion!",
