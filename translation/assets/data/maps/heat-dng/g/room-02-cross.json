       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Wait, why a D-Link?\\. Isn't this a race?",
       "transl": "Warte mal, ein D-Link?\\. Ich dachte, das wäre ein Rennen?"
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
