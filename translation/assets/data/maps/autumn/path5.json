     null,
     null,
     {
      "message": {
       "orig": "Hm, I hope we don't get lost around here.",
       "transl": "Hm, ich hoffe, wir verlaufen uns hier nicht."
      }
     },
     null,
     {
      "message": {
       "orig": "Ah, over there!",
       "transl": "Ah, da drüben!"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Seems we have to head \\c[3]northwest\\c[0] to reach Bergen Trail.",
       "transl": "Sieht aus, als müssten wir nach \\c[3]Nordwesten\\c[0], um den Bergen-Trail zu erreichen."
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     null,
     null,
     null,
     {
      "message": {
       "orig": "I hope it's not too far.",
       "transl": "Ich hoffe, es ist nicht allzu weit."
      }
     },
     {
      "message": {
       "orig": "I will have to logout sooner or later, you see?",
       "transl": "Ich werde nämlich gleich mal offline gehen müssen."
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "message": {
       "orig": "Oh, don't worry. I'll stay until you beat up Mr. Grasshead!",
       "transl": "Oh, keine Sorge. Ich bleibe noch so lange, bis du Monsieur Graskopf verhauen hast."
      }
     },
     {
      "message": {
       "orig": "And please don't hurry too much because of me!",
       "transl": "Beeil dich aber bitte nicht extra meinetwegen!"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "Though there really is no reason for you to prepare for this duel, is there?",
         "transl": "Obwohl du es wahrscheinlich gar nicht nötig hast, dich auf das Duell vorzubereiten, oder?"
        }
       },
       {
        "message": {
         "orig": "[shakes head]",
         "transl": "[schüttelt Kopf]"
        }
       },
       {
        "message": {
         "orig": "Well, in any case!\\. C'est parti!",
         "transl": "Wie auch immer!\\. Lass uns gehen!"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "We have to make sure you're well trained, non?",
         "transl": "Wir wollen doch, dass du gut trainiert bist, non?"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        }
       },
       {
        "message": {
         "orig": "Alright, then...\\. C'est parti!",
         "transl": "Also dann...\\. C'est parti!"
        }
       }
      ]
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Hm...\\. That is right.",
       "transl": "Hm...\\. Das stimmt."
      }
     },
     {
      "message": {
       "orig": "We have been playing for a long while now, Lea.",
       "transl": "Wir haben nun schon eine ganze Weile gespielt, Lea."
      }
     },
     {
      "message": {
       "orig": "...?",
