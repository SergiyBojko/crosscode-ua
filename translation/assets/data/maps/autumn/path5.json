     null,
     {
      "message": {
       "orig": "I hope it's not too far.",
       "transl": "Сподіваюся, ми вже близько."
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "I will have to logout sooner or later, you see?",
       "transl": "Мені ж доведеться вийти з гри рано чи пізно, розумієш?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
