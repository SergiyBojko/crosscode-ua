     null,
     {
      "person": {
       "person": "main.lea",
       "expression": "PANIC"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "PANIC"
      }
     },
     {
      "person": {
       "person": "main.sergey",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "Lea?",
       "transl": "Ліє?"
      },
      "person": {
       "person": "main.sergey",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "That...\\. Lukas...\\. he does not remember what happened, correct?",
       "transl": "Той...\\. Лукас...\\. він не пам'ятає, що сталося, вірно?"
      },
      "person": {
       "person": "main.sergey",
       "expression": "COMPLEX"
      }
     },
     {
      "message": {
       "orig": "Why?",
       "transl": "Чому?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SCARED"
      }
     },
     {
      "message": {
       "orig": "I...\\. kind of suspected as much.",
       "transl": "Я...\\. щось таке й підозрював."
      },
      "person": {
       "person": "main.sergey",
       "expression": "WORRIED"
      }
     },
     {
      "message": {
       "orig": "Sorry, I should have talked with you about it.",
       "transl": "Вибач, я мав поговорити з тобою про це."
      },
      "person": {
       "person": "main.sergey",
       "expression": "EYES_CLOSED"
      }
     },
     {
      "message": {
       "orig": "That Lukas you met in Vermillion Wasteland...",
       "transl": "Той Лукас, якого ти зустріла у Вермільйоновій Пустці..."
      },
      "person": {
       "person": "main.sergey",
       "expression": "SERIOUS"
      }
     },
     {
      "message": {
       "orig": "He was most likely another \\c[3]Evotar\\c[0].",
       "transl": "Цілком ймовірно, також був \\c[3]Евотаром\\c[0]."
      },
      "person": {
       "person": "main.sergey",
       "expression": "DRAMATIC"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "In fact...\\. I suspect that was the case for all players we saw back there.",
       "transl": "Насправді...\\. підозрюю, що це стосується всіх гравців, яких ми там бачили."
      },
      "person": {
       "person": "main.sergey",
       "expression": "WORRIED"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SAD"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.sergey",
       "expression": "WORRIED"
      }
     },
     {
      "message": {
       "orig": "Do you...\\. not want to go back to them?",
       "transl": "Ти...\\. не хочеш повертатися до них?"
      },
      "person": {
       "person": "main.sergey",
       "expression": "NOTIFYING"
      }
     },
     {
      "message": {
       "orig": "[shakes head]",
       "transl": "[хитає головою]"
      },
      "person": {
       "person": "main.lea",
       "expression": "SHAKE_SAD"
      }
     },
     {
      "message": {
       "orig": "I see.",
       "transl": "Розумію."
      },
      "person": {
       "person": "main.sergey",
       "expression": "EYES_CLOSED"
      }
     },
     {
