       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi!",
       "transl": "Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I see you made an appointment for the raid tomorrow?\n",
       "transl": "Бачу, ти вирішила взяти участь у завтрішньому рейді?"
      },
      "person": {
       "person": "main.sergey",
       "expression": "NOTIFYING"
      }
     },
     {
      "message": {
       "orig": "[nods]",
