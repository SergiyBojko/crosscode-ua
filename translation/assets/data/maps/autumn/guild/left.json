       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi!",
       "transl": "Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I see you made an appointment for the raid tomorrow?\n",
       "transl": "Wie ich sehe, hast du dich morgen für den Raid verabredet?"
      },
      "person": {
       "person": "main.sergey",
       "expression": "NOTIFYING"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
