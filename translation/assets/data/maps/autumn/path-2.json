     },
     null,
     null,
     null,
     {
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "POINTING"
      }
     },
     {
      "message": {
       "orig": "So we meet again!",
       "transl": "So treffen wir uns wieder!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "POINTING"
