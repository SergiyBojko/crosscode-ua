      }
     },
     {
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "Mon Dieu, not this guy again~",
       "transl": "Mon Dieu, nicht der schon wieder."
      },
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "...Hi!",
       "transl": "... Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "CONTENT"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "I see your level remains as \\c[1]UNACCEPTABLE\\c[0] as it has been before!",
         "transl": "Wie ich sehe, ist dein Level noch genauso \\c[1]INAKZEPTABEL\\c[0] wie zuvor!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "SHOUTING"
        }
       },
       {
        "message": {
         "orig": "Why do you even care so much about this...\\.",
         "transl": "Warum stört dich das eigentlich so sehr...?\\."
        },
        "person": {
         "person": "main.emilie",
         "expression": "CURIOUS"
        }
       },
       null,
       {
        "message": {
         "orig": "AGAIN, SHE IS \\c[1]LEVEL \\v[player.level]\\c[0]!",
         "transl": "NOCHMAL: SIE HAT \\c[1]LEVEL \\v[player.level]\\c[0]!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "RAGING"
        }
       },
       null,
       {
        "message": {
         "orig": "EVERYBODY SHOULD CARE ABOUT THIS!!",
         "transl": "DAS SOLLTE DOCH JEDEN STÖREN!!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "DUMBFOUNDED"
        }
       },
       {
        "message": {
         "orig": "This game has \\c[1]RULES\\c[0]!!",
         "transl": "Dieses Spiel hat schließlich \\c[1]REGELN\\c[0]!!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "SHOUTING"
        }
       },
       {
        "message": {
         "orig": "Anyway...",
         "transl": "Jedenfalls..."
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "ANGRY"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "Good!\\. I see your level is now in an acceptable range. ",
         "transl": "Ah, gut!\\. Ich sehe, dein Level ist endlich im annehmbaren Rahmen."
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "CONTENT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_AWAY"
        }
       },
       {
        "message": {
         "orig": "As if that one level would have made a big difference.",
         "transl": "Als ob das eine Level einen Unterschied gemacht hätte."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       },
       {
        "message": {
         "orig": "However!",
         "transl": "Aber!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "SHOUTING"
        }
       },
       {
        "message": {
         "orig": "Your previous actions have not been forgotten!",
         "transl": "Deine vorherigen Schandtaten sind nicht vergessen!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "SHOUTING"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "Being a cheater is bad as it is. ",
       "transl": "Ein Cheater zu sein, ist schon schlimm genug!\n"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     },
     null,
     {
      "message": {
       "orig": "But seeing a \\c[3]Spheromancer\\c[0] displaying such dishonest behavior!\\. It breaks my heart!",
       "transl": "Aber einen \\c[3]Spheromancer\\c[0] zu sehen, der betrügt!\\. Das bricht mir das Herz!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "POINTING"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "NERVOUS"
      }
     },
     {
      "message": {
       "orig": "...What?",
       "transl": "... Що?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     null,
     {
      "message": {
       "orig": "We Spheromancers are a noble, yet unappreciated class!",
       "transl": "Wir Spheromancer sind eine edle, doch leider verkannte Klasse!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     },
     {
      "message": {
       "orig": "I can't allow a player like you to further damage our reputation!",
       "transl": "Ich kann es Spielern wie dir nicht durchgehen lassen, unseren Ruf weiter zu schädigen!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SHOUTING"
      }
     },
     {
      "message": {
       "orig": "Wait...\\. You're a Spheromancer, too?",
       "transl": "Moment...\\. Du bist auch ein Spheromancer?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "Why of course!\\. Don't you see my striking crimson outfit?",
       "transl": "Natürlich!\\. Siehst du nicht mein auffallend purpurnes Outfit?"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     },
     {
      "message": {
       "orig": "...Oh!",
       "transl": "... Oh!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Pardon, I thought you were a Triblader with all that green and...\\. pointy hair.",
       "transl": "Pardon, ich dachte du wärst ein Triblader, mit all dem Grün und dem...\\. spitzen Haar."
      },
      "person": {
       "person": "main.emilie",
       "expression": "WATCH_OUT_BADASS"
      }
     },
     {
      "message": {
       "orig": "It's my style.",
       "transl": "Das ist mein Stil!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "It's plain to see that fashion is beyond your grasp.",
       "transl": "Offensichtlich hast du keinen Sinn für Mode."
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "CONTENT"
      }
     },
     {
      "message": {
       "orig": "Suuuure~",
       "transl": "Genauuuuu~"
      },
      "person": {
       "person": "main.emilie",
       "expression": "TAUNTING"
      }
     },
     null,
     {
      "message": {
       "orig": "Anyway!\\. I'm talking to you, blue-haired Spheromancer!",
       "transl": "Egal!\\. Ich rede mit dir, blauhaariger Spheromancer!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SHOUTING"
      }
     },
     {
      "message": {
       "orig": "...\\.Lea.",
       "transl": "...\\. Lea."
      },
      "person": {
       "person": "main.lea",
       "expression": "MOPING"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     },
     {
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "CONTENT"
      }
     },
     {
      "message": {
       "orig": "I challenge you to a \\c[3]duel\\c[0]!",
       "transl": "Ich fordere dich zum \\c[3]Duell\\c[0] heraus!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "POINTING"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     {
      "person": {
       "person": "main.emilie",
       "expression": "SHOCKED"
      }
     },
     {
      "message": {
       "orig": "Wait, what?",
       "transl": "Moment, was?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SHOCKED"
      }
     },
     null,
     {
      "message": {
       "orig": "Come on!\\. We just started playing!",
       "transl": "Komm schon!\\. Wir haben gerade erst angefangen zu spielen!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     },
     null,
     {
      "message": {
       "orig": "Of course we won't do it right here and now.",
       "transl": "Natürlich werden wir das nicht hier und jetzt tun."
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "DOWN"
      }
     },
     {
      "message": {
       "orig": "Let's have our duel at the \\c[3]entrance of Bergen Trail\\c[0]!",
       "transl": "Lass uns das Duell am \\c[3]Eingang vom Bergen-Trail\\c[0] austragen!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "ANGRY"
      }
     },
     {
      "message": {
       "orig": "I'll test your skills properly - to make sure you don't use any more dishonest methods!",
       "transl": "Ich werde deine Fähigkeiten gründlich auf die Probe stellen - um sicherzustellen, dass du dich keiner unlauteren Methoden mehr bedienst!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "Ha...\\. you really think that's a good idea?",
         "transl": "Ha...\\. Das halte ich für keine schlaue Idee..."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SWEATY_SMILE"
        }
       },
       {
        "message": {
         "orig": "Trust me you haven't seen \\c[1]the worst of it\\c[0] yet.",
         "transl": "Glaub mir, du hast das \\c[1]Schlimmste\\c[0] noch nicht gesehen."
        },
        "person": {
         "person": "main.emilie",
         "expression": "EXHAUSTED"
        }
       },
       {
        "message": {
         "orig": "\\c[1]...!",
         "transl": "\\c[1]...!\\c[0]"
        },
        "person": {
         "person": "main.lea",
         "expression": "INSANE_DOWN"
        }
       }
      ],
      "elseStep": [
       {
        "thenStep": [
         {
          "message": {
           "orig": "Well she \\c[1]is level \\v[player.level]\\c[0]. So you can already guess how this will play out.",
           "transl": "Na ja, sie \\c[1]hat Level \\v[player.level]\\c[0]. Du kannst dir also denken, wie das ausgeht."
          },
          "person": {
           "person": "main.emilie",
           "expression": "SUSPICIOUS"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "Are you serious?",
           "transl": "Echt jetzt?"
          },
          "person": {
           "person": "main.emilie",
           "expression": "SUSPICIOUS"
          }
         }
        ]
       }
      ]
     },
     null,
     {
      "message": {
       "orig": "Do you accept, blue-haired Spheromancer?",
