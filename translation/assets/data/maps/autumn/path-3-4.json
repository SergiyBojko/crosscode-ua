  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Joe the Younger",
       "transl": "Joe der Jüngere"
      }
     },
     null,
     {
      "message": {
       "orig": "Wow, \\v[lore.title.seeker], did you just see what I saw?",
       "transl": "Wow, Seeker, hast du gerade gesehen, was ich gesehen hab'?"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Well, sure, you even fought them.\\. \\c[3]Flying type\\c[0] \\v[combat.name.hedgehog]s, that's so rad!",
       "transl": "Ach, blöde Frage, du hast doch gegen sie gekämpft!\\. \\c[3]Fliegende\\c[0] Igöll, der Wahnsinn!"
      }
     },
     {
      "message": {
       "orig": "And listen!\\. I did some legwork and was able to narrow down the location of their den.",
       "transl": "Hör zu!\\. Ich hab etwas Laufarbeit erledigt und konnte so den Ort ihres Verstecks eingrenzen."
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      }
     },
     {
      "message": {
       "orig": "They actually seem to live in \\v[area.autumn-fall.name] and only come to \\v[area.autumn-area.name] for apples.",
       "transl": "Sie scheinen tatsächlich in Autumn's Fall zu leben und kommen nur für Äpfel nach Autumn's Rise."
      }
     },
     {
      "message": {
       "orig": "Found some of their leavings and those suggested a distaste for the ripe apples of \\v[area.autumn-fall.name]!",
       "transl": "Hab ein paar ihrer Hinterlassenschaften gefunden, die auf eine Abneigung gegen die reifen Äpfel aus Autumn's Fall hindeuten!"
      }
     },
     {
      "message": {
       "orig": "...why?",
       "transl": "... Warum?"
      }
     },
     {
      "message": {
       "orig": "Well, it gets results!\\. I'm now 99 billion percent sure that they reside on the \\c[3]Secluded Path in \\v[area.autumn-fall.name]\\c[0].",
       "transl": "Tja, so kommt man auch an Ergebnisse!\\. Ich bin mir jetzt tausendprozentig sicher, dass sie sich auf dem \\c[3]Abgelegenen Pfad in Autumn's Fall\\c[0] befinden."
      }
     },
     {
      "message": {
       "orig": "Please hurry and take a look!",
       "transl": "Bitte beeil dich und sieh nach!"
      }
     },
     {
      "message": {
       "orig": "Bye...",
       "transl": "Bye..."
      }
     }
    ]
   }
