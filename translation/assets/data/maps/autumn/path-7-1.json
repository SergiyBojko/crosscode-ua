    "event": [
     null,
     {
      "thenStep": [
       {
        "message": {
         "orig": "Halfway through! I'll go to the end and wait for you.",
         "transl": "Auf halbem Weg! Ich gehe zum Ende und warte auf dich."
        }
       }
      ]
     }
