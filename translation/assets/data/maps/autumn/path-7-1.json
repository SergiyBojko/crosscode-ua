  null,
  {
   "settings": {
    "analyzable": {
     "text": {
      "orig": "Game Tester",
      "transl": "Spieletester"
     }
    },
    "npcStates": [
     {
      "event": {
       "quest": [
        null,
        null,
        {
         "message": {
          "orig": "Hey you!",
          "transl": "Hey du!"
         }
        },
        {
         "message": {
          "orig": "...Hi?",
          "transl": "... Hi?"
         }
        },
        {
         "message": {
          "orig": "I'm one of the testers for this game!",
          "transl": "Ich bin einer der Tester für dieses Spiel!"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         }
        },
        {
         "message": {
          "orig": "The devs asked me to test an almost finished new quest type: \\c[3]Parkour\\c[0]!",
          "transl": "Die Entwickler haben mich gefragt, einen fast fertigen neuen Quest-Typ zu testen: \\c[3]Parcours\\c[0]!"
         }
        },
        {
         "message": {
          "orig": "I'm kinda tired and you just came along. So\\..\\..\\.. Wanna try it out?",
          "transl": "Ich bin etwas müde und du kamst gerade vorbei. Also\\..\\..\\.. Willst du es probieren?"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         }
        },
        {
         "message": {
          "orig": "Nice! Good to see some enthusiasm! ",
          "transl": "Sehr schön! Den Enthusiasmus lob' ich mir!"
         }
        },
        {
         "message": {
          "orig": "Alright, get this. You will start right next to me.",
          "transl": "Also gut, nimm das. Du wirst direkt neben mir starten."
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "message": {
          "orig": "When you touch this checkpoint, another will pop up.",
          "transl": "Sobald du diesen Checkpoint berührst, wird der nächste auftauchen."
         }
        },
        {
         "message": {
          "orig": "Your goal is to walk through every marker until you hit the last one.",
          "transl": "Dein Ziel ist es, jeden Marker zu erreichen, bis du den letzten getroffen hast."
         }
        },
        {
         "message": {
          "orig": "Aaaaand the last one is over there.",
          "transl": "Uuuuund der Letzte, der ist da drüben!"
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "message": {
          "orig": "It will only appear after you hit the last normal marker.",
          "transl": "Er wird erst auftauchen, wenn du den letzten normalen Marker getroffen hast."
         }
        },
        null,
        {
         "message": {
          "orig": "...",
          "transl": "..."
         }
        },
        {
         "message": {
          "orig": "Yeah, I know. But it's more fun that way right?",
          "transl": "Ja, ich weiß, aber so macht es mehr Spaß, oder?"
         }
        },
        {
         "message": {
          "orig": "Well, at least if you like running.",
          "transl": "Na ja, zumindest, wenn du gerne rennst."
         }
        },
        {
         "message": {
          "orig": "Also, if you leave the map all your progress is lost!",
          "transl": "Ach so, falls du die Karte verlässt, geht auch dein Fortschritt verloren."
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         }
        },
        {
         "message": {
          "orig": "Another bummer, I know.",
          "transl": "Ja, ich weiß, das ist etwas blöd."
         }
        },
        {
         "message": {
          "orig": "Anyway!",
          "transl": "Wie dem auch sei!"
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "message": {
          "orig": "Ready to try?",
          "transl": "Bereit, es auszuprobieren?"
         }
        },
        {
         "accepted": [
          {
           "message": {
            "orig": "[nods]",
            "transl": "[nickt]"
           }
          },
          {
           "message": {
            "orig": "Awesome! As I said, just start by stepping on the first marker here!",
            "transl": "Großartig! Wie schon gesagt, fang einfach an, indem du auf den ersten Marker hier trittst."
           }
          }
         ],
         "declined": [
          null,
          {
           "message": {
            "orig": "[shakes head]",
            "transl": "[schüttelt Kopf]"
           }
          },
          {
           "message": {
            "orig": "Really? Oh man, I don't wanna do this all alone.",
            "transl": "Echt jetzt? Och, Mann. Ich will das nicht alles alleine machen. Wir brauchen eindeutig mehr QA Angestellte."
           }
          },
          {
           "message": {
            "orig": "That's like\\..\\..\\.. so much work.",
            "transl": "Es ist so\\..\\..\\.. so viel Arbeit."
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           }
          },
          {
           "message": {
            "orig": "If you ever change your mind...",
            "transl": "Wenn du dich mal umentscheiden solltest..."
           }
          },
          {
           "message": {
            "orig": "Come back, alright?\\.\\.\\. Please?",
            "transl": "Komm zurück, okay? \\.\\.\\. Bitte."
           }
          }
         ]
        }
       ]
      }
     },
