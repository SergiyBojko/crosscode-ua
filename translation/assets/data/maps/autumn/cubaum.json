        }
       },
       {
        "message": {
         "orig": "Yo, what's up?",
         "transl": "Yo, was geht?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "I see you got the \\c[3]\\v[item.230.name]\\c[0] with you! Nice, nice!",
           "transl": "Ich sehe, du hast die \\c[3]Rote Flammenform\\c[0] bei dir. Schick, schick!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "Well then, good luck on your journey!",
           "transl": "Na dann, viel Glück auf deiner Reise!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "If you want to pass this barrier you first have to collect the \\c[3]\\v[item.230.name]\\c[0].",
           "transl": "Wenn du die Barriere passieren willst, brauchst du die \\c[3]Rote Flammenform\\c[0]."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "You get it at the end of the \\c[3]Faj'ro Temple\\c[0], right after the boss battle.",
           "transl": "Du erhältst sie direkt nach dem Boss, am Ende des \\c[3]Faj'ro-Tempels\\c[0]."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "In case you already beat the boss, just go to the final room and fetch your reward. It should still be there!",
           "transl": "Falls du den Boss schon besiegt hast, geh nochmal in den Raum. Deine Belohnung sollte dort immer noch auf dich warten!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         }
        ]
       }
      ]
     }
    ]
