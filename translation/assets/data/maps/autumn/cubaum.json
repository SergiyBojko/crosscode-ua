    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Yo, what's up?",
         "transl": "Йо, як справи?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "I see you got the \\c[3]\\v[item.230.name]\\c[0] with you! Nice, nice!",
           "transl": "Бачу, в тебе є \\c[3]Шейд Червоного Вогню\\c[0]! Гарно, гарно!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "Well then, good luck on your journey!",
           "transl": "Ну що ж, вдалої мандрівки!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "If you want to pass this barrier you first have to collect the \\c[3]\\v[item.230.name]\\c[0].",
           "transl": "Якщо хочеш пройти крізь цей бар'єр, спершу мусиш отримати \\c[3]Шейд Червоного Вогню\\c[0]."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "You get it at the end of the \\c[3]Faj'ro Temple\\c[0], right after the boss battle.",
           "transl": "Його дають наприкінці \\c[3]Храму Фадж'ро\\c[0], одразу після бою з босом."
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "In case you already beat the boss, just go to the final room and fetch your reward. It should still be there!",
           "transl": "Якщо ти вже перемогла боса, просто зайди до останньої кімнати та забери нагороду. Вона досі має там бути!"
          },
          "person": {
           "person": "cross-worlds.triblader-male-black",
           "expression": "DEFAULT"
          }
         }
        ]
       }
      ]
     }
    ]
