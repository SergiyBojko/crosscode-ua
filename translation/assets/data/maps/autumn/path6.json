  {
   "settings": {
    "npcStates": [
     null,
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Ah, what's up?",
          "transl": "Ah, was gibt's?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "For me?",
          "transl": "Für mich?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "'kay.",
          "transl": "'kay."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Sorry I can't muster more feeling, but I get these things way too often.",
          "transl": "Sorry, dass ich nicht vor Begeisterung platze, aber ich bekomme diese Sachen viel zu oft."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I don't get it. How does a stranger know what I want?",
          "transl": "Ich versteh's nicht. Wie kann ein Fremder wissen, was ich will?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SAD"
         }
        },
        {
         "message": {
          "orig": "I don't know why you give me these but you gotta stop.",
          "transl": "Ich weiß nicht, warum du mir die gibst, aber du musst damit aufhören."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        }
       ]
      }
     }
    ]
   }
