    },
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "Tucos",
          "transl": "Tucos"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        },
        {
         "message": {
          "orig": "About time someone showed up.\\. And I hear you also helped us out with that lost data?",
          "transl": "Höchste Zeit, dass mal jemand auftaucht!\\. Ich hab gehört, du hast uns auch mit den verlorenen Daten geholfen?"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "You really saved my butt there.\\. I would've lost weeks of work if some critter had decided to eat it.",
          "transl": "Da hast du mir wirklich meinen Hintern gerettet.\\. Wenn irgendein Vieh das Teil einfach gefressen hätte, wäre meine wochenlange Arbeit für die Katz gewesen..."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "But we gotta make it count now.\\. I'm sure the group that jumped me had a special leader with them.",
          "transl": "Aber jetzt müssen wir die Daten auch nutzen.\\. Ich bin mir sicher, dass die Bande, die mich angegriffen hat, einen Anführer hatte."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Cut that one down and they might just become your usual pack of beasts again.",
          "transl": "Wenn wir ihn aus'm Verkehr ziehen, werden die anderen Viecher vielleicht wieder normal."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Right.\\. I've already spotted that sneaky rat again and tailed it to their hiding spot.",
          "transl": "Gut.\\. Ich hab die feige Ratte schon gesichtet und zu ihrem Versteck verfolgt."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "It's in a cave across the river northeast of here.\\. Follow me!",
          "transl": "Sie ist in der Höhle da hinten auf der anderen Seite des Flusses.\\. Folg mir!"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        }
       ]
      }
     },
     null,
     {
      "event": [
       {
        "name": {
         "orig": "Tucos",
         "transl": "Tucos"
        },
        "person": {
         "person": "rookie-harbor.faction-fd-male-tucos",
