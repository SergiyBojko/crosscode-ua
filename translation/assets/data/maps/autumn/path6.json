         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "You should go inside and see what you can find.\\. I'll guard the entrance.",
         "transl": "Du gehst rein und suchst ihn.\\. Ich pass' am Eingang auf."
        },
        "person": {
         "person": "rookie-harbor.faction-fd-male-tucos",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
