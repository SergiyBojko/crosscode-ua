    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "Tucos",
          "transl": "Тукос"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        },
        {
         "message": {
          "orig": "About time someone showed up.\\. And I hear you also helped us out with that lost data?",
          "transl": "Нарешті хтось з'явився.\\. І я чув, що ти ще й допомогла нам із тими загубленими даними?"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "You really saved my butt there.\\. I would've lost weeks of work if some critter had decided to eat it.",
          "transl": "Ти реально врятувала мій зад.\\. Я б втратив тижні роботи, якби якийсь звір вирішив їх зжерти."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "But we gotta make it count now.\\. I'm sure the group that jumped me had a special leader with them.",
          "transl": "А тепер нам варто цим скористатися.\\. Я впевнений, що група, яка напала на мене, мала особливого ватажка."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Cut that one down and they might just become your usual pack of beasts again.",
          "transl": "Якщо ми його приберемо, можливо, вони знову стануть звичайною зграєю звірів."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Right.\\. I've already spotted that sneaky rat again and tailed it to their hiding spot.",
          "transl": "Добре.\\. Я вже помітив того хитрого щура й простежив за ним до їхньої схованки."
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "It's in a cave across the river northeast of here.\\. Follow me!",
          "transl": "Вона в печері з іншого боку річки на північний схід звідси.\\. Йди за мною!"
         },
         "person": {
          "person": "rookie-harbor.faction-fd-male-tucos",
          "expression": "DEFAULT"
         }
        }
       ]
      }
     },
