   "settings": {
    "npcStates": [
     null,
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Ah, what's up?",
          "transl": "А, що таке?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "For me?",
          "transl": "Для мене?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "'kay.",
          "transl": "Ага."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Sorry I can't muster more feeling, but I get these things way too often.",
          "transl": "Вибач, я вже звик до цього, я їх занадто часто отримую."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I don't get it. How does a stranger know what I want?",
          "transl": "Не розумію. Як якийсь незнайомець може знати, чого я хочу?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SAD"
         }
        },
        {
         "message": {
          "orig": "I don't know why you give me these but you gotta stop.",
          "transl": "Не знаю, чому ти даєш мені їх, але тобі варто припинити."
         },
         "person": {
          "person": "cross-worlds.quadroguard-male-blond",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        }
       ]
      }
     }
    ]
   }
