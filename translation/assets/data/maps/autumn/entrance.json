   "settings": {
    "event": [
     null,
     {
      "title": {
       "orig": "Combat Rank",
       "transl": "Бойовий Ранг"
      },
      "content": {
       "orig": "How to increase \\c[3]Combat Rank\\c[0] to improve the drops of defeated enemies.",
       "transl": "Як підвищити \\c[3]Бойовий Ранг\\c[0], щоб покращити здобич із переможених ворогів."
      },
      "acceptStep": [
       null,
       null,
       null,
       null,
       null,
       {
        "text": {
         "orig": "Your \\c[3]combat rank\\c[0] is displayed in the upper right corner during combat.",
         "transl": "Ваш \\c[3]Бойовий Ранг\\c[0] відображається у правому верхньому куті під час бою."
        }
       },
       null,
       {
        "text": {
         "orig": "By \\c[3]defeating enemies\\c[0] your rank will increase.",
         "transl": "Ваш ранг зростатиме з кожним \\c[3]переможеним ворогом\\c[0]."
        }
       },
       null,
       null,
       null,
       null,
       null,
       {
        "text": {
         "orig": "With a higher combat rank, enemies will \\c[3]drop more items\\c[0], including \\c[3]special rare items\\c[0].",
         "transl": "Зі збільшенням бойового рангу, з ворогів \\c[3]випадатиме більше предметів\\c[0], включно з \\c[3]спеціальними рідкісними предметами\\c[0]."
        }
       },
       null,
       null,
       null,
       {
        "text": {
         "orig": "When you're out of combat you'll enter the \\c[3]cooldown phase\\c[3].",
         "transl": "Коли ви поза боєм, починається \\c[3]фаза перепочинку\\c[0]."
        }
       },
       null,
       {
        "text": {
         "orig": "When the blue line disappears, combat will end and you will  \\c[3]lose your rank\\c[0].",
         "transl": "Коли синя смужка зникне, бій завершиться, і ви \\c[3]втратите свій ранг\\c[0]."
        }
       },
       null,
       {
        "text": {
         "orig": "However, when you enter combat during cool down, you \\c[3]keep your combat rank\\c[3]!",
         "transl": "Проте, якщо ви вступите в бій під час перепочинку, \\c[3]бойовий ранг збережеться\\c[0]!"
        }
       },
       null,
       null,
