    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "Humble Helper",
          "transl": "Дбайливий Добродій"
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        },
        {
         "message": {
          "orig": "Hello, Ms. \\v[lore.title.seeker]!\\. So great to see you here on \\v[lore.title.planet].",
          "transl": "Вітаю, пані \\v[lore.title.seeker]ко!\\. Дуже радий бачити вас тут, на \\v[lore.title.planet]і."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "As a humble part of our endeavor here I am trying my best to aid Seekers.",
          "transl": "Я роблю все, що в моїх силах, щоб допомагати Шукачам у нашій спільній справі."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ASTONISHED"
         }
        },
        {
         "message": {
          "orig": "But, my skills are just not on the same level as yours are.",
          "transl": "Та мої навички все ж ніколи не зрівняються з вашими."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Might I ask you to help me out, dear \\v[lore.title.seeker]?",
          "transl": "Чи можу я попросити вашої допомоги, дорога \\v[lore.title.seeker]ко?"
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "ASTONISHED"
         }
        },
        {
         "accepted": [
          {
           "person": {
            "person": "main.lea",
            "expression": "PROUD"
           }
          },
          {
           "message": {
            "orig": "Superb!\\. Come back to me when you've defeated the \\v[combat.name.hedgehog]s.",
            "transl": "Чудово!\\. Повертайтеся, коли переможете \\v[combat.name.hedgehog]ів."
           },
           "person": {
            "person": "rookie-harbor.man-big-black",
            "expression": "DEFAULT"
           }
          }
         ],
         "declined": [
          {
           "person": {
            "person": "main.lea",
            "expression": "NERVOUS"
           }
          },
          {
           "message": {
            "orig": "Oh, okay!\\. No Problem Ms. \\v[lore.title.seeker].\\. Please come back if you changed your mind.",
            "transl": "Ем, ну добре!\\. Без Проблем, пані \\v[lore.title.seeker]ко.\\. Повертайтеся, якщо передумаєте."
           },
           "person": {
            "person": "rookie-harbor.man-big-black",
            "expression": "DEFAULT"
           }
          }
         ]
        }
       ]
      }
     },
