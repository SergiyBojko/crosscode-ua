     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "Humble Helper",
          "transl": "Bescheidener Betreuer"
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        },
        {
         "message": {
          "orig": "Hello, Ms. \\v[lore.title.seeker]!\\. So great to see you here on \\v[lore.title.planet].",
          "transl": "Ich grüße Sie, werte Seeker-Dame!\\. Schön, Sie hier auf Shadoon zu sehen."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "As a humble part of our endeavor here I am trying my best to aid Seekers.",
          "transl": "Als bescheidener Teil unser aller Bestreben hier versuche ich mein Bestes, den Seekern zu helfen."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ASTONISHED"
         }
        },
        {
         "message": {
          "orig": "But, my skills are just not on the same level as yours are.",
          "transl": "Leider sind meine Fähigkeiten noch nicht auf demselben Level wie Ihre."
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Might I ask you to help me out, dear \\v[lore.title.seeker]?",
          "transl": "Dürfte ich Sie höflich darum bitten, mir etwas auszuhelfen, verehrter Seeker?"
         },
         "person": {
          "person": "rookie-harbor.man-big-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "ASTONISHED"
         }
        },
        {
         "accepted": [
          {
           "person": {
            "person": "main.lea",
            "expression": "PROUD"
           }
          },
          {
           "message": {
            "orig": "Superb!\\. Come back to me when you've defeated the \\v[combat.name.hedgehog]s.",
            "transl": "Hervorragend! Kommen Sie nochmal wieder, wenn Sie die Igöll besiegt haben."
           },
           "person": {
            "person": "rookie-harbor.man-big-black",
            "expression": "DEFAULT"
           }
          }
         ],
         "declined": [
          {
           "person": {
            "person": "main.lea",
            "expression": "NERVOUS"
           }
          },
          {
           "message": {
            "orig": "Oh, okay!\\. No Problem Ms. \\v[lore.title.seeker].\\. Please come back if you changed your mind.",
            "transl": "Oh, na ja!\\. Kein Problem.\\. Besuchen Sie mich einfach wieder, wenn Sie es sich anders überlegt haben."
           },
           "person": {
            "person": "rookie-harbor.man-big-black",
            "expression": "DEFAULT"
           }
          }
         ]
        }
       ]
      }
