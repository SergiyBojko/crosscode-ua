     "text": {
      "orig": "Shady Shorsh",
      "transl": "Шорш Пройдисвіт"
     }
    },
    "npcStates": [
     null,
     {
      "event": {
       "quest": [
        null,
        null,
        null,
        null,
        null,
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "name": {
          "orig": "Shady Shorsh",
          "transl": "Шорш Пройдисвіт"
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "WHISTLING"
         }
        },
        {
         "message": {
          "orig": "I... I am so sorry.\\. For real this time.",
          "transl": "М... мені дуже шкода.\\. Цього разу по-справжньому."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "DETERMINED"
         }
        },
        {
         "message": {
          "orig": "I'm serious!\\. I'm out of smokebombs anyway, otherwise those damn \\v[combat.name.hedgehog]s never would've gotten me.",
          "transl": "Я серйозно!\\. У мене й димових бомб не лишилось, інакше ті кляті \\v[combat.name.hedgehog]и нізащо б мене не піймали."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "But maybe they've been sent by the Track to show me the error of my ways.",
          "transl": "А може, це сам Шлях послав їх, аби показати мені, що я зійшов на криву стежку."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "This time I will turn myself in and atone for my crimes. Truly.",
          "transl": "Цього разу я сам здамся й спокутую свої злочини. Чесно."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "DETERMINED"
         }
        },
        {
         "message": {
          "orig": "So... if you will excuse me.",
          "transl": "Тож... якщо дозволиш..."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "name": {
          "orig": "Shady Shorsh",
          "transl": "Шорш Пройдисвіт"
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "name": {
          "orig": "Guard Kima",
          "transl": "Вартова Кіма"
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-female-black",
          "expression": "DEFAULT"
         }
        },
        null,
        {
         "message": {
          "orig": "You're coming with me.",
          "transl": "Ти йдеш зі мною."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "B... but I was going to come to you anyway.\\. Don't you trust me?",
          "transl": "А... але я й так збирався до вас піти!\\. Хіба ви мені не довіряєте?"
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Sorry, pal.\\. Trust is nice and all but I won't take any more risks with you.",
          "transl": "Вибач, друже.\\. Довіра - це добре, а контроль - ще краще. Більше ніяких вибриків."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Alright, alright.\\. Jeez.",
          "transl": "Добре, добре.\\. Ех..."
         },
         "person": {
          "person": "rookie-harbor.thief-man-small-brown",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        null,
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "In any case, thanks, girl.\\. You did great work here.\\. Report back to the chief to get your reward.",
          "transl": "У будь-якому разі, дякую, дівчино.\\. Гарно впоралася.\\. Повертайся до шефа, щоб отримати свою винагороду."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        null,
        {
         "message": {
          "orig": "Alright, off we go.",
          "transl": "Гаразд, рушаймо."
         },
         "person": {
          "person": "rookie-harbor.faction-rhg-female-black",
          "expression": "DEFAULT"
         }
        }
       ]
      }
     }
    ]
   }
