     {
      "event": {
       "quest": [
        null,
        {
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Oh! W-Why hello S-S-Seeker!",
          "transl": "Oh! H-Hallo, Seeker!"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "How very f-f-fortunate, I just finished my preparations.",
          "transl": "Was für ein Zu-Zu-Zufall, ich habe meine Vorbereitungen g-g-gerade abgeschlossen."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "And even exactly the kind of s-seeker I was looking for.",
          "transl": "Oh, und sogar genau d-d-die Art von Seeker, die ich ge-ge-gesucht habe."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Good S-Seeker, I'm in desperate n-need of help.",
          "transl": "Lieber Seeker, ich b-b-brauche dringend Hilfe."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...?",
          "transl": "...?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "Y-Yes\\..\\..\\.. Yes\\..\\..\\..",
          "transl": "Ja\\..\\..\\.. Ja\\..\\..\\.. "
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "W-W-W-Wait, you're still h-here?",
          "transl": "W-W-Warte. du b-bist immer noch da?"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_AWAY"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "T-That is most unexpected I must s-s-say.",
          "transl": "D-D-Das war unerwartet, mu-mu-muss ich sagen."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "P-people often rather choose to ignore m-m-me.",
          "transl": "D-D-Die Leute ignorieren m-m-mich meistens."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I d-d-don't suppose y-you would like to h-h-h-help me?",
          "transl": "Ich nehme mal nicht an, d-d-dass du m-m-mir helfen willst, oder?"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "0": [
          {
           "message": {
            "orig": "[nods]",
            "transl": "[киває]"
           },
           "person": {
            "person": "main.lea",
            "expression": "NOD"
           }
          },
          null,
          {
           "message": {
            "orig": "R-R-R-Really?!?",
            "transl": "W-W-Wirklich?!?"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "S-Splendid!",
            "transl": "A-A-Ausgezeichnet!"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "O-Okay, l-l-let me introduce myself first.",
            "transl": "G-G-Gut, ich stelle m-m-mich kurz vor."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "name": {
            "orig": "Henry",
            "transl": "Henry"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I'm H-Henry! Henry the Researcher.",
            "transl": "H-Henry mein Name. Henry der Fo-Fo-Forscher."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I study this fine moon's F-Flora and F-F-Fauna.",
            "transl": "Ich stu-du-diere die tolle Flora und F-F-Fauna dieses Mo-Mo-Mondes."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "W-What is your name?",
            "transl": "W-Wie ist dein N-Name?"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Lea!",
            "transl": "Лія!"
           },
           "person": {
            "person": "main.lea",
            "expression": "EXCITED"
           }
          },
          {
           "message": {
            "orig": "A f-fine name, a f-f-fine name indeed.",
            "transl": "Ei-Ei-Ein schöner N-Name, wi-wi-wirklich."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I will r-remember it.",
            "transl": "Ich werde ihn mir m-m-merken."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           },
           "person": {
            "person": "main.lea",
            "expression": "CHARMED"
           }
          },
          {
           "message": {
            "orig": "You see, I-I want to gather some d-data for \\c[3]Autumn's Rise\\c[0].",
            "transl": "Du mu-mu-musst wissen, ich sa-sa-sammle Daten ü-ü-über \\c[3]Autumn's Rise\\c[0]."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "B-But it seems that I alone can't gather everything I w-w-want. ",
            "transl": "L-L-Leider schaffe ich es nicht, alle D-D-Daten alleine zu sammeln, d-d-die ich b-b-brauche."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "The \\c[3]T-Track of the Ancients\\c[0] only allows \\c[3]Seekers\\c[0] to find c-certain things.",
            "transl": "Der \\c[3]Pf-Pf-Pfad der Ahnen\\c[0] erlaubt es nur \\c[3]Seekern\\c[0], b-b-bestimmte Dinge zu finden."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           },
           "person": {
            "person": "main.lea",
            "expression": "SURPRISED_TOWARD"
           }
          },
          {
           "message": {
            "orig": "I c-c-compiled a list of things I need.",
            "transl": "Ich habe eine Li-Li-Liste zusammengestellt, mit Sachen, d-d-die ich brauche."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
