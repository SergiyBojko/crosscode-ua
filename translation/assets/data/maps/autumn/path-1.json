  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        null,
        {
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Oh! W-Why hello S-S-Seeker!",
          "transl": "О! М-Мої вітання, Ш-Ш-Шукачко!"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "How very f-f-fortunate, I just finished my preparations.",
          "transl": "Як же в-в-вчасно, я щойно завершив п-приготування."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "And even exactly the kind of s-seeker I was looking for.",
          "transl": "І саме такого ш-ш-шукача я й ш-шукав."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Good S-Seeker, I'm in desperate n-need of help.",
          "transl": "Дорога ш-шукачко, мені конче п-потрібна допомога."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...?",
          "transl": "...?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "Y-Yes\\..\\..\\.. Yes\\..\\..\\..",
          "transl": "Т-так\\..\\..\\.. Так\\..\\..\\.."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "W-W-W-Wait, you're still h-here?",
          "transl": "З-З-Зачекай, ти все ще т-тут?"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_AWAY"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "T-That is most unexpected I must s-s-say.",
          "transl": "Ц-це н-несподівано, мушу с-с-сказати."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "P-people often rather choose to ignore m-m-me.",
          "transl": "Л-Люди зазвичай вважають за краще м-м-мене ігнорувати."
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I d-d-don't suppose y-you would like to h-h-h-help me?",
          "transl": "Ти ж н-н-не хотіла б м-м-мені д-допомогти?"
         },
         "person": {
          "person": "misc.henry-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "0": [
          {
           "message": {
            "orig": "[nods]",
            "transl": "[киває]"
           },
           "person": {
            "person": "main.lea",
            "expression": "NOD"
           }
          },
          null,
          {
           "message": {
            "orig": "R-R-R-Really?!?",
            "transl": "С-С-С-Справді?!?"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "S-Splendid!",
            "transl": "П-Пречудово!"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "O-Okay, l-l-let me introduce myself first.",
            "transl": "Г-Гаразд, д-д-дозволь спершу п-представитись."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "name": {
            "orig": "Henry",
            "transl": "Генрі"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I'm H-Henry! Henry the Researcher.",
            "transl": "Я - Г-Генрі! Дослідник Генрі."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I study this fine moon's F-Flora and F-F-Fauna.",
            "transl": "Я вивчаю Ф-Флору та Ф-Ф-Фауну цього чудового м-місяця."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "W-What is your name?",
            "transl": "А я-я-яке твоє ім'я?"
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Lea!",
            "transl": "Лія!"
           },
           "person": {
            "person": "main.lea",
            "expression": "EXCITED"
           }
          },
          {
           "message": {
            "orig": "A f-fine name, a f-f-fine name indeed.",
            "transl": "Г-Г-Гарне ім'я, д-д-дуже гарне."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "I will r-remember it.",
            "transl": "Я його з-запам'ятаю."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           },
           "person": {
            "person": "main.lea",
            "expression": "CHARMED"
           }
          },
          {
           "message": {
            "orig": "You see, I-I want to gather some d-data for \\c[3]Autumn's Rise\\c[0].",
            "transl": "Розумієш, я х-хочу зібрати деякі д-д-дані про \\c[3]Підйом Осені\\c[0]."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "B-But it seems that I alone can't gather everything I w-w-want. ",
            "transl": "Але с-с-сам я не можу зібрати всього, що мені н-н-необхідно."
           },
           "person": {
            "person": "misc.henry-researcher",
            "expression": "DEFAULT"
           }
          },
          {
