      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Well, you know how it is.\\. No shiny effects from me.\\. Just the upgrade.",
       "transl": "Ну, ти знаєш як воно.\\. У мене без крутих ефектів.\\. Тільки покращення."
      },
      "person": {
       "person": "main.sergey",
       "expression": "JOKING"
      }
     },
     {
      "message": {
       "orig": "Here goes!",
       "transl": "Ну, вперед!"
