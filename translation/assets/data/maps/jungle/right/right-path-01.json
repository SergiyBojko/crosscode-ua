   "settings": {
    "event": [
     {
      "message": {
       "orig": "Lots of dead trees here. Woodcutters at work?",
       "transl": "Lauter tote Bäume hier. Holzfäller bei der Arbeit?"
      }
     },
     {
      "message": {
       "orig": "I believe those trees merely died of old age.",
       "transl": "Ich glaube, die hier starben auf Grund ihres Alters."
      }
     },
     {
      "message": {
       "orig": "Humankind quickly learned that lumbering this forest will lead to fierce counter reactions of the Track.",
       "transl": "Die Menschheit hat schnell gelernt, dass das Abholzen dieses Waldes zu heftigen Abwehrreaktionen des Pfades führen kann."
      }
     },
     {
      "message": {
       "orig": "Scary.",
       "transl": "Erschreckend."
      }
     }
    ]
