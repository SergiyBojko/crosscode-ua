    "npcStates": [
     {
      "event": [
       {
        "name": {
         "orig": "Talatu Lips",
         "transl": "Талату Ліпс"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hey there, sweetheart!",
         "transl": "Гей, серденько!"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "This here jungle has a startlin' variety of flora. ",
         "transl": "Оці джунглі мають дивовижне різнобарв'я флори."
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Jes' look at this'un here. Weren't too far away Ah found the same plant, but open. ",
         "transl": "Тільки глянь на оцю. Недалечко я знайшла таку ж саму, але розкриту."
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "An' Ah found a fish inside!",
         "transl": "А всередині неї - риба!"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "!",
         "transl": "!"
        },
        "person": {
         "person": "main.lea",
         "expression": "ASTONISHED"
        }
       },
       {
        "message": {
         "orig": "Well, how's the explorin' comin' along? Y'all must be close ta done soon, Ah'd reckon.",
         "transl": "Ну, а як там твої мандри? Гадаю, ти вже близька до завершення."
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Good ta hear!",
         "transl": "Файно чути!"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       }
