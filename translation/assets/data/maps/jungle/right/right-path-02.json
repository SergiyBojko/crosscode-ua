  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Oh no, it's raining again.",
       "transl": "Och nö, es regnet schon wieder."
      }
     },
     {
      "message": {
       "orig": "Yes, rain is all too common for this climate.",
       "transl": "Ja, Regen ist für dieses Klima leider nur allzu typisch."
      }
     },
     {
      "message": {
       "orig": "...\\.Too bad I'm losing a friend...",
       "transl": "...\\. Schade nur, dass ich einen Freund verliere..."
      }
     },
     {
      "message": {
       "orig": "What?",
       "transl": "Was?"
      }
     },
     {
      "message": {
       "orig": "Nevermind.",
       "transl": "Schon gut."
      }
     },
     {
      "message": {
       "orig": "...?",
       "transl": "...?"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Sonya Bolt",
       "transl": "Sonya Bolt"
      }
     },
     null,
     {
      "message": {
       "orig": "\\v[lore.title.seeker], are you alright?\\. Can you hear me?",
       "transl": "Seeker, alles in Ordnung?\\. Hörst du mich?"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Good.\\. Did you see the results of uncontrolled human ambition and meddling with the Track?",
       "transl": "Gut.\\. Hast du die Früchte des unkontrollierten Herumdokterns am Pfad gesehen?"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Creatures of the Track, equipped with metal, geared for destruction.\\. And now on the loose.",
       "transl": "Geschöpfe des Pfades, mit Metall gepanzert, auf Zerstörung ausgerichtet.\\. Und nun frei herumlaufen."
      }
     },
     {
      "message": {
       "orig": "...how?",
       "transl": "... Wie?"
      }
     },
     {
      "message": {
       "orig": "Experiments, \\v[lore.title.seeker].\\. The work of humans trying to subjugate the Track's might and use it for their end.",
       "transl": "Durch Experimente, Seeker.\\. Durchgeführt von Menschen, die versucht haben, die Macht des Pfades für sich selbst zu nutzen."
      }
     },
     {
      "message": {
       "orig": "But there is more to see.\\. This was just the beginning.",
       "transl": "Es gibt noch mehr.\\. Das war erst der Anfang."
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "message": {
       "orig": "Move to \\c[3]V'rda Vil North\\c[0] and take a look.\\. It is very close to your current position.",
       "transl": "Geh nach \\c[3]V'rda Vil / Nord\\c[0] und sieh dich dort um.\\. Es ist gleich um die Ecke."
      }
     },
     {
      "message": {
       "orig": "Bye.",
       "transl": "Bye."
      }
     }
    ]
   }
  }
