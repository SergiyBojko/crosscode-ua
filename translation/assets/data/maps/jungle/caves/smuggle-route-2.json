         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Good, ready when you are.",
          "transl": "Gut, bereit, wenn du es bis'."
         },
         "person": {
          "person": "basin.don-mick",
          "expression": "DEFAULT"
         }
        }
       ]
      }
