        {
         "message": {
          "orig": "Alright, here we go.",
          "transl": "Gut, dann ma' los."
         },
         "person": {
          "person": "basin.don-mick",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "This is the part of the cavern that got breached by those darn guards.",
          "transl": "Das is' der Teil der Höhle, der von diesen dämlichen Wachen entdeckt wurde."
         },
         "person": {
          "person": "basin.don-mick",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        null,
