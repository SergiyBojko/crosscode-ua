        "person": {
         "person": "main.lea",
         "expression": "SHAKE"
        }
       },
       {
        "message": {
         "orig": "You... what? Come on... at least have some mercy, will ya?",
         "transl": "Du... was? Ach, komm schon... zeig ma' 'n bisschen Gnade, ja?"
        },
        "person": {
         "person": "basin.don-mick",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
