      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Mh... Oh, it's you. Did ya find a way?",
       "transl": "Mh... Ah, du bist's. 'nen Weg gefunden?<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "Finally! Only took ya \\v[map.retiresNeeded] tries.",
         "transl": "Endlich! Hat dich ja bloß \\v[map.retiresNeeded] Versuche gekostet."
        },
        "person": {
         "person": "basin.don-mick",
         "expression": "DEFAULT"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "Finally! And it only took you one try. I'm actually impressed.",
         "transl": "Endlich! Und gleich beim ersten Versuch. Bin beeindruckt."
        },
        "person": {
         "person": "basin.don-mick",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     {
      "message": {
       "orig": "Give me a minute, I'll use the same way using the tracker chip I gave you.",
       "transl": "Moment, werd' denselben Weg gehen wie du, indem ich den Sender benutze."
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Damn, woman, was this really the only way?",
       "transl": "Boah, Mädel, ey, gab's keinen anderen Weg?<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "So much walking... \\.\\.\\. Thankfully, I don't have to carry the goods. That would be just awful.",
       "transl": "Da muss ich ja voll weit laufen... \\.\\.\\. Zum Glück muss ich die Ware nicht tragen. Das wär' noch die Krönung.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "Don't give me that look, will ya?",
       "transl": "Sieh mich gefälligst nich' so an, ja?"
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ya can go back to my dad with the tracker chip and get your reward.",
       "transl": "Du kannst jetzt mit dem Sender zu meinem Vater zurück und deine Belohnung holen."
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Ya can keep the \\v[item.343.name] and explore this cavern if ya want.",
       "transl": "Du kannst die Rauchbombe behalten und die Höhle weiter erkunden, wenn'u wills'."
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Also, be a good girl and make sure to tell him I helped a lot, gotcha?",
       "transl": "Und sei ein gutes Mädchen und sag ihm, dass ich viel geholfen hab', kapische?"
      },
      "person": {
       "person": "basin.don-mick",
       "expression": "DEFAULT"
      }
     },
     {
      "0": [
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "I *knew* I could count on ya. Now off you go, the rest is just a long small tunnel anyway.",
         "transl": "Ich *wusste*, dass ich auf dich zählen kann! Dann verdufte, der Rest ist eh nur noch ein schmaler Tunnel."
        },
        "person": {
         "person": "basin.don-mick",
         "expression": "DEFAULT"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "[shakes head]",
         "transl": "[хитає головою]"
