  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Did human really bring \\c[3]black monster\\c[0] into village?",
       "transl": "Haben Mensch wirklich \\c[3]schwarze Monster\\c[0] gebracht in Dorf?"
      }
     },
     {
      "text": {
       "orig": "Didn't you hear about \\c[3]source\\c[0] of black monster? It very shiny and metal!",
       "transl": "Du nicht gehört von \\c[3]Quelle\\c[0] von schwarze Monster? Sein aus Metall und glänzen sehr!"
      }
     },
     {
      "text": {
       "orig": "Must be work of human!",
       "transl": "Muss sein Werk von Mensch!"
      }
     },
     {
      "text": {
       "orig": "But we never saw human bring monsters or source into village!",
       "transl": "Aber wir nie gesehen wie Mensch bringen Monster oder Quelle in Dorf!"
      }
     },
     {
      "text": {
       "orig": "That true, but who else could done it?",
       "transl": "Das sein wahr, aber wer sonst hat getan?"
      }
     }
    ]
   }
