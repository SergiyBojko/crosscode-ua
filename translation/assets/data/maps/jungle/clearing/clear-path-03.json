  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Humans really that bad?",
       "transl": "Mensch sein wirklich so schlimm?"
      }
     },
     {
      "text": {
       "orig": "Yes! Probably infested jungle on purpose.",
       "transl": "Ja! Vermutlich Dschungel vergiften mit Absicht."
      }
     },
     {
      "text": {
       "orig": "They want to take our land!",
       "transl": "Sie wollen haben unser Land!"
      }
     },
     {
      "text": {
       "orig": "Not sure if true...",
       "transl": "Ob das wahr sein..."
      }
     }
    ]
   }
