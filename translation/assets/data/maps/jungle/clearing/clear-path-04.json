        },
        null,
        {
         "message": {
          "orig": "You really did it?!",
          "transl": "Wirklich?!"
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Where did you find it? What was it?",
