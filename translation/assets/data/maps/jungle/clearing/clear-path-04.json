    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "K'tara",
          "transl": "K'tara"
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "We're finally here.",
          "transl": "Hier ist es."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Let's act quickly. If I remember correctly, the spot was somewhere around here.",
          "transl": "Beeilen wir uns. Wenn ich mich recht erinnere, war die Stelle irgendwo hier..."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
         "name": {
          "orig": "K'tara",
          "transl": "K'tara"
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED"
         }
        },
        {
         "message": {
          "orig": "Eeek! I forgot how suddenly it comes up...",
          "transl": "Huuch! Ganz vergessen, wie schnell der aus dem Boden schießt..."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        {
         "name": {
          "orig": "K'tara",
          "transl": "K'tara"
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        null,
        {
         "message": {
          "orig": "Back when I was young, me and the other younglings played here and found this.",
          "transl": "Als ich noch klein war, habe ich mit den anderen Kindern hier gespielt und dabei das hier entdeckt."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I believe it was an old escape route built by the founders of our village.",
          "transl": "Ich glaube, das war einmal ein alter Fluchtweg, den die Dorfbegründer angelegt hatten."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "The important part: We can now get to the Chief's Den.",
          "transl": "Jedenfalls kommen wir damit zur Häuptlingshütte hinüber."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Up ahead are a lot of Wiccats. And also something which I believe must be their source.",
          "transl": "Weiter oben sind eine Menge Schnurrken. Und ich glaube auch etwas, das ihre Quelle sein muss."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "I don't know exactly where the source is, but my bet is in one of the houses.",
          "transl": "Wo die Quelle sich genau befindet, weiß ich nicht, aber ich vermute mal in einem der Häuser."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "The others told me it should be very hard to miss as it looks pretty out of place.",
          "transl": "Die anderen sagten mir, dass sie kaum zu übersehen sei, weil sie so fremdartig aussieht.<<A<<[CHANGED 2021/05/22]"
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Some kind of \\c[3]glowing pole\\c[0]... They believe it's an extension from that cursed powerplant.",
          "transl": "Eine Art \\c[3]glühender Stab\\c[0]... Sie glauben, dass es ein Ausläufer von diesem verfluchten Kraftwerk ist."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "My hope is that by getting rid of the source, we can put an end to this infestation.",
          "transl": "Meine Hoffnung ist, dass die Schnurrken verschwinden, wenn wir die Quelle zerstören."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_AWAY"
         }
        },
        {
         "message": {
          "orig": "Seeker, you must go in and find this source.",
          "transl": "Seeker, ihr müsst hinüber und diese Quelle finden."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I'm sure that by doing so, we can calm the Shad and bring an end to the tension.",
          "transl": "Wenn wir das schaffen, werden sich die Shad und damit die Situation sicher wieder beruhigen."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[nickt]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DETERMINED"
         }
        },
        {
         "message": {
          "orig": "I'll wait here. Come back to me once you're done.",
          "transl": "Ich werde hier auf euch warten."
         },
         "person": {
          "person": "jungle.female-albino",
          "expression": "DEFAULT"
         }
        },
        null,
        null,
        null,
        {
         "message": {
          "orig": "Do we have to fight the kittens again...?",
          "transl": "Müssen wir wieder die Kätzchen bekämpfen...?"
         },
         "person": {
          "person": "antagonists.sidekick",
          "expression": "AWWW"
         }
        },
        {
         "message": {
          "orig": "It should suffice to get rid of the \\c[3]source\\c[0]! But we may not be able to avoid fighting some of the Wiccats this time!",
          "transl": "Es sollte genügen, die \\c[3]Quelle\\c[0] zu zerstören! Doch dieses Mal werden wir wohl um ein paar Kämpfe nicht drum herum kommen!"
         },
         "person": {
          "person": "antagonists.fancyguy",
          "expression": "LECTURING"
         }
        },
        {
         "message": {
          "orig": "This game is cruel...!",
          "transl": "Dieses Spiel ist grausam...!"
         },
         "person": {
          "person": "antagonists.sidekick",
          "expression": "ANGRY"
         }
        }
       ]
