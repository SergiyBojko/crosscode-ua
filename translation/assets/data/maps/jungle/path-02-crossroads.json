  {
   "settings": {
    "event": [
     null,
     null,
     {
      "name": {
       "orig": "Baxton",
       "transl": "Baxton"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Lady Lea!",
       "transl": "Fräulein Lea!"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi...!",
       "transl": "Привіт...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "EXCITED"
      }
     },
     {
      "message": {
       "orig": "It seems we meet yet again. It must be fate.",
       "transl": "Da treffen wir uns schon wieder. Das muss Schicksal sein."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Reports in this area have been made by dutiful players that a strange player was seen here.",
       "transl": "Es gab Berichte von Spielern, die in dieser Gegend einen seltsamen Spieler gesehen haben."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "One that appears as a humble NPC seeking help from other players.",
       "transl": "Jemand, der wie ein einfacher NPC wirkt und andere Spieler um Hilfe bittet."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Let me ask quite bluntly here, Lady Lea...",
       "transl": "Lassen Sie mich Ihnen eine direkte Frage stellen, Fräulein Lea...<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Did you accept a quest from an NPC by the name of... let me see here... \\.\\.\\. \\c[3]Henry\\c[0]?",
       "transl": "Haben Sie eine Quest von einem Spieler namens... lassen Sie mich nachsehen...\\.\\.\\. \\c[3]Henry\\c[0] angenommen?"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Well, this is quite unsettling. You are the third person to report so. ",
       "transl": "Das wird langsam doch etwas besorgniserregend. Sie sind schon die dritte Person, die das bestätigt.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I fear we have a person with malicious intent here.",
       "transl": "Ich fürchte, wir haben hier eine Person mit bösartigen Absichten."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "NERVOUS"
      }
     },
     {
      "message": {
       "orig": "Ah, fear not, Lady Lea. I do not believe you are involved in such shady business.",
       "transl": "Ach, Fräulein Lea, ich weiß doch, dass Sie nicht absichtlich darin verwickelt sind.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I must, however, follow procedure and file a report against this player.",
       "transl": "Dennoch muss ich leider die Vorschriften befolgen und den Spieler melden.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Even if it is highly probable that \\c[3]Henry\\c[0] is just a cover name.",
       "transl": "Auch wenn es sehr wahrscheinlich ist, dass \\c[3]Henry\\c[0] nur ein Deckname ist."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "For now, I will manually complete the quest that has been given to you. ",
       "transl": "Die Quest, die Ihnen gegeben wurde, werde ich bis auf weiteres als abgeschlossen markieren."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I am following a lead that will take me all the way to \\c[3]\\v[area.forest.name]\\c[0]. ",
       "transl": "Ich folge gerade einem Hinweis, der vom \\c[3]Saphirgrat\\c[0] kam."
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "May we meet again under more pleasant circumstances next time, Lady Lea. Goodbye! ",
       "transl": "Mögen wir uns unter glücklicheren Umständen wiedertreffen, Fräulein Lea. Auf Wiedersehen!"
      },
      "person": {
       "person": "misc.advisor-researcher",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Bye...",
       "transl": "Бувай..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     }
    ]
   }
  },
  null,
