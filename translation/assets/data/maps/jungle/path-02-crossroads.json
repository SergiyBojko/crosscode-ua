        }
       }
      ]
     }
    ]
   }
  },
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I wonder if she'll turn up again...",
       "transl": "Ich frag mich, ob sie wohl wieder auftaucht..."
      },
      "event": [
       null,
       {
        "name": {
         "orig": "Henry",
         "transl": "Henry"
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "I-I-It's you!",
         "transl": "D-D-Du bist es!"
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "At t-this point, someone might t-think you're stalking me.",
         "transl": "So la-la-langsam könnte m-m-man meinen, du verfo-fo-folgst mich."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "SMILE"
        }
       },
       {
        "message": {
         "orig": "It has been a while! And a-a-as usual you came at the right moment.",
         "transl": "Ist e-e-eine Weile her! U-U-Und wie immer im richtigen Mo-Mo-Moment."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Another player has just p-placed a probe somewhere in t-t-t-this jungle.",
         "transl": "Ein anderer Spi-pi-pieler hat vo-vorhin eine Sonde i-i-irgendwo im Dschungel platziert."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Even though I had some problems earlier.",
         "transl": "Obwohl es vorher ein paar K-K-Komplikationen gab."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "NERVOUS"
        }
       },
       {
        "message": {
         "orig": "D-D-Don't worry about it... It was just a misunderstanding.",
         "transl": "K-K-Keine Sorge... E-Es war nu-nu-nur ein Missverstä-tä-tändnis."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "It j-j-just means I don't have much t-t-time left.",
         "transl": "Das b-b-bedeutet nur, d-d-dass mir nur noch w-w-wenig Zeit bleibt."
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "S-So would you be willing to help me survey this area too?",
         "transl": "Wärst du nochmal g-g-gewillt, mir auch bei der Untersuchung dieser Ge-Ge-Gegend zu h-helfen?"
        },
        "person": {
         "person": "misc.henry-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "accepted": [
         {
          "message": {
           "orig": "T-Thank you! T-this will be the last time, I p-p-promise.",
           "transl": "D-Danke dir! D-Das wird das le-le-letzte Mal sein, v-v-versprochen."
          },
          "person": {
           "person": "misc.henry-researcher",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "[nods]",
           "transl": "[киває]"
          },
          "person": {
           "person": "main.lea",
           "expression": "NOD"
          }
         },
         {
          "message": {
           "orig": "I d-d-don't have any probes left, but I g-g-guess you know what they look like by now.",
           "transl": "Ich ha-ha-habe gerade k-keine Sonde hier, aber d-d-du weißt ja, wie sie aussehen."
          },
          "person": {
           "person": "misc.henry-researcher",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "[nods]",
           "transl": "[киває]"
          },
          "person": {
           "person": "main.lea",
           "expression": "NOD"
          }
         }
        ],
        "declined": [
         {
          "message": {
           "orig": "O-Oh... You are not interested...",
           "transl": "O-Oh... D-D-Du hast kein Interesse..."
          },
          "person": {
           "person": "misc.henry-researcher",
           "expression": "DEFAULT"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  },
