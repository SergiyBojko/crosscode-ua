          },
          {
           "message": {
            "orig": "Oh, \\v[lore.title.seeker], please.\\. Make hurry and let me go back to home and work!",
            "transl": "Oh, bitte Seeker.\\. Bitte beeilen, damit ich zurück können nach Hause und arbeiten!"
           }
          }
