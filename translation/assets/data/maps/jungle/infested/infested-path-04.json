           "message": {
            "orig": "Happy catching, \\v[lore.title.seeker].\\. I will wait here till one is inside cage.",
            "transl": "Fröhlich Fangen, Seeker.\\. Ich warten hier bis eine in Käfig sein."
           }
          },
          null,
