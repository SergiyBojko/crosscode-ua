     },
     {
      "message": {
       "orig": "Two more adorable furry powersources, amaze! \\v[lore.title.seeker], great job!",
       "transl": "Noch zwei liebenswert Fellstromquellen, wie toll! Großartig Arbeit, Seeker!"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      }
     },
     {
      "message": {
       "orig": "This enough generators to power important parts of village!",
       "transl": "Nun genug Generator haben, um wichtig Teile von Stadt versorgen mit Strom."
      }
     },
     {
      "message": {
       "orig": "They be teleporting back to workshop like others.\\. And me follow, finally!",
       "transl": "Teleportieren sich auch nach Hause, wie vorher.\\. Und ich dürfen jetzt auch, endlich!"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "message": {
       "orig": "Oh, and you visit me there, too, yes?\\. Need to do important speaking over use of new power!",
       "transl": "Oh, du mich zu Hause besuchen, ja?\\. Muss halten wichtig Rede über Nutzen von neue Strom!"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Good.\\. We see each other at place!",
       "transl": "Gut.\\. Wir uns dort sehen!"
      }
     },
     {
      "message": {
       "orig": "Bye!",
       "transl": "Bye!"
      }
     }
    ]
   }
