      "thenStep": [
       null,
       {
        "message": {
         "orig": "\\v[lore.title.seeker] got one, much neat!\\. But also killed other cats without capturing enough.",
         "transl": "Seeker gefangen eine Katze, ist Anfang!\\. Aber leider getötet alle andere Katzen statt fangen!"
        }
       },
       {
        "message": {
         "orig": "More have to be lured now.\\. Please try to capture at least one more before all killed!",
         "transl": "Müssen nun mehr locken.\\. Bitte versuchen fangen wenigstens eine, bevor alle tot!"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "\\v[lore.title.seeker] killed all cats without capturing enough.\\. Such reckless!",
         "transl": "Seeker getötet alle Katzen statt fangen genug.\\. Wie rücksichtslos!"
        }
       },
       {
        "message": {
         "orig": "More have to be lured now.\\. Please try to capture at enough to fill cages before all killed!",
         "transl": "Müssen nun mehr locken.\\. Bitte versuchen fangen genug, bevor alle tot!"
        }
       }
      ]
     }
    ]
   }
