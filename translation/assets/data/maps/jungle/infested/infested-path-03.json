  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Hm...\\. getting kinda hungry for mushrooms.",
       "transl": "Hm...\\. Ich bekomme Hunger auf Pilze."
      }
     },
     {
      "message": {
       "orig": "Really? Those huge blue and purple mushrooms make you hungry?",
       "transl": "Echt? Diese großen blauen und lila Pilze machen dich hungrig?"
      }
     },
     {
      "message": {
       "orig": "Why not?\\. Don't you folks eat cheese with blue mold and stuff like that?",
       "transl": "Warum nicht?\\. Ihr esst doch Käse mit blauem Schimmel und so Zeug?"
      }
     },
     {
      "message": {
       "orig": "Whoa, hold up!\\. Let's not fall back to stereotypes here!",
       "transl": "Whoa, mach mal halblang!\\. Komm mir nicht mit Stereotypen!"
      }
     },
     {
      "message": {
       "orig": "But oui...\\. Roquefort is pretty neat sometimes.",
       "transl": "Aber oui...\\. Roquefort ist manchmal super lecker."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "So many giant mushrooms in this area.\\. Do you think those are edible?",
       "transl": "So viele große Pilze in dieser Gegend.\\. Glaubt ihr, die sind essbar?"
      }
     },
     {
      "message": {
       "orig": "It's safer to assume they're not!",
       "transl": "Es wäre sicherer, anzunehmen, dass sie es nicht sind!"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     }
    ]
   }
