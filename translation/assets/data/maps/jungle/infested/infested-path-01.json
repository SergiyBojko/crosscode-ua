        },
        {
         "message": {
          "orig": "Ho, \\v[lore.title.seeker] finally there.\\. This dangerous place, not fun to wait around at.",
          "transl": "Ho, Seeker endlich da.\\. Gefährlich Ort hier, machen kein Spaß hier rumwarten."
         },
         "person": {
          "person": "basin.shad-male-techie",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi.",
          "transl": "Привіт."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Well, prepare took time as well.\\. There, look at machine!",
          "transl": "Aber Vorbereitung auch Zeit gebraucht.\\. Da, gucken an dir Maschine!"
         },
         "person": {
          "person": "basin.shad-male-techie",
          "expression": "DEFAULT"
