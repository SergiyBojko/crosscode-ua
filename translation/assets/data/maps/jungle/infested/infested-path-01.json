          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I prepared it to be ready to capture adorable creature of electricity for use with technology.",
          "transl": "Ich bereit gemacht zum Fangen liebenswert Elektro-Kreatur, um nutzen als Technologie."
         },
         "person": {
          "person": "basin.shad-male-techie",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
