   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Sky Rails...\\. My arch enemy...",
       "transl": "Небесна Залізниця...\\. Мій смертельний ворог..."
      }
     },
     {
      "text": {
       "orig": "We're back in Rhombus Square. You should have seen that coming.",
       "transl": "Ми знову на Ромбічній Площі. Ти мала це передбачити."
      }
     },
     {
      "text": {
       "orig": "I know...\\. they're still the worst, though!",
