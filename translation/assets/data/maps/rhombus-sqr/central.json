        },
        "person": {
         "person": "cross-worlds.pentafist-female-height-friend",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "After all that, do those puny Sky Rails still pose a challenge to you?",
         "transl": "Після всього цього - хіба ця жалюгідна Небесна Залізниця досі є для тебе викликом?"
        },
        "person": {
         "person": "cross-worlds.pentafist-female-height-friend",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
