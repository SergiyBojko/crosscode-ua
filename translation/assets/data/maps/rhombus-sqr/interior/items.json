        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "\\c[3]Hedgehag Sandwiches\\c[0]!",
         "transl": "\\c[3]Igöll-Sandwiche\\c[0]!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "None of these stores seem to have them, and I've been searching all day!",
         "transl": "Kein Laden scheint die zu haben, und ich hab schon den ganzen Tag gesucht!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Why?",
         "transl": "Чому?"
        },
        "person": {
         "person": "main.lea",
         "expression": "NERVOUS"
        }
       },
       {
        "message": {
         "orig": "Because I need to know they exist!",
         "transl": "Weil ich wissen muss, ob sie existieren!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "I've been bugging the devs about it for the past 5 years!",
         "transl": "Ich hab die Entwickler über fünf Jahre damit genervt!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...Why?",
         "transl": "... Чому?"
        },
        "person": {
         "person": "main.lea",
         "expression": "ANNOYED"
        }
       },
       {
        "message": {
         "orig": "...\\.I don't remember.\\. It's been 5 years. ",
         "transl": "...\\. Weiß ich nicht mehr.\\. Ist halt fünf Jahre her!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Just let me know if you find one, ok?",
