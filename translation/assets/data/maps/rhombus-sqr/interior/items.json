        "message": {
         "orig": "Shoot!\\. This store doesn't have it either!",
         "transl": "Mist! Der Laden hier hat sie auch nicht!"
        },
        "person": {
         "person": "guests.banana-man",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
