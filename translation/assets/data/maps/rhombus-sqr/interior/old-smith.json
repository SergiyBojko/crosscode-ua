         },
         "person": {
          "person": "misc.oldsmith",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Already did. All you need to do is put 'em together.",
          "transl": "Hat sie schon. Musst sie nur noch zusammenhauen."
