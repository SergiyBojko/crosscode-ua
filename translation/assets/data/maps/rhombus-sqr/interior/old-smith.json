         "person": {
          "person": "misc.oldsmith",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "If you bring me one, I can make the stone.",
          "transl": "Wenn du mir welche bringst, mach' ich dir den Stein."
         },
         "person": {
          "person": "misc.oldsmith",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "But you know what this means for you?",
          "transl": "Du weißt, was das für dich bedeutet?"
