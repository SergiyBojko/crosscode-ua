      }
     },
     null,
     {
      "text": {
       "orig": "\\v[lore.title.seeker]!\\. This is place of goat now!\\. Leave!",
       "transl": "Seeker!\\. Dieser Ort gehört jetzt uns Ziegen!\\. Geh!"
      }
     },
     null,
     {
      "message": {
       "orig": "[shakes head]",
       "transl": "[schüttelt Kopf]"
      }
     },
     {
      "message": {
       "orig": "How?\\. Meet.\\. Why?",
       "transl": "Wie?\\. Treffen.\\. Warum?"
      }
     },
     {
      "text": {
       "orig": "[even more aggressive goat noises]",
       "transl": "[noch aggressivere Ziegenlaute]"
      }
     },
     null,
     {
      "text": {
       "orig": "No talk!\\. Leave! Or.\\..\\..\\. Fight!!",
       "transl": "Genug geredet!\\. Geh! Oder.\\..\\..\\. kämpfe!!"
      }
     },
     null,
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     }
