  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Ms. Seeker!",
          "transl": "Fräulein Seeker!"
         },
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Did you by chance see my posting at the quest board?",
          "transl": "Haben Sie zufällig meinen Quest-Aushang schon gesehen?"
         },
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I am trying to catch a troupe of thieving Hillkats!",
          "transl": "Ich versuche, eine Truppe von diebischen Hillkats zu fangen!"
         },
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Consequently, I'm in dire need of a seeker's assistance!",
          "transl": "Folglich benötige ich dringend die Hilfe eines Seekers!"
         },
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Can I count on your support?",
          "transl": "Kann ich auf Ihre Unterstützung zählen?"
         },
         "person": {
          "person": "guards.captain-future",
          "expression": "DEFAULT"
         }
        },
        {
         "accepted": [
          {
           "message": {
            "orig": "[nods]",
            "transl": "[киває]"
           },
           "person": {
            "person": "main.lea",
            "expression": "NOD"
           }
          },
          {
           "message": {
            "orig": "You have my gratitude!",
            "transl": "Ich danke Ihnen vielmals!"
           },
           "person": {
            "person": "guards.captain-future",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Allow me to introduce myself.",
            "transl": "Erlauben Sie mir, mich vorzustellen."
           },
           "person": {
            "person": "guards.captain-future",
            "expression": "DEFAULT"
           }
          },
          {
           "name": {
            "orig": "Cpt. Curtis",
            "transl": "Cpt. Curtis"
           },
           "person": {
            "person": "guards.captain-future",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "My name is \\c[3]Edmond Curtis\\c[0], captain of the Rhombus Square Police Force.",
            "transl": "Mein Name ist \\c[3]Edmond Curtis\\c[0], Captain der Polizei von Rhombus Square."
           },
           "person": {
            "person": "guards.captain-future",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Lea!",
            "transl": "Лія!"
           },
           "person": {
            "person": "main.lea",
            "expression": "PROUD"
           }
          },
          {
           "message": {
            "orig": "It's a pleasure to meet you, Ms. Lea!",
            "transl": "Es ist mir ein Vergnügen, Sie kennenzulernen, Fräulein Lea!"
           },
           "person": {
            "person": "guards.captain-future",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Now, let's not waste any more time!\\. Follow me!",
            "transl": "Also, lassen Sie uns keine Zeit verschwenden!\\. Folgen Sie mir!"
