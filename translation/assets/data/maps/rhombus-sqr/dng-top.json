  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "C'mon, there's no need to be afraid.",
       "transl": "Давай, не треба боятися."
      }
     },
     {
      "text": {
       "orig": "You know I can't deal with heights...",
       "transl": "Ти ж знаєш, я не переношу висоти..."
      }
     },
     {
      "text": {
       "orig": "It's all just a game, there's no danger, y'know?",
       "transl": "Це ж просто гра, тут немає ніякої небезпеки, знаєш?"
      }
     },
     {
      "text": {
       "orig": "I know... It just feels so real.",
       "transl": "Знаю... Але все виглядає дуже реалістично."
      }
     },
     {
      "text": {
       "orig": "Just give me some time, ok?",
       "transl": "Просто дай мені трохи часу, гаразд?"
      }
     },
     {
      "text": {
       "orig": "Alright...",
       "transl": "Гаразд..."
      }
     }
    ]
   }
