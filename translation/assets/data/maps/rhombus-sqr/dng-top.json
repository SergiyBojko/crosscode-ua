      "text": {
       "orig": "Expect your skillset to be further expanded over the course of the final stage.",
       "transl": "Очікуйте на розширення вашого арсеналу впродовж фінального етапу."
      }
     },
     {
      "text": {
       "orig": "As a reward for passing Newcomer's Bridge you will be granted access to the mainland.",
       "transl": "У нагороду за проходження Мосту Новачка вам буде надано доступ до материка."
      }
     }
    ]
