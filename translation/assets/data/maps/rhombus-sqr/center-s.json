  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        null,
        null,
        {
         "message": {
          "orig": "Good day, Lea.",
          "transl": "Guten Tag, Lea."
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         }
        },
        {
         "thenStep": [
          {
           "message": {
            "orig": "I was expecting you to arrive \\c[3]alone\\c[0]. We should make sure that no one else is involved in this.",
            "transl": "Ich hatte erwartet, dass du \\c[3]allein\\c[0] kommst. Wir sollten doch darauf achten, dass niemand sonst davon erfährt."
           }
          },
          {
           "message": {
            "orig": "...!",
            "transl": "...!"
           }
          }
         ],
         "elseStep": [
          {
           "message": {
            "orig": "No time to waste, please come this way.",
            "transl": "Keine Zeit zu verlieren, bitte hier entlang."
           }
          },
          null,
          {
           "task": {
            "orig": "Follow Albert to \\c[3]Rhombus Square - Residential District\\c[0].",
            "transl": "Folge Albert ins \\c[3]Wohnviertel von Rhombus Square\\c[0]."
           }
          }
         ]
        }
       ]
      }
     }
    ]
   }
  },
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "And then she said: \"You city folk don't know plants.\"",
       "transl": "Und dann hat sie gesagt: \"Ihr Stadtmenschen habt einfach keine Ahnung von Pflanzen.\""
      }
     },
     {
      "text": {
       "orig": "But she was born here, wasn't she?",
       "transl": "Aber ist sie nicht auch hier geboren?"
      }
     },
     {
      "text": {
       "orig": "That's what I thought too, but she was derailing the argument anyway.",
       "transl": "Dachte ich auch, aber sie hat das Argument trotzdem ständig gebracht."
      }
     },
     {
      "text": {
       "orig": "Oh bother...",
       "transl": "Oh Mann..."
      }
     }
    ]
   }
  },
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Ah, Seeker. What you obtained is ancient. Be careful with it.",
       "transl": "Ah, Seeker. Was du erhalten hast, ist sehr sehr alt. Sei vorsichtig damit."
      }
     }
    ]
   }
  },
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I've been looking to spiff up my character's look.",
       "transl": "Ich will den Look meines Charas etwas aufmotzen."
      }
     },
     {
      "text": {
       "orig": "Good luck with that.",
       "transl": "Viel Spaß dabei."
      }
     },
     {
      "text": {
       "orig": "Why?",
       "transl": "Чому?"
      }
     },
     {
      "text": {
       "orig": "All of the cool cosmetics are only bought with real money.",
       "transl": "All die guten Schmuckstücke bekommt man nur gegen Echtgeld."
      }
     },
     {
      "text": {
       "orig": "What about the \\c[5]horns\\c[0]?",
       "transl": "Was ist mit den \\c[5]Hörnern\\c[0]?"
      },
      "event": [
       null,
       null,
       null,
       {
        "message": {
         "orig": "Hi...?",
         "transl": "Привіт...?"
        }
       },
       {
        "message": {
         "orig": "You!\\. You have the horns!",
         "transl": "Du!\\. Du hast die Hörner!"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        }
       },
       {
        "message": {
         "orig": "Please trade them with me!",
         "transl": "Bitte lass uns tauschen!"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        }
       },
       {
        "message": {
         "orig": "I have a flower you can put in your hair if you want that!",
         "transl": "Ich habe eine Blume, die du dir ins Haar stecken kannst, wenn du möchtest!"
        }
       },
       {
        "message": {
         "orig": "...!!",
         "transl": "...!!"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        }
       },
       {
        "message": {
         "orig": "Nice! So how do you trade it?",
         "transl": "Sehr schön! Also, wie tauschen wir jetzt?"
        }
       },
       {
        "message": {
         "orig": "You don't.\\. They don't allow trading of cosmetics.",
         "transl": "Gar nicht.\\. Schmuckstücke kann man nicht tauschen."
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        }
       },
       {
        "message": {
         "orig": "Whhhyyy?",
         "transl": "Waruuuum?"
        }
       },
       {
        "message": {
         "orig": "Bummer...",
         "transl": "Mist..."
        }
       },
       {
        "message": {
         "orig": "Well then...\\. can you at least tell me how you got them?",
         "transl": "Kannst du mir zumindest sagen, wo du sie her hast?"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        }
       },
       {
        "message": {
         "orig": "[shakes head]",
         "transl": "[schüttelt Kopf]"
        }
       },
       {
        "message": {
         "orig": "... Sorry.",
         "transl": "... Вибач."
        }
       },
       {
        "message": {
         "orig": "Huh.\\. Guess I'll look it up myself, then.",
         "transl": "Hm.\\. Dann werde ich mich wohl selber schlau machen."
        }
       }
      ]
     },
     {
      "text": {
       "orig": "What horns?",
       "transl": "Was für Hörner?"
      }
     },
     {
      "text": {
       "orig": "You haven't seen them? They're metallic and connect to the side of your head.",
       "transl": "Hast du die noch nicht gesehen? Die sind aus Metall und werden seitlich am Kopf befestigt."
      }
     },
     {
      "text": {
       "orig": "I can't say I've ever seen those.",
       "transl": "Kann mich nicht erinnern, die schon mal gesehen zu haben."
      }
     },
     {
      "text": {
       "orig": "Well, that's a shame.\\. I could swear I've seen them on someone.",
       "transl": "Schade.\\. Ich könnte schwören, die schon mal bei jemandem gesehen zu haben."
      }
     }
    ]
   }
  },
