     null,
     null,
     {
      "message": {
       "orig": "...",
       "transl": "..."
      }
     },
     {
      "message": {
       "orig": "Hey there, Lea...",
       "transl": "Hey, Lea..."
      }
     },
     {
      "message": {
       "orig": "That was quite the mess, wasn't it?",
       "transl": "Das war ein ganz schönes Chaos, oder?"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      }
     },
     {
      "message": {
       "orig": "Now where is our little troublemaker?!",
       "transl": "Also, wo ist unser kleiner Rabauke?"
      }
     },
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Ah, there you are!",
       "transl": "Ah, da seid ihr ja!"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Reize!",
       "transl": "Reize!"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "WHAT THE HECK, DUDE?!",
       "transl": "SAG MAL, GEHT'S NOCH?!"
      }
     },
     {
      "message": {
       "orig": "Seriously, what have you and Ivo been up to again?!",
       "transl": "Was zum Teufel hat euch beiden da wieder geritten?!"
      }
     },
     {
      "message": {
       "orig": "Well...\\. Ivo wanted me to try out a few things with those enemies.",
       "transl": "Na ja...\\. Ivo wollte, dass ich was bei diesen Gegnern ausprobiere."
      }
     },
     {
      "message": {
       "orig": "Gave me a few items and told me to feed them.",
       "transl": "Hat mir ein paar Items gegeben, womit ich sie füttern sollte."
      }
     },
     {
      "message": {
       "orig": "And ever since they didn't stop following me!",
       "transl": "Und seitdem hab ich sie an den Hacken!"
      }
     },
     null,
     {
      "message": {
       "orig": "Oh bother...",
       "transl": "Oh Mann..."
      }
     },
     {
      "message": {
       "orig": "Wasn't it Ivo, who told us not to draw too much attention?",
       "transl": "War das nicht Ivo, der gesagt hat, dass wir nicht zu sehr auffallen sollen?"
      }
     },
     {
      "message": {
       "orig": "Yeah, so much for that!",
       "transl": "Ja, so viel dazu!"
      }
     },
     {
      "message": {
       "orig": "Oh well, whatever!",
       "transl": "Ach, egal!"
      }
     },
     {
      "message": {
       "orig": "The problem has been solved, right?",
       "transl": "Das Problem ist doch gelöst, oder?"
      }
     },
     {
      "message": {
       "orig": "No more enemies following me around, so we're good!",
       "transl": "Keine Gegner, die mich mehr verfolgen, also ist doch alles gut!"
      }
     },
     {
      "message": {
       "orig": "We wouldn't have had this kind of trouble if you'd just stayed still!",
       "transl": "Wir hätten aber den ganzen Zinnober nicht veranstalten müssen, wenn du nur einmal stehengeblieben wärst!"
      }
     },
     {
      "message": {
       "orig": "I still don't get why it was so hard for you to find the arena.",
       "transl": "Ich verstehe aber immer noch nicht, warum das so schwer für dich war, die Arena zu finden."
      }
     },
     {
