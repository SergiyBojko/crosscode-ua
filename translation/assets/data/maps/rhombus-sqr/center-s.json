  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "What is this!? A special event?",
       "transl": "Was geht 'n hier ab!? Ist das 'n Flashmob?"
      }
     },
     {
      "text": {
       "orig": "This seriously seems like some kind of hack!\\. Better not get involved!",
       "transl": "Das sieht verdammt nach einem Hack aus!\\. Vorsicht!"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Those seem out of place...",
       "transl": "Die gehören hier doch gar nicht hin..."
      }
     },
     {
      "text": {
       "orig": "Yeah, definitely a hack.\\. Better avoid those.",
       "transl": "Ja, das ist auf jeden Fall ein Hack.\\. Da sollten wir wirklich besser die Finger von lassen."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Is...\\. is that a hillkat? How can it dig out of the glass?!",
       "transl": "Ist...\\. Ist das ein Hillkat? Wie kann es sich denn durch Glas graben?!"
      }
     },
     {
      "text": {
       "orig": "Hacks!\\. Definitely stay away from those!",
       "transl": "Das sind Hacks, Mensch!\\. Die machen das Spiel kaputt!"
      }
     }
    ]
   }
  },
  null,
