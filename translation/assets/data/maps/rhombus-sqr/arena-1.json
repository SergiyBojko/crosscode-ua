   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Good day, Seeker!",
         "transl": "Guten Tag, Seeker!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "The \\c[3]Rhombus Arena\\c[0] is currently under construction. ",
         "transl": "Die \\c[3]Rhombus-Arena\\c[0] wird zur Zeit umgebaut."
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "We apologize for any inconveniences!",
         "transl": "Wir bitten eventuelle Unannehmlichkeiten zu entschuldigen!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "However, the new arena will include a much larger pool of activities for battle-ready Seekers.",
         "transl": "Die neue Arena wird ein umfassenderes Angebot an Aktivitäten für kampferprobte Seeker bieten.<<C<<xxxx (rhom2)"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "These activities will include \\c[3]Ranked Battle\\c[0] for both Solo- & Teamplay, \\c[3]Challenges\\c[0], \\c[3]Boss Rush\\c[0] and more!",
         "transl": "Diese Aktivitäten beinhalten \\c[3]Solo- und Gruppen-Rangkämpfe\\c[0], \\c[3]Herausforderungen\\c[0], \\c[3]Bossjagd\\c[0] und mehr!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "ASTONISHED"
        }
       }
      ]
     }
    ]
   }
