  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Ah, the soothing sounds of water on my umbrella...",
       "transl": "Hach ja, dieses beruhigende Geräusch von Wassertropfen auf meinem Schirm..."
      }
     },
     {
      "text": {
       "orig": "I miss it so dearly...",
       "transl": "Das vermisse ich wirklich..."
      }
     },
     {
      "text": {
       "orig": "If only more Seekers would jump into the water for me.",
       "transl": "Wenn doch nur mehr Seeker für mich ins Wasser springen würden."
      }
     }
