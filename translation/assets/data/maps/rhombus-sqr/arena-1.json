  null,
  null,
  {
   "settings": {
    "event": [
     null,
     null,
     null,
     null,
     null,
     {
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hey you! ",
       "transl": "He, du!"
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi?",
       "transl": "Привіт?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "Yes, you!\\. Uhm...\\. Seeker, wasn't it?",
       "transl": "Ja, du!\\. Öhm...\\. Seeker, richtig?"
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "We have a quest for you!",
       "transl": "Wir haben eine Quest für dich!"
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "guests.lily",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Do we really need to get others involved in this?",
       "transl": "Müssen wir wirklich jemand anderes damit behelligen?"
      },
      "person": {
       "person": "guests.lily",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Yes.\\. I've had my fill of chasing after him.",
       "transl": "Ja.\\. Ich hab's satt, ihm nachzujagen."
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Also she probably knows this place better than we do, don't you think?",
       "transl": "Außerdem kennt sie sich hier wahrscheinlich besser aus als wir, meinst du nicht?"
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "True...",
       "transl": "Ja, gut möglich..."
      },
      "person": {
       "person": "guests.lily",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...?",
       "transl": "...?"
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "So yeah...\\. we're looking for a certain troublemaker.",
       "transl": "Also...\\. Wir suchen einen Freund von uns, ein richtiger Rabauke."
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "He's strolling around somewhere in this world.",
       "transl": "Und er spaziert gerade irgendwo in der Weltgeschichte herum."
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Can you help us find him?",
       "transl": "Hilfst du uns, ihn zu finden?"
      },
      "person": {
       "person": "guests.priel",
       "expression": "DEFAULT"
      }
     },
     {
      "accepted": [
       {
        "message": {
         "orig": "Thank you so much!",
         "transl": "Vielen lieben Dank!"
        },
        "person": {
         "person": "guests.lily",
         "expression": "DEFAULT"
        }
       },
       {
        "name": {
         "orig": "Lily",
         "transl": "Lily"
        },
        "person": {
         "person": "guests.lily",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "I'm Lily, nice to meet you!",
         "transl": "Ich bin Lily. Freut mich, dich kennenzulernen!"
        },
        "person": {
         "person": "guests.lily",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Lea!",
         "transl": "Лія!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "name": {
         "orig": "Priel",
         "transl": "Priel"
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "I'm Priel.\\. Thanks for helping us.",
         "transl": "Ich bin Priel.\\. Danke, dass du uns hilfst."
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Now about the guy we're looking for...",
         "transl": "Nun zu dem Kerl, den wir suchen..."
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "He's rather small, black hair...\\. What's his class again?\\. Powerfist?",
         "transl": "Er ist eher klein, schwarze Haare...\\. Was hat er nochmal für eine Klasse?\\. Powerfist?"
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Pentafist.",
         "transl": "Pentafist."
        },
        "person": {
         "person": "guests.lily",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Right.\\. And finally, he's notorious for wandering all over the place.",
         "transl": "Genau.\\. Außerdem ist er dafür berüchtigt, ständig auf Achse zu sein."
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "In fact, he tends to go everywhere except for where you want him to be.",
         "transl": "Im Grunde ist er überall, nur nie dort, wo du dich mit ihm treffen willst."
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Why don't we try to contact him together?",
         "transl": "Warum versuchen wir nicht, ihn zusammen zu kontaktieren?"
        },
        "person": {
         "person": "guests.lily",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Oh, we can do that?",
         "transl": "Oh, das geht?"
        },
        "person": {
         "person": "guests.priel",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
