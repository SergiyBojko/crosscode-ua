  {
   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Good day, Seeker!",
         "transl": "Доброго дня, Шукаче!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "The \\c[3]Rhombus Arena\\c[0] is currently under construction. ",
         "transl": "\\c[3]Арена Ромбус\\c[0] зараз перебуває на реконструкції."
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "We apologize for any inconveniences!",
         "transl": "Просимо вибачення за викликані незручності!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "However, the new arena will include a much larger pool of activities for battle-ready Seekers.",
         "transl": "Втім, нова арена зможе запропонувати значно ширший спектр активностей для готових до бою Шукачів."
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "These activities will include \\c[3]Ranked Battle\\c[0] for both Solo- & Teamplay, \\c[3]Challenges\\c[0], \\c[3]Boss Rush\\c[0] and more!",
         "transl": "Серед активностей будуть: \\c[3]Рейтингові бої\\c[0] для Одиночної гри та Команд, \\c[3]Виклики\\c[0], \\c[3]Бос-Раш\\c[0] та багато іншого!"
        },
        "person": {
         "person": "advisors.female-tall-blond",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "ASTONISHED"
        }
       }
      ]
     }
    ]
   }
  },
