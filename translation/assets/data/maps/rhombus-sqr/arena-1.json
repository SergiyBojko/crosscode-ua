  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Ah, the soothing sounds of water on my umbrella...",
       "transl": "Ах, заспокійливий звук води на моїй парасольці..."
      }
     },
     {
      "text": {
       "orig": "I miss it so dearly...",
       "transl": "Я так сильно за ним сумую..."
      }
     },
     {
      "text": {
       "orig": "If only more Seekers would jump into the water for me.",
       "transl": "Якби ж більше Шукачів стрибали у воду заради мене."
      }
     }
    ]
   }
