       },
       {
        "message": {
         "orig": "Sitting under this tree...",
         "transl": "Сидіти під цим деревом..."
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "You know, I like this spot here a lot.",
         "transl": "Знаєш, мені дуже подобається це місце."
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "It always feels so... \\c[3]palming\\c[0].",
         "transl": "Тут завжди так... \\c[3]пальмово\\c[0]."
        },
        "person": {
         "person": "cross-worlds.triblader-male-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "ANNOYED"
        }
       }
      ]
     }
    ]
   }
  },
  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I really like this place.",
       "transl": "Мені справді подобається це місце."
      }
     },
     {
      "text": {
       "orig": "It's so quiet and peaceful.",
       "transl": "Тут так тихо й спокійно."
      }
     },
     {
      "text": {
       "orig": "Yeah, those trees have some serious damping qualities.",
       "transl": "Так, ці дерева справді добре приглушують усе навколо."
      }
     },
     {
      "text": {
       "orig": "\\..\\..\\.. z\\.z\\.z",
       "transl": "\\..\\..\\.. х\\.-р\\.-р"
      }
     },
     {
      "text": {
       "orig": "And there she goes...",
       "transl": "І от вона вже спить..."
      }
     }
    ]
   }
