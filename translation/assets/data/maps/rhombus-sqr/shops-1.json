  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I'm not sure about this cactus juice.",
       "transl": "Ich trau diesem Kaktussaft irgendwie nicht."
      }
     },
     {
      "text": {
       "orig": "It's the latest in juice design. Engineered for maximum taste.",
       "transl": "Ist das neueste Saftdesign. Entwickelt für maximalen Geschmack."
      }
     },
     {
      "text": {
       "orig": "Can you tell me more about the company who made it?",
       "transl": "Kannst du mir mehr über die Firma sagen, die ihn produziert?"
      }
     },
     {
      "text": {
       "orig": "I apologize, this information is confidential.",
       "transl": "Tut mir leid, aber diese Infos sind streng geheim."
      }
     },
     {
      "text": {
       "orig": "Mh...",
       "transl": "Mh..."
      }
     }
    ]
   }
