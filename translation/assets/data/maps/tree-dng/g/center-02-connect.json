     },
     {
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ape Guy!! Did you meet the ape guy?",
       "transl": "Affenmensch!! Seid ihr dem Affenmenschen begegnet?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Yes, I did.",
       "transl": "Ja, bin ich.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "ANGRY"
      }
     },
     {
      "message": {
       "orig": "Also, what is this? Wasn't this supposed to be a race?",
       "transl": "Was wird das hier? Sollte das nicht ein Rennen sein?<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SHOUTING"
      }
     },
     {
      "message": {
       "orig": "You bet it is!",
       "transl": "Und ob es das ist!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "DETERMINED"
      }
     },
     {
      "message": {
       "orig": "Then why the D-Link?",
       "transl": "Warum dann der D-Link?"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Why not? It doesn't hurt to have a few breaks in between.",
       "transl": "Warum nicht? Ein paar kleine Pausen zwischendurch können nicht schaden."
      },
      "person": {
       "person": "main.emilie",
       "expression": "CURIOUS"
      }
     },
     {
      "message": {
       "orig": "We just started moments ago!",
       "transl": "Wir haben doch gerade erst angefangen!"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "Oui, but I had to talk about the ape!",
       "transl": "Oui, aber ich musste mit euch über den Affenmenschen reden!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Apes are so funny!",
       "transl": "Affen sind so lustig!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Funny?",
       "transl": "Lustig?"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "This ape oversees every Seeker that enters this place.",
       "transl": "Dieser Affe überwacht jeden Seeker, der diesen Ort betritt."
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     },
     {
      "message": {
       "orig": "It's a mysterious yet honorable creature of ancient origin.",
       "transl": "Eine mysteriöse, aber ehrenwerte Kreatur aus alter Zeit."
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "CONTENT"
      }
     },
     {
      "message": {
       "orig": "So? I still think it's funny!",
       "transl": "Na und? Ich find' ihn trotzdem lustig!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "WATCH_OUT_BADASS"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Fine, then. Let's properly start the race, already.",
       "transl": "Wie du meinst. Nun lasst uns aber endlich mit dem Rennen beginnen.<<A<<[CHANGED 2021/05/22]"
      },
      "person": {
       "person": "antagonists.fancyguy",
       "expression": "LECTURING"
      }
     }
    ]
   }
