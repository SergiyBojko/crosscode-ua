     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Right... so this is a \\c[3]Trial Building\\c[0].",
       "transl": "Gut... Das ist also ein \\c[3]Prüfungsgebäude\\c[0]."
      },
      "person": {
       "person": "main.schneider2",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Does that mean more of those low-level virus thingies? ",
       "transl": "Heißt das, dass da noch mehr von diesen Low Level-Virusviechern drin sind?"
      },
      "person": {
       "person": "main.schneider2",
       "expression": "SKEPTICAL"
      }
     },
     {
      "message": {
       "orig": "I'm fine with those, just keep them coming!",
       "transl": "Von mir aus gern, nur her damit!"
      },
      "person": {
       "person": "main.schneider2",
       "expression": "WINK"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "SMUG"
        }
       },
       {
        "message": {
         "orig": "You're with me, I see!",
         "transl": "Ich seh schon, du kannst es auch kaum erwarten!"
        },
        "person": {
         "person": "main.schneider2",
         "expression": "LAUGH"
        }
       },
       {
        "message": {
         "orig": "Well, let's hope they won't pull out a weirdly overpowered boss next.",
         "transl": "Lass uns nur hoffen, dass die als Nächstes nicht irgend so einen Uberboss aus dem Hut zaubern."
        },
        "person": {
         "person": "main.schneider2",
         "expression": "SKEPTICAL"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "ANNOYED"
        }
       },
       {
        "message": {
         "orig": "Bye.",
         "transl": "Бувай."
        },
        "person": {
         "person": "main.lea",
         "expression": "MOPING"
        }
       },
       {
        "message": {
         "orig": "Gyahahaha!",
         "transl": "Gyahahaha!"
        },
        "person": {
         "person": "main.schneider2",
         "expression": "LAUGH"
        }
       },
       {
        "message": {
         "orig": "No really, it would be troublesome if they threw high level enemies at us now. It's better that way.",
         "transl": "Ne, im Ernst, lieber die als ein paar High Level-Gegner. Ist schon besser so."
        },
        "person": {
         "person": "main.schneider2",
         "expression": "WONDERING"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
