     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "name": {
          "orig": "Barkeep Niskeewa",
          "transl": "Барменка Нісківа"
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Ah, finally, another \\v[lore.title.seeker] visiting my humble establishment.\\. Are you the one with the new supplies?",
          "transl": "О, нарешті, ще один Шукач навідався в мій скромний заклад.\\. Це ти мала принести нові припаси?"
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "About time.\\. That Mr. Nomsworth promised me those ingredients hours ago.",
          "transl": "Нарешті.\\. Той Пан Номсворт обіцяв мені інгредієнти ще години тому."
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Makes me wonder why we even pay fancy paperpushers like him for just doing some calls anyway.",
          "transl": "Не розумію, чому ми взагалі платимо таким протирачам штанів, як він, просто за те, що він робить кілька дзвінків."
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Next time I might just contact those doing the real work myself.",
          "transl": "Наступного разу, я, можливо, сама зв'яжуся з тими хто робить усю роботу."
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Anyway, I'll send him a confirmation about the job.\\. You better go back to him to get your reward.",
          "transl": "В будь-якому разі, я надішлю йому підтвердження про виконання роботи.\\. Тобі варто повернутися до нього за винагородою."
         },
         "person": {
          "person": "rookie-harbor.female-tall-black",
          "expression": "DEFAULT"
         }
        }
       ]
      }
