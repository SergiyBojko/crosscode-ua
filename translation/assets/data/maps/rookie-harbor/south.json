        }
       },
       {
        "message": {
         "orig": "...Hi!",
         "transl": "... Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...Oh! Hey!",
         "transl": "...О! Привіт!"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_AWAY"
        }
       },
       {
        "message": {
         "orig": "Is something the matter?",
         "transl": "Щось сталося?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "... Oh well... Ever notice how that tree has fruit?",
         "transl": "... Ем ну... Помічала, що на тому дереві є фрукти?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       null,
       null,
       {
        "message": {
         "orig": "I heard those are not instant matter but actual fruit!",
         "transl": "Чув, що вони не з миттєвої матерії, а справжні!"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Now I really wonder how they taste...",
         "transl": "Тепер мені стало цікаво, який у них смак..."
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       null,
       {
        "message": {
         "orig": "Oh well... it's not like you can eat real-life fruit as an avatar.",
         "transl": "Та на жаль... аватар не зможе з'їсти справжні фрукти."
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       }
      ]
     }
    ]
   }
