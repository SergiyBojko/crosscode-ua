  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Your friend's still not here. What's the holdup?",
       "transl": "Dein Freund ist immer noch nicht hier. Wo steckt er?"
      }
     },
     {
      "text": {
       "orig": "I dunno... he said he'd arrive around this time.",
       "transl": "Weiß ich nicht... Er sagte, dass er um diese Zeit kommen wollte."
      }
     },
     {
      "text": {
       "orig": "Maybe he's stuck in Rhombus Square, watching the city from afar... you know how it is...",
       "transl": "Ist wahrscheinlich noch in Rhombus Square, um sich die Stadt von weitem anzuschauen... Du weißt, wie reizvoll sie ist..."
      }
     },
     {
      "text": {
       "orig": "Yeah... Can't wait to finally enter that place, too!",
       "transl": "Ja... Kann's auch kaum erwarten, dorthin zu kommen!"
      }
     }
    ]
   }
  },
  {
   "settings": {
