       {
        "message": {
         "orig": "...Oh! Hey!",
         "transl": "... Oh! Hey!"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_AWAY"
        }
       },
       {
        "message": {
         "orig": "Is something the matter?",
         "transl": "Was gibt's?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "... Oh well... Ever notice how that tree has fruit?",
         "transl": "... Na gut... Ist dir schon aufgefallen, dass dieser Baum Früchte trägt?"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       null,
       null,
       {
        "message": {
         "orig": "I heard those are not instant matter but actual fruit!",
         "transl": "Ich habe gehört, dass sie keine Instant-Materie, sondern echte Früchte sind!"
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Now I really wonder how they taste...",
         "transl": "Jetzt frage ich mich wirklich, wie sie wohl schmecken..."
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       null,
       {
        "message": {
         "orig": "Oh well... it's not like you can eat real-life fruit as an avatar.",
         "transl": "Ist ja schließlich nicht so, dass wir als Avatar echte Früchte essen könnten..."
        },
        "person": {
         "person": "cross-worlds.triblader-male-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       }
      ]
     }
    ]
   }
