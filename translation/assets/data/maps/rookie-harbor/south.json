      "text": {
       "orig": "They are late...",
       "transl": "Maaaaann ey, wo bleiben die...?"
      }
     },
     {
      "text": {
       "orig": "C'mon, relax. There is still time.",
       "transl": "Entspann dich. Wir haben doch noch Zeit."
      }
     },
     {
      "text": {
       "orig": "The raid is scheduled in 10 minutes.",
       "transl": "Der Raid fängt in 10 Minuten an."
      }
     },
     {
      "text": {
       "orig": "Nothing is planned. It's going to be a mess...",
       "transl": "Nichts ist vorbereitet. Das wird ein Desaster..."
      }
     },
     {
      "text": {
       "orig": "Don't be so serious about it. It's supposed to be fun, remember?",
       "transl": "Ach, mach kein Drama draus. Das Spiel soll doch Spaß machen, schon vergessen?"
      }
     }
    ]
