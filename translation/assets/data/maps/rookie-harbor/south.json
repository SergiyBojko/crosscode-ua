        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hey there.",
         "transl": "Привіт."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...You seem kinda lost...",
         "transl": "...Виглядаєш трохи розгубленою..."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "If you're waiting for somebody, this is the right spot.",
         "transl": "Якщо когось чекаєш, то це хороше місце."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Pretty much everyone here is waiting for new players arriving from Cross Central.",
         "transl": "Майже всі тут чекають на нових гравців, що прибувають з Кросс Централу."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "It's a popular meetup spot.",
         "transl": "Це популярне місце для зустрічей."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "... You seem to be a new player, too. So you know what I mean, right?",
         "transl": "... Схоже, ти теж новенька. Тож розумієш, про що я, так?"
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "...You're a quiet one, I see.",
         "transl": "...Ти, бачу, мовчазна."
        },
        "person": {
         "person": "cross-worlds.triblader-female-red",
         "expression": "DEFAULT"
        }
       }
      ]
     }
    ]
   }
