  },
  {
   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "rookie-harbor.female-small-black",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hey!\\. It's nice here in the shade, isn't it?",
         "transl": "Гей!\\. Приємно тут у тіні, правда ж?"
        },
        "person": {
         "person": "rookie-harbor.female-small-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...Hi?",
         "transl": "... Привіт?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_AWAY"
        }
       }
      ]
     }
    ]
   }
  },
  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Your friend's still not here. What's the holdup?",
       "transl": "Твого друга досі немає. Де це він пропадає?"
      }
     },
     {
      "text": {
       "orig": "I dunno... he said he'd arrive around this time.",
       "transl": "Без поняття... казав, що прибуде десь у цей час."
      }
     },
     {
      "text": {
       "orig": "Maybe he's stuck in Rhombus Square, watching the city from afar... you know how it is...",
       "transl": "Може, він досі на Ромбічній Площі, роздивляється місто здалеку... сама знаєш, як воно буває..."
      }
     },
     {
      "text": {
       "orig": "Yeah... Can't wait to finally enter that place, too!",
       "transl": "Ага... Теж не можу дочекатися, щоб туди потрапити!"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "npcStates": [
     {
      "event": [
