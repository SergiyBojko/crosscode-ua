  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "They are late...",
       "transl": "Вони запізнюються..."
      }
     },
     {
      "text": {
       "orig": "C'mon, relax. There is still time.",
       "transl": "Та розслабся. Час ще є."
      }
     },
     {
      "text": {
       "orig": "The raid is scheduled in 10 minutes.",
       "transl": "Рейд запланований за 10 хвилин."
      }
     },
     {
      "text": {
       "orig": "Nothing is planned. It's going to be a mess...",
       "transl": "Нічого не сплановано. Це буде хаос..."
      }
     },
     {
      "text": {
       "orig": "Don't be so serious about it. It's supposed to be fun, remember?",
       "transl": "Не сприймай усе так серйозно. Це ж має бути весело, пам'ятаєш?"
      }
     }
    ]
   }
