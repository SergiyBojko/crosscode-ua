     },
     {
      "message": {
       "orig": "Here we are, that should be the village!",
       "transl": "Ось ми й на місці, це має бути те село!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "So...\\. how about we go ahead and visit the major building now?",
       "transl": "Отже...\\. як щодо того, щоб просто піти до головної будівлі?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "AWAY"
      }
     },
     {
      "message": {
       "orig": "You know, to continue the plot and all.",
       "transl": "Ну, щоб просунути сюжет і таке інше."
      },
      "person": {
       "person": "main.emilie",
       "expression": "UP"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     null,
     {
      "task": {
       "orig": "Continue the plot within \\c[3]Ba'kii Kum\\c[0] together with Emilie.",
       "transl": "Продовжте сюжет у \\c[3]Ба'кіі Кумі\\c[0] разом з Емілі."
      }
     }
    ]
   }
