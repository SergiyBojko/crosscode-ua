  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "This book is so interesting!",
       "transl": "Das Buch ist faszinierend!"
      }
     },
     {
      "text": {
       "orig": "I can't stop reading it!",
       "transl": "Ich kann nicht aufhören zu lesen!"
      }
     },
     {
      "text": {
       "orig": "... are you sure this is about the book?",
       "transl": "... Bist du sicher, dass es am Buch liegt?"
      }
     },
     {
      "text": {
       "orig": "...because you could just take the book and get off the table.",
       "transl": "... Weil du das Buch auch einfach nehmen und vom Tisch runterkommen könntest."
      }
     },
     {
      "text": {
       "orig": "We're literally surrounded by couches and cushions!",
       "transl": "Wir sind buchstäblich umringt von Sofas und Kissen!"
      }
     },
     {
      "text": {
       "orig": "Sorry, I'm just totally immersed in this book right now!",
       "transl": "Sorry, ich bin gerade absolut von diesem Buch gefesselt!"
      }
     },
     {
      "text": {
       "orig": "Yeah, sure...",
       "transl": "Ja, sicher..."
      }
     }
    ]
   }
