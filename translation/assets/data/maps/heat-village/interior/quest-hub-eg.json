  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "This book is so interesting!",
       "transl": "Ця книга така цікава!"
      }
     },
     {
      "text": {
       "orig": "I can't stop reading it!",
       "transl": "Не можу від неї відірватися!"
      }
     },
     {
      "text": {
       "orig": "... are you sure this is about the book?",
       "transl": "... ти впевнена, що це через книгу?"
      }
     },
     {
      "text": {
       "orig": "...because you could just take the book and get off the table.",
       "transl": "...тому що ти могла просто взяти її і злізти зі столу."
      }
     },
     {
      "text": {
       "orig": "We're literally surrounded by couches and cushions!",
       "transl": "Ми ж буквально оточені диванами та подушками!"
      }
     },
     {
      "text": {
       "orig": "Sorry, I'm just totally immersed in this book right now!",
       "transl": "Вибач, ця книга мене повністю захопила!"
      }
     },
     {
      "text": {
       "orig": "Yeah, sure...",
       "transl": "Ага, точно..."
      }
     }
    ]
   }
