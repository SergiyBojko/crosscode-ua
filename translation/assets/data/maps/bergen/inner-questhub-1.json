  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I love this lamp, it's so cute!",
       "transl": "Мені подобається ця лампа, вона така мила!"
      }
     },
     {
      "text": {
       "orig": "Just look at all the patterns.",
       "transl": "Тільки поглянь на ці візерунки."
      }
     },
     {
      "text": {
       "orig": "...Yes, very cute.",
       "transl": "...Так, дуже мила."
      }
     },
     {
      "text": {
       "orig": "And here you are sitting on a table. Again.",
       "transl": "А ти сидиш на столі. Знову."
      }
     },
     {
      "text": {
       "orig": "Look, you can see the lamp just fine from over here.",
       "transl": "Цю лампу і звідси добре видно."
      }
     },
     {
      "text": {
       "orig": "Ahhhh, I want one for my place!!",
       "transl": "Ахххх, я хочу таку собі додому!!"
      }
     },
     {
      "text": {
       "orig": "...",
       "transl": "..."
      }
     }
