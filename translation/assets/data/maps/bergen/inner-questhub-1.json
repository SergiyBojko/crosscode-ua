     {
      "text": {
       "orig": "Dear Seekers, welcome to Bergen!",
       "transl": "Liebe Seeker, willkommen in Bergen!"
      }
     },
     {
      "text": {
       "orig": "The mayor is waiting in the \\c[3]lower floor\\c[0] to greet all new Seekers visiting our small town.",
       "transl": "Der Bürgermeister wartet im \\c[3]Untergeschoss\\c[0], um alle neu angekommenen Seeker zu begrüßen."
