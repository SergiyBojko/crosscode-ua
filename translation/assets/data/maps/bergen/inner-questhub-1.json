  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "name": {
          "orig": "Talatu Lips",
          "transl": "Талату Ліпс"
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "There ya are!",
          "transl": "А ось і ти!"
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Ah've been workin' on a li'l somethin' here.",
          "transl": "Я тут собі дещо майструвала."
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "A fancy new hat!",
          "transl": "Гарненький новий капелюшок!"
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...?",
          "transl": "...?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Haha, now don'tcher look at me like that!",
          "transl": "Хаха, та не дивися на мене так!"
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "It has one o' them nice \\c[3]Modifiers\\c[0].",
          "transl": "Він має один із тих файних \\c[3]Модифікаторів\\c[0]"
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "ASTONISHED"
         }
        },
        {
         "message": {
          "orig": "Makes it so ya'll can increase yer chance of loot by havin' a high \\c[3]Combat Rank\\c[0].",
          "transl": "З ним ти зможеш збільшити шанс здобичі, якщо матимеш високий \\c[3]Бойовий Ранг\\c[0]."
         },
         "person": {
          "person": "greenies.female-researcher",
          "expression": "DEFAULT"
