  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "I love this lamp, it's so cute!",
       "transl": "Ich liebe diese Lampe, die ist sooo süüüß!"
      }
     },
     {
      "text": {
       "orig": "Just look at all the patterns.",
       "transl": "Schau dir all die Muster an!"
      }
     },
     {
      "text": {
       "orig": "...Yes, very cute.",
       "transl": "... Ja, sehr süß."
      }
     },
     {
      "text": {
       "orig": "And here you are sitting on a table. Again.",
       "transl": "Und du sitzt schon wieder auf einem Tisch."
      }
     },
     {
      "text": {
       "orig": "Look, you can see the lamp just fine from over here.",
       "transl": "Guck mal, von hier siehst du die Lampe genauso gut."
      }
     },
     {
      "text": {
       "orig": "Ahhhh, I want one for my place!!",
       "transl": "Ohhhh, so eine will ich auch für zu Hause!!"
      }
     },
     {
      "text": {
       "orig": "...",
       "transl": "..."
      }
     }
    ]
   }
