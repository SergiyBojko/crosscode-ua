   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Dear Seekers, welcome to Bergen!",
       "transl": "Шановні Шукачі, ласкаво просимо до Берґена!"
      }
     },
     {
      "text": {
       "orig": "The mayor is waiting in the \\c[3]lower floor\\c[0] to greet all new Seekers visiting our small town.",
       "transl": "Мер чекає на \\c[3]нижньому поверсі\\c[0], щоб привітати всіх нових Шукачів, які завітали до нашого містечка."
      }
     }
    ]
   }
