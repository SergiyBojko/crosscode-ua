     null,
     null,
     {
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "cross-worlds-special.hexacast-jock",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "That should do it for today.",
       "transl": "Das sollte genug sein für heute."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Haha, indeed. A'maist enough tae overthrow a' guilds. ",
       "transl": "Haha, rescht so. Fost jenuch ne janze Gilde plattzumache."
      },
      "person": {
       "person": "cross-worlds-special.hexacast-jock",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Well, at least the smaller ones.",
       "transl": "Na ja, zumindest ne kleenere."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ye think it's aboot time tae fill in Jean? ",
       "transl": "Denkste, es is Zoit se einzuweihe, Jean?"
      },
      "person": {
       "person": "cross-worlds-special.hexacast-jock",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "No... She is just so naive. We have to ease her into it.",
       "transl": "Nein... Sie ist einfach zu naiv. Wir müssen es ihr langsam beibringen."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Remember how annoyingly happy she was the other day about the \"Legendary Rabbit\"?",
       "transl": "Erinnerst du dich, wie sie genervt hat, nachdem sie diesen \"legendären Hasen\" gefangen hat?"
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "She still hasn't realized it's just a plain old \\v[combat.name.gray-frobbit].",
       "transl": "Sie hat immer noch nicht gemerkt, dass es ein stinknormaler Junger Pogonickel war."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hehe true enough. Better tak' it slow. ",
       "transl": "Hehe, rescht haste. Mach' mer libber langsam."
      },
      "person": {
       "person": "cross-worlds-special.hexacast-jock",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Plus, if we tell her now, chances are she bails and puts our operation at risk.",
       "transl": "Außerdem, wenn wir es ihr jetzt verraten, besteht die Gefahr, dass sie abhaut und unsere Operation gefährdet."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "We need her and her attitude to get us more members.",
       "transl": "Wir brauchen sie und ihre Art, um mehr Mitglieder zu kriegen."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I hate that we can't just do \\v[lore.unlock.money-trade]\\c[3]Credit Trading\\c[0] anymore.",
       "transl": "Es nervt total, dass wir nicht mehr einfach \\v[lore.unlock.money-trade]\\c[3]Geld tauschen\\c[0] können."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Anyway... \\. Let's go to the boss.",
       "transl": "Wie auch immer...\\. Lass uns zum Chef gehen."
      },
      "person": {
       "person": "cross-worlds-special.triblader-jeff",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Aye Aye.",
       "transl": "Jo."
      },
      "person": {
       "person": "cross-worlds-special.hexacast-jock",
       "expression": "DEFAULT"
      }
     }
    ]
   }
