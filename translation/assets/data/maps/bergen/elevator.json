      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Anyway, I'm still busy today...",
       "transl": "Allerdings bin ich heute noch beschäftigt...\n"
      },
      "person": {
       "person": "main.glasses",
       "expression": "EMBARRASSED"
      }
     },
     {
      "message": {
       "orig": "But if you don't mind, I'd gladly join tomorrow!",
       "transl": "Wenn du also nichts dagegen hast, bin ich morgen mit von der Partie!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Would that be okay?",
