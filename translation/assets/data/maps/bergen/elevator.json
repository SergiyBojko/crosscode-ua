     {
      "message": {
       "orig": "... Hi?",
       "transl": "... Привіт?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_TOWARD"
      }
     },
     {
      "message": {
       "orig": "Ah! H-\\.Hello!",
       "transl": "А! П-\\.Привіт!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "Sorry, I just went blank there for a second.",
       "transl": "Вибач, я просто задумався."
      },
      "person": {
       "person": "main.glasses",
       "expression": "EMBARRASSED"
      }
     },
     {
      "message": {
       "orig": "I'm \\c[3]C'tron\\c[0], the other member of the First Scholars.",
       "transl": "Я \\c[3]Сі'трон\\c[0], ще один із членів Перших Вчених."
      },
      "person": {
       "person": "main.glasses",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Lin just gave me your contact and told me to say hello.",
       "transl": "Лін щойно дала мені твій контакт і сказала привітатися."
      },
      "person": {
       "person": "main.glasses",
       "expression": "TOWARD"
      }
     },
     {
      "message": {
       "orig": "So...\\. nice to meet you!",
       "transl": "Тож...\\. приємно познайомитися!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "NERVOUS"
      }
     },
     {
      "message": {
       "orig": "Ah, d-don't worry! They told me about your limited speech problem.",
       "transl": "А, н-не хвилюйся! Мені розповіли про твою проблему з мовленням."
      },
      "person": {
       "person": "main.glasses",
       "expression": "SURPRISED"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "So...\\. you really are as \\c[1]over-leveled\\c[0] as they told me.",
         "transl": "То...\\. ти й справді настільки \\c[1]перекачана\\c[0], як мені й казали."
        },
        "person": {
         "person": "main.glasses",
         "expression": "EMBARRASSED"
        }
       },
       {
        "message": {
         "orig": "But I also heard you play with other low-level people.",
         "transl": "Але я також чув, що ти граєш з іншими низькорівневими гравцями."
        },
        "person": {
         "person": "main.glasses",
         "expression": "SMILE"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "But yes, we seem to be about the same level!",
         "transl": "І так, схоже, ми приблизно одного рівня!"
        },
        "person": {
         "person": "main.glasses",
         "expression": "SMILE"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "So...\\. I could join your party, right?",
       "transl": "Тож...\\. я міг би приєднатися до твоєї групи, так?"
      },
      "person": {
       "person": "main.glasses",
       "expression": "TOWARD"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Anyway, I'm still busy today...",
       "transl": "Нажаль, сьогодні я ще зайнятий..."
      },
      "person": {
       "person": "main.glasses",
       "expression": "EMBARRASSED"
      }
     },
     {
      "message": {
       "orig": "But if you don't mind, I'd gladly join tomorrow!",
       "transl": "Але якщо ти не проти, я із задоволенням приєднаюся завтра!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "Would that be okay?",
       "transl": "Тобі це підійде?"
      },
      "person": {
       "person": "main.glasses",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Okey-dokey!",
       "transl": "Окі-докі!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "SMILE"
      }
     },
     {
      "message": {
       "orig": "W-Well then, see you tomorrow, Lea!",
       "transl": "Н-Ну тоді, до завтра, Ліє!"
      },
      "person": {
       "person": "main.glasses",
       "expression": "TOWARD"
      }
     },
     {
      "message": {
       "orig": "Bye!",
       "transl": "Бувай!"
      },
      "person": {
       "person": "main.lea",
       "expression": "EXCITED"
      }
