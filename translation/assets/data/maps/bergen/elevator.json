      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Lin just gave me your contact and told me to say hello.",
       "transl": "Lin hat mir gerade deinen Kontakt gegeben und lässt dich schön grüßen."
      },
      "person": {
       "person": "main.glasses",
       "expression": "TOWARD"
      }
     },
     {
      "message": {
       "orig": "So...\\. nice to meet you!",
