       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "I see you obtained the \\c[3]\\v[item.225.name]\\c[0]!",
           "transl": "Бачу, ви здобули \\c[3]Шейд Синього Льоду\\c[0]!"
          },
          "person": {
           "person": "bergen.male-old-mustache",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "You can now take the Laser Rails to reach \\c[3]\\v[area.heat-area.name]\\c[0]!",
           "transl": "Тепер ви можете скористатися Лазерними Рейками, щоб спуститися до \\c[3]Бордової Долини\\c[0]!"
          },
          "person": {
           "person": "bergen.male-old-mustache",
           "expression": "DEFAULT"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "Dear Seeker, you seem rather confused. Do you wish to pass this barrier?",
           "transl": "Шановна Шукачко, ви, здається, дещо розгублені. Бажаєте пройти цей бар'єр?"
          },
          "person": {
           "person": "bergen.male-old-mustache",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "[nods]",
           "transl": "[киває]"
          },
          "person": {
           "person": "main.lea",
           "expression": "NOD"
          }
         },
         {
          "message": {
           "orig": "In that case, you need to obtain the \\c[3]\\v[item.225.name]\\c[0].",
           "transl": "У такому разі вам потрібно здобути \\c[3]Шейд Синього Льоду\\c[0]."
          },
          "person": {
           "person": "bergen.male-old-mustache",
           "expression": "DEFAULT"
          }
         },
         {
          "message": {
           "orig": "It is given to anyone who completes the \\c[0]\\v[area.cold-dng.name]\\c[0].",
           "transl": "Його отримує кожен, хто проходить \\c[0]Храм Шахти\\c[0]."
          },
          "person": {
           "person": "bergen.male-old-mustache",
           "expression": "DEFAULT"
          }
         },
         {
          "thenStep": [
           {
            "message": {
             "orig": "...?",
             "transl": "...?"
            },
            "person": {
