      "person": {
       "person": "main.glasses",
       "expression": "EMBARRASSED"
      }
     },
     {
      "message": {
       "orig": "I'm \\c[3]C'tron\\c[0], the other member of the First Scholars.",
       "transl": "Ich bin \\c[3]C'tron\\c[0], das andere neue Mitglied der Ersten Gelehrten."
      },
      "person": {
       "person": "main.glasses",
       "expression": "DEFAULT"
      }
     },
