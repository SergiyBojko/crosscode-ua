      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.shizuka",
       "expression": "ANGRY"
      }
     },
     {
      "message": {
       "orig": "I know you can hear me! Where is he?!",
       "transl": "Я знаю, ти мене чуєш! Де він?!"
      },
      "person": {
       "person": "main.shizuka",
       "expression": "YELL"
      }
     },
     {
      "person": {
       "person": "antagonists.gautham",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Shizuka, I have to ask you to leave.",
       "transl": "Шізуко, я мушу попросити тебе піти."
      },
      "person": {
       "person": "antagonists.gautham",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "So, you're keeping him here? What do you think you are doing?!",
       "transl": "То ти тримаєш його тут? Про що ти собі думаєш?!"
      },
      "person": {
       "person": "main.shizuka",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Time is running short. We don't have a choice!",
       "transl": "Час спливає. У нас немає вибору!"
      },
      "person": {
       "person": "antagonists.gautham",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "So you abduct a dying person and let him work until his last breath? Is that it?!",
       "transl": "Тож ви викрадаєте невиліковно хворого чоловіка та змушуєте його працювати до смерті? Це ваш план?!"
      },
      "person": {
       "person": "main.shizuka",
       "expression": "YELL"
      }
     },
     {
      "message": {
       "orig": "I am going to talk some sense into him! Don't get in my way!",
       "transl": "Я приведу його до тями! Не заважай мені!"
      },
      "person": {
       "person": "main.shizuka",
       "expression": "ANGRY"
      }
     },
     {
      "guiInfo": {
       "settings": {
        "text": {
         "orig": "Press \\i[key-up]\\i[key-left]\\i[key-down]\\i[key-right] to move around",
         "transl": "Рухайся з допомогою \\i[key-up]\\i[key-left]\\i[key-down]\\i[key-right]"
        },
        "altText": {
         "orig": "Use \\i[left-stick] to move around",
         "transl": "Рухайся з допомогою \\i[left-stick]"
        }
       }
      }
     }
    ]
