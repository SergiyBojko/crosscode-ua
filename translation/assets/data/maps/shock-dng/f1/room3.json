   "settings": {
    "event": [
     null,
     null,
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.glasses",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ugh... those \\c[3]large Wave balls\\c[0]...\\. how do they even work?\\. They make my brain hurt.",
       "transl": "Uff... Diese \\c[3]großen Wirbelbälle\\c[0]...\\. Wie funktionieren die überhaupt?\\. Die machen mir Kopfschmerzen."
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     },
     {
      "message": {
       "orig": "Yeah, they are strange but they do make sense if you watch them closely.",
       "transl": "Joa, die sind schon seltsam, aber bei genauerer Betrachtung durchaus logisch."
      },
      "person": {
       "person": "main.glasses",
       "expression": "EMBARRASSED"
      }
     },
     {
      "message": {
       "orig": "Wait, don't tell me any more. I'll figure it out myself.",
       "transl": "Moment, sag's mir nicht. Ich find's allein raus."
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "By the way, did you already meet the... I think third enemy type?",
       "transl": "Übrigens, seid ihr schon dem... ich glaube 3. Gegnertyp begegnet?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "CURIOUS"
      }
     },
     {
      "message": {
       "orig": "You mean the \\c[3]floaty fog thingies\\c[0]?",
       "transl": "Du meinst diese \\c[3]fliegenden Nebeldinger\\c[0]?"
      },
      "person": {
       "person": "main.glasses",
       "expression": "TOWARD"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Right... those weird ghosts.",
       "transl": "Genau... diese gruseligen Geister."
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Why can't I just punch them?",
       "transl": "Warum kann ich sie nicht einfach verprügeln?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "They're ghosts. You can't simply punch ghosts.",
       "transl": "Das sind Geister. Geister kann man nicht verprügeln."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "Well, that is until we finally get the element of this temple, I suppose.",
       "transl": "Das heißt...\\. Sobald wir das hiesige Element erhalten haben, vielleicht doch."
      },
      "person": {
       "person": "main.glasses",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Oh, that's right!",
       "transl": "Oh, stimmt!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "I can't wait for that moment!",
       "transl": "Kann's kaum erwarten!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "TAUNTING"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SMILE"
      }
     }
    ]
   }
  }
