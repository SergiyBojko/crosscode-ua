  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Of course I got guard duty on Bergen Trail...",
       "transl": "Звісно ж, мені випало стояти на варті на Стежці Берґена..."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Oh, a small house in the middle of nowhere. Isn't that nice?",
       "transl": "О, маленька хатинка у такій глушині. Хіба не мило?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "analyzable": {
     "text": {
      "orig": "Game Tester",
      "transl": "Тестер гри"
     }
    },
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Oh now look who it is!",
          "transl": "О, гляньте-но, хто тут у нас!"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Could not imagine a better person to show up right now, too.",
          "transl": "Кращої людини, що могла б з'явитися саме зараз, і не вигадаєш."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_AWAY"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Oh, hehe. Looks like you already know what I'm going to ask?",
          "transl": "О, хехе. Схоже, ти вже знаєш, про що я попрошу?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Well... \\. That makes things easy then!",
          "transl": "Ну... \\. Тоді це все спрощує!"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "I got a new job testing parkours, but this time it needs to be done within a time limit.",
          "transl": "Мені дали нову роботу з тестування паркурів, але цього разу їх потрібно проходити за обмежений час."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Sounds pretty dope, right? But also like... \\. lots of work, and I might start sweating even.",
          "transl": "Звучить круто, правда? Але це й... \\. купа роботи, я вже починаю пітніти."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Who would have thought this job could be so hard?",
          "transl": "Хто б міг подумати, що ця робота виявиться настільки складною?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "You'd imagine that running around as an avatar wouldn't really exhaust you.",
          "transl": "Здавалося б, керування аватаром не мало б тебе втомлювати..."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Anyway, what do you say? Wanna help me do this?",
          "transl": "Ну то що? Допоможеш мені з цим?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "accepted": [
          {
           "message": {
            "orig": "[nods]",
            "transl": "[киває]"
           },
           "person": {
            "person": "main.lea",
            "expression": "NOD"
           }
          },
          {
           "message": {
            "orig": "Sweet potatoes! ",
            "transl": "Супер!"
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Alright, let's see...",
            "transl": "Гаразд, один момент..."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          null,
          null,
          null,
          null,
          null,
          {
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "person": {
            "person": "main.lea",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Okay, there we go. Just walk through this point like last time. ",
            "transl": "Ось, готово. Просто пройди через цю точку, як і минулого разу."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "The timer will start automatically and you'll have to finish before it runs out.",
            "transl": "Таймер запуститься автоматично, і тобі треба встигнути до його завершення."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Pretty simple stuff, really. I'm sure you can handle it!",
            "transl": "Все доволі просто. Я впевнений ти впораєшся!"
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           },
           "person": {
            "person": "main.lea",
            "expression": "SMILE"
           }
          }
         ],
         "declined": [
          {
           "message": {
            "orig": "[shakes head]",
            "transl": "[хитає головою]"
           },
           "person": {
            "person": "main.lea",
            "expression": "SHAKE"
           }
          },
          {
           "message": {
            "orig": "Oh man, what a bummer.",
            "transl": "Ой, шкода."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "Come back if you change your mind... ",
            "transl": "Повернись, якщо передумаєш..."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "... I'll just wait here.",
            "transl": "... Я і далі чекатиму тут."
           },
           "person": {
            "person": "cross-worlds.tester-male-rainbow",
            "expression": "DEFAULT"
           }
          },
          {
           "message": {
            "orig": "...",
            "transl": "..."
           },
           "person": {
            "person": "main.lea",
            "expression": "ANNOYED"
           }
          }
         ]
        }
       ]
      }
     },
     {
      "event": [
       {
        "person": {
         "person": "cross-worlds.tester-male-rainbow",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Just go to the start marker on the left. Time will start automatically.",
         "transl": "Просто йди до стартового маркера зліва. Час почнеться автоматично."
        },
        "person": {
         "person": "cross-worlds.tester-male-rainbow",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "But don't leave or it'll reset. Really annoying, I know.",
         "transl": "Але не виходь звідси, бо все скинеться. Дуже дратує, знаю."
        },
        "person": {
         "person": "cross-worlds.tester-male-rainbow",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     {
      "event": [
       {
        "person": {
         "person": "cross-worlds.tester-male-rainbow",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "What are you doing? You only have \\v[timers.roundBergenTimer.formatRemainingTime] left.",
         "transl": "Ти що робиш? У тебе лишилось лише \\v[timers.roundBergenTimer.formatRemainingTime]."
        },
        "person": {
         "person": "cross-worlds.tester-male-rainbow",
         "expression": "DEFAULT"
        }
       }
      ]
     },
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Wow, that looked so taxing. But you pulled through.",
          "transl": "Ого, виглядало виснажливо. Але ти впоралась."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "And you didn't even break a sweat. Do you work out or something?",
          "transl": "І навіть не спітніла. Ти тренуєшся чи що?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "CHARMED"
         }
        },
        {
         "message": {
          "orig": "And nothing weird happened, right? No sudden strokes or anything?",
          "transl": "І нічого дивного не сталося, так? Жодних раптових струсів чи чогось такого?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[shakes head]",
          "transl": "[хитає головою]"
         },
         "person": {
          "person": "main.lea",
          "expression": "SHAKE"
         }
        },
        {
         "message": {
          "orig": "My boss will be thrilled! ",
          "transl": "Мій бос буде в захваті!"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "CHARMED"
         }
        },
        {
         "message": {
          "orig": "Thanks so much... \\. again! You really nail these tracks.",
          "transl": "Дякую велике... \\. ще раз! У тебе просто талант до цього."
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "We make a great team, don't you think?",
          "transl": "Ми класна команда, як думаєш?"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Okay, right. I'll go do my report now. Until next time!",
          "transl": "Точно. Піду писати звіт. До зустрічі!"
         },
         "person": {
          "person": "cross-worlds.tester-male-rainbow",
          "expression": "DEFAULT"
         }
        },
        {
         "thenStep": [
          {
           "message": {
            "orig": "Bye.",
            "transl": "Бувай."
