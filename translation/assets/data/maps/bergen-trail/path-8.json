  {
   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Great view from up here, huh?",
         "transl": "Tolle Aussicht von hier oben, was?"
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Personally, I like watching people more than admiring the view.",
         "transl": "Aber noch lieber beobachte ich die Leute hier."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "This is the area right before Bergen Village.",
         "transl": "An dieser Stelle hier gelangen die Spieler nach Bergen."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "People get excited when they realize they're finally at the end of the trail.",
         "transl": "Nach dem mühevollen Aufstieg hüpft ihnen das Herz vor Freude, wenn sie das Ziel in Sichtweite sehen."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Seeing the look on their faces...\\. There's nothing quite like it.",
         "transl": "Dieser Ausdruck auf ihren Gesichtern...\\. ist einfach unbezahlbar."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Takes me back to when I climbed the trail for the first time.",
         "transl": "Erinnert mich daran, als ich zum ersten Mal selbst hier hochkam."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "How?",
           "transl": "Як?"
          },
          "person": {
           "person": "main.lea",
           "expression": "HAND_POINT_SELF"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "...?",
           "transl": "...?"
          },
          "person": {
           "person": "main.lea",
           "expression": "HAND_POINT_SELF"
          }
         }
        ]
       },
       {
        "message": {
         "orig": "Yes, I did see you, actually! ",
         "transl": "Ja, dich habe ich auch gesehen!"
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "You had a look on your face that said you'd figure out a way to get up here sooner or later.",
         "transl": "Der Ausdruck auf deinem Gesicht sagte, dass du früher oder später einen Weg hier hoch finden würdest."
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "And look where you are now! Well done.",
         "transl": "Und schau, wo du nun bist! Das verdient Anerkennung!"
        },
        "person": {
         "person": "cross-worlds.quadroguard-female-black",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "PROUD"
        }
       }
      ]
     },
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.quadroguard-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Where is he?",
          "transl": "Wo ist er?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "Oh sorry, is this for me? ",
          "transl": "Oh, Entschuldigung, ist das für mich?"
         },
         "person": {
          "person": "cross-worlds.quadroguard-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Oh cool, didn't expect this so soon. Thanks a bunch!",
          "transl": "Oh, cool, hätte ich nicht so schnell erwartet. Danke vielmals!"
         },
         "person": {
          "person": "cross-worlds.quadroguard-female-black",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        }
       ]
      }
     }
    ]
   }
  },
