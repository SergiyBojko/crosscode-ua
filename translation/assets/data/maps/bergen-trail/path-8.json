  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Guard Impostor",
       "transl": "Вартовий-Самозванець"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "Oh yes, you really are a splendid animal.\\. Just never run away again, okay?",
       "transl": "О так, ти справді чудова тваринка.\\. Тільки більше не тікай, добре?"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi!",
       "transl": "Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     null,
     {
      "message": {
       "orig": "What, you again?\\. Do you not respect my authority as a noble guard of Bergen?",
       "transl": "Що, знову ти?\\. Ти що, не поважаєш мій авторитет як благородного охоронця Берґена?"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     {
      "message": {
       "orig": "Ah, it seems that my ruse has been uncovered.",
       "transl": "Ах, схоже, що мою хитрість було викрито."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "I resent the crude deception, but I could not allow my precious pet goat Zira to be taken by you.",
       "transl": "Я не хотів вдаватися до такого грубого обману, та я не міг дозволити, щоб моя дорогоцінна коза Зіра потрапила у твої руки."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "Lea!",
       "transl": "Лія!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     {
      "message": {
       "orig": "Oh, you want to bring both of us in for interrogation?\\. I fear we can't oblige.",
       "transl": "Ох, ти хочеш затримати нас обох?\\. Боюся, ми не можемо цього допустити."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "You see, we have some big plans that will change this entire mountain.\\.\\. And besides...",
       "transl": "Розумієш, у нас є великі плани, що змінять усю цю гору.\\.\\. І до того ж..."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "name": {
       "orig": "Guard Impostor",
       "transl": "Вартовий-Самозванець"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "SHOCKED"
      }
     },
     {
      "message": {
       "orig": "... I believe our three friends here would like some of your time.",
       "transl": "... гадаю, нашим трьом друзям потрібна хвилинка твоєї уваги."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     null,
     {
      "message": {
       "orig": "Come, Zira.\\. And farewell to you, \\v[lore.title.seeker]!",
       "transl": "Ходімо, Зіро.\\. І прощавай, \\v[lore.title.seeker]ко!"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     }
    ]
   }
