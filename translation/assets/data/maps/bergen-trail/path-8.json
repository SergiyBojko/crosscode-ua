     null,
     {
      "name": {
       "orig": "Guard Impostor",
       "transl": "Falscher Wachmann"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "SHOCKED"
      }
     },
     {
      "message": {
       "orig": "... I believe our three friends here would like some of your time.",
       "transl": "... werden sich unsere drei Freunde hier jetzt um dich kümmern."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     null,
     {
      "message": {
       "orig": "Come, Zira.\\. And farewell to you, \\v[lore.title.seeker]!",
       "transl": "Komm, Zira.\\. Und auf Nimmerwiedersehen, Seeker!"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     }
    ]
   }
