  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Guard Impostor",
       "transl": "Falscher Wachmann"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "Oh yes, you really are a splendid animal.\\. Just never run away again, okay?",
       "transl": "Jaaa... Du bist ein feines Tier!\\. Lauf nur nicht noch einmal weg, hörst du?"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi!",
       "transl": "Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     null,
     {
      "message": {
       "orig": "What, you again?\\. Do you not respect my authority as a noble guard of Bergen?",
       "transl": "Du schon wieder?\\. Du respektierst wohl nicht meine Autorität als ehrbare Wache von Bergen?"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     {
      "message": {
       "orig": "Ah, it seems that my ruse has been uncovered.",
       "transl": "Ah, sieht so aus, als wäre ich enttarnt worden."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "I resent the crude deception, but I could not allow my precious pet goat Zira to be taken by you.",
       "transl": "Ich verachte den scheußlichen Betrug, aber ich konnte nicht erlauben, dass du mir Zira wegnimmst!"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "Lea!",
       "transl": "Лія!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     {
      "message": {
       "orig": "Oh, you want to bring both of us in for interrogation?\\. I fear we can't oblige.",
       "transl": "Oh, du willst uns also beide ins Verhör nehmen?\\. Ich fürchte, das kann ich nicht zulassen."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     {
      "message": {
       "orig": "You see, we have some big plans that will change this entire mountain.\\.\\. And besides...",
       "transl": "Versteh doch, wir haben große Pläne, die den gesamten Berg verändern werden.\\.\\. Im Übrigen..."
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "UNHORNED"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
