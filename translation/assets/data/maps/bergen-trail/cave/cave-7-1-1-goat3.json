        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Very well, let me explain.",
         "transl": "Гаразд, я поясню."
        },
        "person": {
         "person": "bergen.male-goatman-white",
         "expression": "DEFAULT"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "[shakes head]",
         "transl": "[хитає головою]"
        },
        "person": {
         "person": "main.lea",
         "expression": "SHAKE"
        }
       },
       {
        "message": {
         "orig": "Well, I shall tell you regardless.",
         "transl": "Ну, я все одно тобі розповім."
        },
        "person": {
         "person": "bergen.male-goatman-white",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "ANNOYED"
        }
       }
      ],
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      },
