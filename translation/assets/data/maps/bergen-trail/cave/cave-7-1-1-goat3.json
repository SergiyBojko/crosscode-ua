     {
      "message": {
       "orig": "Who would have thought that you were the intruder?\\. Can you not let a man and his goats live in peace?",
       "transl": "Wer hätte gedacht, dass du der Eindringling bist?\\. Kannst du einen Mann und seine Ziegen nicht in Frieden lassen?"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "DEFAULT"
      }
     },
     {
