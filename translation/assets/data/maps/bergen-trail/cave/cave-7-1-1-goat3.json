       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Soon we shall trample the goatless masses and make the entire Track ours!",
       "transl": "Schon bald werden wir die ziegenlosen Massen niedertrampeln und der Pfad wird unser sein!"
      },
      "person": {
       "person": "bergen.male-goatman-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "... Lea.",
