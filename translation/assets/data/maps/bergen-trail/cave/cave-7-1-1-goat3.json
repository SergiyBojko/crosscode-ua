     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "\\v[lore.title.seeker], come in.\\. Bergen Guard speaking, can you hear us?",
       "transl": "\\v[lore.title.seeker]ко, прийом.\\. Говорить варта Берґена, ти нас чуєш?"
      },
      "person": {
       "person": "guards.captain-female-hairbun",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi!",
       "transl": "Привіт!"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_TOWARD"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Good!\\. Our guards have observed movement coming from the Horncave.\\. Did you find anything?",
       "transl": "Чудово!\\. Наші вартові помітили рух у Рогатій Печері.\\. Ти щось знайшла?"
      },
      "person": {
       "person": "guards.captain-female-hairbun",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "THINKING"
      }
     },
     {
      "message": {
       "orig": "Lea. Meet. Lea! How?",
       "transl": "Лія. Зустрітися. Лія! Як?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED"
      }
     },
     {
      "message": {
       "orig": "Goats AND Papaguns?\\. Working together in our cold mountains?\\. What is this madness?",
       "transl": "Кози І Папугани?\\. Діють спільно у наших холодних горах?\\. Що це за божевілля?"
      },
      "person": {
       "person": "guards.captain-female-hairbun",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "There must be something bigger behind this.\\. We will need to start more investiga\\..\\..\\..\\. wait!",
       "transl": "За цим має стояти щось більше.\\. Нам доведеться глибше це розслі-\\..\\..\\..\\. зажди!"
      },
      "person": {
       "person": "guards.captain-female-hairbun",
       "expression": "DEFAULT"
      }
     },
     {
