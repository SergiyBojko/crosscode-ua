         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         }
        },
        {
         "message": {
          "orig": "I... I don't know what to say. ",
          "transl": "Ich... Ich weiß nicht, was ich sagen soll."
         }
        },
        {
         "message": {
          "orig": "Thank you so much. I've never gotten anything from anyone.",
          "transl": "Vielen, vielen Dank. Ich habe noch nie etwas von irgendjemandem bekommen."
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         }
        },
        {
         "message": {
