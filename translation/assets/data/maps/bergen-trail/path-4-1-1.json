  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Ohhhh, a hidden cave! Nice.",
       "transl": "Оооо, прихована печера! Круто!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "ASTONISHED"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "It's like we're standing at the edge of the world, non?",
       "transl": "Так наче ми стоїмо на краю світу, non?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "npcStates": [
     null,
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Life... what does it mean?",
          "transl": "Життя... що воно означає?"
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED"
         }
        },
        {
         "message": {
          "orig": "An endless cycle of agony and pain.",
          "transl": "Нескінченний цикл агонії і болю."
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "We are but trapped in a nightmare, awaiting the final call.",
          "transl": "Ми всі у полоні кошмару, приречені лиш чекати на визволення від нього."
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Oh... a gift? \\.\\.\\. You give me this, just like that?",
          "transl": "О... подарунок? \\.\\.\\. Ти даєш мені це... просто так?"
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "I... I don't know what to say. ",
          "transl": "Я... Я й не знаю, що сказати."
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Thank you so much. I've never gotten anything from anyone.",
          "transl": "Щиро тобі дякую. Мені ніколи ніхто нічого не дарував."
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SAD"
         }
        },
        {
         "message": {
          "orig": "I will forever remember this.",
          "transl": "Я завжди це пам'ятатиму."
         },
         "person": {
          "person": "cross-worlds.hexacast-male-dark",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "PROUD"
         }
        }
       ]
      }
     }
    ]
   }
