  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Bill Masters",
       "transl": "Білл Мастерс"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ahh, the sounds of combat.\\. Invigorating to these old bones!",
       "transl": "Ах, звуки битви.\\. Бадьорять ці старі кістки!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "EXHAUSTED"
      }
     },
     {
      "message": {
       "orig": "Those sure were some impressive machines.\\. Just imagine what they could do in the hands of an able soldier.",
       "transl": "Це були дійсно вражаючі машини.\\. Лише уяви, що вони могли б зробити в руках вправного солдата."
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "It is a damn shame that they just disappeared after you defeated them.",
       "transl": "Шкода, що вони просто зникли після того, як ти їх перемогла."
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "THINKING"
      }
     },
     {
      "message": {
       "orig": "This won't be a problem, \\v[lore.title.seeker]!\\. I found the location of another group that should lead us to the facility!",
       "transl": "Це не проблема, \\v[lore.title.seeker]ко!\\. Я знайшов координати ще однієї групи, яка зможе привести нас до комплексу!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Make a move towards \\c[3]Bergen Waterfalls\\c[0], \\v[lore.title.seeker], and eliminate all opposition!",
       "transl": "Рушай до \\c[3]Водоспадів Берґена\\c[0], \\v[lore.title.seeker]ко, і знищ усе, що стане на заваді!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Bye.",
       "transl": "Бувай."
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     }
    ]
   }
