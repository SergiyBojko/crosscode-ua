  null,
  {
   "settings": {
    "text": {
     "orig": "A perfectly regular stone",
     "transl": "Цілком нормальний камінь"
    }
   }
  },
  null,
  null,
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Nice view from here!",
       "transl": "Гарний звідси краєвид!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SMILE"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "So many waterfalls! Kind of makes you want to jump into the water.",
       "transl": "Стільки водоспадів! Аж хочеться стрибнути у воду."
      },
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Except it's cold. And avatars can't swim. And you really shouldn't swim near waterfalls.",
       "transl": "Хоча вона холодна. І аватари не вміють плавати. І біля водоспадів узагалі не варто плавати."
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Why did I think that was a good idea again?",
       "transl": "І чому я взагалі подумала, що це хороша ідея?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "thenStep": [
       {
        "message": {
         "orig": "You'd think they'd place something unique and interesting on this spot.",
         "transl": "Здавалося б, тут мали б поставити щось унікальне й цікаве."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       },
       {
        "message": {
         "orig": "It's just a \\c[3]regular\\c[0] rock, though.",
         "transl": "Аце це просто \\c[3]нормальний\\c[0] камінь."
        },
        "person": {
         "person": "main.emilie",
         "expression": "CURIOUS"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "Such a \\c[3]perfectly regular\\c[0] stone here, don't you agree Lea?",
         "transl": "Це ж виглядає як \\c[3]абсолютно нормальний\\c[0] камінь, чи не так, Ліє?"
        },
        "person": {
         "person": "main.sergey",
         "expression": "AWAY"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
   }
  },
