  null,
  {
   "settings": {
    "text": {
     "orig": "A perfectly regular stone",
     "transl": "Ein ganz gewöhnlicher Stein"
    }
   }
  },
  null,
  null,
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Nice view from here!",
       "transl": "Schöne Aussicht von hier!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SMILE"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "So many waterfalls! Kind of makes you want to jump into the water.",
       "transl": "So viele Wasserfälle! Da will man glatt ins Wasser springen."
      },
      "person": {
       "person": "main.emilie",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Except it's cold. And avatars can't swim. And you really shouldn't swim near waterfalls.",
       "transl": "Mal davon abgesehen, dass es eiskalt ist. Und Avatare nicht schwimmen können. Und man nicht in der Nähe von Wasserfällen schwimmen sollte."
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Why did I think that was a good idea again?",
       "transl": "Warum dachte ich nochmal, dass das eine gute Idee wäre?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "thenStep": [
       {
        "message": {
         "orig": "You'd think they'd place something unique and interesting on this spot.",
         "transl": "Eigentlich hätte ich hier an dieser Stelle etwas Einzigartiges und Interessantes erwartet."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       },
       {
        "message": {
         "orig": "It's just a \\c[3]regular\\c[0] rock, though.",
         "transl": "Stattdessen bloß ein \\c[3]stinknormaler\\c[0] Stein."
        },
        "person": {
         "person": "main.emilie",
         "expression": "CURIOUS"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "Such a \\c[3]perfectly regular\\c[0] stone here, don't you agree Lea?",
         "transl": "Das hier sieht doch wie ein \\c[3]ganz gewöhnlicher\\c[0] Stein aus, oder, Lea?"
        },
        "person": {
         "person": "main.sergey",
         "expression": "AWAY"
        }
       }
      ]
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
   }
  },
