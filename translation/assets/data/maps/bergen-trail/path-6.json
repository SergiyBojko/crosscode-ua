     null,
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Girl, you're interfering with our epic stare down!",
          "transl": "Ей, дівчино, ти заважаєш нашій епічній дуелі поглядів!"
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Just put the present here. This is not the first time this has happened to me.",
          "transl": "Просто поклади подарунок тут. Зі мною це вже не вперше трапляється."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...?",
          "transl": "...?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "Every major holiday someone brings me a gift. Different player each time. Super weird.",
          "transl": "На кожне велике свято хтось приносить мені подарунок. Щоразу інший гравець. Дуже дивно."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "Well... Bye...",
          "transl": "Ну... Бувай..."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "MOPING"
         }
        }
       ]
      }
     }
    ]
   }
