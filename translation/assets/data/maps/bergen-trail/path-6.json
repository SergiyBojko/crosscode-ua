          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "...!",
          "transl": "...!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "Girl, you're interfering with our epic stare down!",
          "transl": "Mädel, du störst unser episches Starr-Duell!"
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Just put the present here. This is not the first time this has happened to me.",
          "transl": "Leg das Geschenk einfach da hin. Das ist nicht das erste Mal, dass mir das passiert."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...?",
          "transl": "...?"
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "Every major holiday someone brings me a gift. Different player each time. Super weird.",
          "transl": "An jedem größeren Feiertag bringt mir jemand ein Geschenk. Jedes Mal ein anderer Spieler. Sehr seltsam."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "Well... Bye...",
          "transl": "Also dann... Bye..."
         },
         "person": {
          "person": "cross-worlds.pentafist-male-rasta",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "MOPING"
         }
        }
       ]
      }
     }
