  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Bill Masters",
       "transl": "Bill Masters"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "HAHA, take that you traitorous piles of snow!",
       "transl": "HAHA, nehmt DAS, verräterischer Haufen Schnee!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "SMUG"
      }
     },
     {
      "message": {
       "orig": "Yes, excellent work, \\v[lore.title.seeker]!\\. It seems like you mopped them up nicely.",
       "transl": "Ja, ausgezeichnete Arbeit, Seeker!\\. Das war die gerechte Tracht Prügel, die ich im Sinn hatte."
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "And you secured that location tracking device that those winter soldiers dropped.",
       "transl": "Und du hast das Ortungsgerät sichergestellt, was diese Wintersoldaten hinterlassen haben."
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "It should lead you straight to the facility which created all that wonderful weaponry.",
       "transl": "Es sollte dich direkt zur Anlage führen, die all diese wunderbaren Waffen herstellt."
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "You should locate it and mount a full assault immediately, to secure the weapons for the use of mankind!",
       "transl": "Finde sie und starte sofort einen Frontalangriff, um die Waffen wiederzubeschaffen - für die Menschheit!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_AWAY"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Good.\\. You know what to do.\\. Dismissed!",
       "transl": "Gut.\\. Du weißt, was zu tun ist.\\. Wegtreten!"
      },
      "person": {
       "person": "guards.male-xbox",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Bye.",
       "transl": "Бувай."
      },
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     }
    ]
   }
