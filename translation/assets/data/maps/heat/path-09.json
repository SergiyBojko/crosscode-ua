         "message": {
          "orig": "If the instructions on that tablet are correct, the place we have been searching for should be somewhere nearby. ",
          "transl": "Якщо вказівки на цій табличці правильні, місце, яке ми шукаємо, має бути десь поблизу."
         },
         "person": {
          "person": "nomads.female-shorthair-bluetunic",
          "expression": "DEFAULT"
