      }
     },
     {
      "message": {
       "orig": "You are coming with me, traitor!\\. You are a stain on the honor of the Ba'kii Guard!",
       "transl": "Du kommst mit mir, Verräter!\\. Du hast die Ehre der Ba'kii-Wache beschmutzt!"
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi...!",
       "transl": "Привіт...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "PROUD"
      }
     },
     {
      "message": {
       "orig": "Ah, hello Ms. \\v[lore.title.seeker].\\. You have done well in apprehending him.\\. Now we will bring him to justice.",
       "transl": "Ah, hallo, Fräulein Seeker.\\. Du hast uns einen großen Dienst erwiesen.\\. Wir werden ihn seiner gerechten Strafe zuführen."
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "What, you?\\. I was your superior and this is how you show your respect?",
       "transl": "Was, du?\\. So gedenkst du, deinem ehemaligen Vorgesetzten Respekt zu zollen?"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I am a guard of \\v[area.heat-village.name] and sworn to protect shad- and humankind from evil.\\. Like you, traitor.",
       "transl": "Als Wache von Ba'kii Kum habe ich geschworen, Menschen wie Shad vor Bösem zu beschützen.\\. So wie dir, Verräter."
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I see...\\. the guard truly has become soft.",
       "transl": "Ich verstehe...\\. Die Wache ist wirklich weich geworden."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
