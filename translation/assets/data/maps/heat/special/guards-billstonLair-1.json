     },
     {
      "message": {
       "orig": "You are coming with me, traitor!\\. You are a stain on the honor of the Ba'kii Guard!",
       "transl": "Ти йдеш зі мною, зраднику!\\. Ти - пляма на честі варти Ба'кіі Куму!"
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Hi...!",
       "transl": "Привіт...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "PROUD"
      }
     },
     {
      "message": {
       "orig": "Ah, hello Ms. \\v[lore.title.seeker].\\. You have done well in apprehending him.\\. Now we will bring him to justice.",
       "transl": "А, вітаю, пані Шукачко.\\. Ви добре впоралися з його затриманням.\\. Тепер ми притягнемо його до відповідальності."
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "What, you?\\. I was your superior and this is how you show your respect?",
       "transl": "Що, ти?\\. Я був твоїм командиром, і ось так ти показуєш свою повагу?"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I am a guard of \\v[area.heat-village.name] and sworn to protect shad- and humankind from evil.\\. Like you, traitor.",
       "transl": "Я - вартова Ба'кіі Куму і присягнула захищати шадів і людей від зла.\\. Такого, як ти, зраднику."
      },
      "person": {
       "person": "guards.female-hairs-black",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "I see...\\. the guard truly has become soft.",
       "transl": "Розумію...\\. варта справді розм'якла."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
