      }
     },
     {
      "message": {
       "orig": "You... you sure learned some fancy tricks at \\v[lore.title.seeker]-academy, eh?",
       "transl": "Ти... ти, бачу, навчився всіляких фокусів в академії Шукачів, га?"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
