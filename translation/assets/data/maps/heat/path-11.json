      }
     },
     {
      "message": {
       "orig": "Hi...!",
       "transl": "Привіт...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     null,
     null,
     {
      "message": {
       "orig": "Who\\..\\..\\..\\.\\. what!?\\. You again?",
       "transl": "Wer\\..\\..\\..\\.\\. was!?\\. Du schon wieder?"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Ah, \\v[lore.title.seeker]!\\. Time good for appearing.\\. I in hurry and run now.\\. Bye!",
       "transl": "Ah, Seeker!\\. Zeit gut zum Abhauen.\\. Ich in Eile und rennen jetzt.\\. Bye!"
      },
      "person": {
       "person": "baki.male-green-small",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Bye...",
       "transl": "Бувай..."
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_TOWARD"
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "name": {
       "orig": "Billston",
       "transl": "Billston"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     {
      "message": {
       "orig": "You...",
       "transl": "Du..."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...?",
       "transl": "...?"
      },
      "person": {
       "person": "main.lea",
       "expression": "SURPRISED_TOWARD"
      }
     },
     {
      "message": {
       "orig": "You just had to come along and mess with the order in this place, didn't you.",
       "transl": "Du musstest dich ja unbedingt einmischen und die Ordnung hier zerstören, nicht wahr?"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "You fancy heroes don't seem to understand how things work.",
       "transl": "Ihr strahlenden Helden habt offenbar keine Ahnung, wie die Dinge laufen."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "We humans are the ones running the place!\\. Building roads, protecting the settlements... keeping civilization.\\.",
       "transl": "Wir Menschen haben hier das Sagen!\\. Wir bauen Straßen, beschützen die Unterkünfte... erhalten die Zivilisation.\\."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...",
       "transl": "..."
      },
      "person": {
       "person": "main.lea",
       "expression": "ANNOYED"
      }
     },
     {
      "message": {
       "orig": "We should just take what we need.\\. And you won't stop me, \\v[lore.title.seeker] or not!",
       "transl": "Wir sollten nehmen, was uns gehört.\\. Und du wirst mich nicht aufhalten, Seeker!"
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "DETERMINED"
      }
     },
     null,
     null,
     null,
     {
      "message": {
       "orig": "Let me teach you some rules of the world I kept running.",
       "transl": "Ich werd dir jetzt mal ein paar Lektionen erteilen, die mich die Welt hier gelehrt hat."
      },
      "person": {
       "person": "guards.quest-male-mustache-white",
       "expression": "DEFAULT"
      }
     }
    ]
   }
  },
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Come on, be a good, simple citizen and pay the toll. It is needed for your protection.",
       "transl": "Na los, sei ein braver Bürger und zahl das Schutzgeld. Ist nur zu deiner eigenen Sicherheit."
      }
     },
     {
      "text": {
       "orig": "But human guard. Taxes get paid and rest trademoney is needed for life.",
       "transl": "Moment, Menschenwache. Steuern schon gezahlt und Rest ist Geld für Leben."
      }
     },
     {
      "text": {
       "orig": "We need that money to properly keep the peace you need for your profitable business. So just pay up.",
       "transl": "Wir brauchen das Geld, um den Frieden zu wahren und euch ein profitables Geschäft zu ermöglichen. Zahl also einfach."
      }
     },
     {
      "text": {
       "orig": "This not justice. Not fair. Such scandal!",
       "transl": "Das nicht gerecht. Nicht fair. Skandal!"
      }
     },
     {
      "text": {
       "orig": "I am justified to \\c[5]take it by force\\c[0]. Don't make me repeat myself!",
       "transl": "Ich bin berechtigt, \\c[5]es auch gewaltsam einzutreiben\\c[0]. Ich sag dir das nur einmal."
      }
     }
    ]
   }
  },
