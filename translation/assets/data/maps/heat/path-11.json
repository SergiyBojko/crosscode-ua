  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "main.glasses",
          "expression": "SMILE"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "There you are! Hello!",
          "transl": "Da bist du ja! Hallo!"
         },
         "person": {
          "person": "main.glasses",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "So finally we meet...",
          "transl": "Endlich lernen wir uns mal kennen!"
         },
         "person": {
          "person": "main.glasses",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I already introduced myself before, right?",
          "transl": "Ich habe mich ja schon vorgestellt, richtig?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Well... I know \\c[3]C'tron\\c[0] is a bit strange. You can also call me \\c[3]Toby\\c[0] if you like.",
          "transl": "Ja, ich weiß, \\c[3]C'tron\\c[0] klingt ein bisschen merkwürdig. Du kannst mich auch gerne \\c[3]Toby\\c[0] nennen, wenn du möchtest."
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "Or \\c[3]Tronny\\c[0]. That's what all the guild members call me.",
          "transl": "Oder \\c[3]Tronny\\c[0]. So nennen mich die anderen Gildenmitglieder."
         },
         "person": {
          "person": "main.glasses",
          "expression": "WORRIED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "...How?",
          "transl": "... Як?"
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Huh?",
          "transl": "Hm?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "THOUGHTFUL"
         }
        },
        {
         "message": {
          "orig": "Drat! You can't speak! I forgot again!",
          "transl": "Ah, Mist! Schon wieder vergessen! Du kannst ja nicht sprechen!"
         },
         "person": {
          "person": "main.glasses",
          "expression": "SHOCKED"
         }
        },
        {
         "message": {
          "orig": "I'm so sorry. I tend to be a bit of an airhead sometimes.",
          "transl": "Tut mir wirklich leid, aber manchmal bin ich einfach etwas verpeilt."
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Hm...\\. Emilie isn't around?",
          "transl": "Hm...\\. Ist Emilie nicht bei dir?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "THOUGHTFUL"
         }
        },
        {
         "message": {
          "orig": "[shakes head]",
          "transl": "[хитає головою]"
         },
         "person": {
          "person": "main.lea",
          "expression": "SHAKE"
         }
        },
        {
         "message": {
          "orig": "Too bad, I didn't have the chance to meet her yet.",
          "transl": "Schade... Wir kennen uns nämlich auch noch nicht."
         },
         "person": {
          "person": "main.glasses",
          "expression": "TOWARD"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_TOWARD"
         }
        },
        {
         "message": {
          "orig": "So, since we're both here...",
          "transl": "Also, da wir beide schon mal hier sind..."
         },
         "person": {
          "person": "main.glasses",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "Did you already finish that \\c[3]Maroon Tree Quest\\c[0]?",
          "transl": "Hast du diese \\c[3]Maronenbaum-Quest\\c[0] schon erledigt?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "TOWARD"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SURPRISED_AWAY"
         }
        },
        {
