  {
   "settings": {
    "npcStates": [
     {
      "event": {
       "quest": [
        {
         "person": {
          "person": "main.glasses",
          "expression": "SMILE"
         }
        },
        {
         "person": {
          "person": "main.lea",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "There you are! Hello!",
          "transl": "А ось і ти! Привіт!"
         },
         "person": {
          "person": "main.glasses",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Hi!",
          "transl": "Привіт!"
         },
         "person": {
          "person": "main.lea",
          "expression": "EXCITED"
         }
        },
        {
         "message": {
          "orig": "So finally we meet...",
          "transl": "То ось ми й зустрілися..."
         },
         "person": {
          "person": "main.glasses",
          "expression": "DEFAULT"
         }
        },
        {
         "message": {
          "orig": "I already introduced myself before, right?",
          "transl": "Я ж уже представлявся, так?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "[nods]",
          "transl": "[киває]"
         },
         "person": {
          "person": "main.lea",
          "expression": "NOD"
         }
        },
        {
         "message": {
          "orig": "Well... I know \\c[3]C'tron\\c[0] is a bit strange. You can also call me \\c[3]Toby\\c[0] if you like.",
          "transl": "Ну... я знаю, що \\c[3]Сі'трон\\c[0] звучить трохи дивно. Можеш називати мене \\c[3]Тобі\\c[0], якщо хочеш."
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "Or \\c[3]Tronny\\c[0]. That's what all the guild members call me.",
          "transl": "Або \\c[3]Тронні\\c[0]. У гільдії всі мене так називають."
         },
         "person": {
          "person": "main.glasses",
          "expression": "WORRIED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "NERVOUS"
         }
        },
        {
         "message": {
          "orig": "...How?",
          "transl": "... Як?"
         },
         "person": {
          "person": "main.lea",
          "expression": "ANNOYED"
         }
        },
        {
         "message": {
          "orig": "Huh?",
          "transl": "Га?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "THOUGHTFUL"
         }
        },
        {
         "message": {
          "orig": "Drat! You can't speak! I forgot again!",
          "transl": "Трясця! Ти ж не можеш говорити! Я знову забув!"
         },
         "person": {
          "person": "main.glasses",
          "expression": "SHOCKED"
         }
        },
        {
         "message": {
          "orig": "I'm so sorry. I tend to be a bit of an airhead sometimes.",
          "transl": "Вибач. Я іноді буваю страшенно розсіяним."
         },
         "person": {
          "person": "main.glasses",
          "expression": "EMBARRASSED"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
         "person": {
          "person": "main.lea",
          "expression": "SMILE"
         }
        },
        {
         "message": {
          "orig": "Hm...\\. Emilie isn't around?",
          "transl": "Хм...\\. Емілі сьогодні немає?"
         },
         "person": {
          "person": "main.glasses",
          "expression": "THOUGHTFUL"
         }
        },
        {
         "message": {
          "orig": "[shakes head]",
          "transl": "[хитає головою]"
         },
         "person": {
          "person": "main.lea",
          "expression": "SHAKE"
         }
        },
        {
         "message": {
          "orig": "Too bad, I didn't have the chance to meet her yet.",
          "transl": "Шкода, я ще не мав нагоди з нею познайомитися."
         },
         "person": {
          "person": "main.glasses",
          "expression": "TOWARD"
         }
        },
        {
         "message": {
          "orig": "...",
          "transl": "..."
         },
