   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Good thing we found this spot. Why is it so hot?",
       "transl": "Gut, dass wir diesen Platz gefunden haben. Warum ist das hier so heiß?"
      }
     },
     {
      "text": {
       "orig": "Yeah! First freezing cold and now this?",
       "transl": "Ja, schrecklich! Erst arschkalt und jetzt sauheiß!"
      }
     },
     {
      "text": {
       "orig": "I don't know what you guys are talking about. I like the hot weather here.",
       "transl": "Ich weiß nicht, was ihr habt, Leute, ich mag das Wetter hier."
      }
     },
     {
      "text": {
       "orig": "You probably turned down your temperature sensitivity.",
       "transl": "Du hast vermutlich den Temperatursensor runtergestellt."
      }
     },
     {
      "text": {
       "orig": "Nope, I just really like the heat.",
       "transl": "Nö, ich mag einfach nur die Wärme."
      }
     },
     {
