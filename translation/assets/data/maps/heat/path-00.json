   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Good thing we found this spot. Why is it so hot?",
       "transl": "Пощастило, що є де сховатися. Чого тут так жарить?"
      }
     },
     {
      "text": {
       "orig": "Yeah! First freezing cold and now this?",
       "transl": "Ага! Мало було тої морозилки, а тепер таке?"
      }
     },
     {
      "text": {
       "orig": "I don't know what you guys are talking about. I like the hot weather here.",
       "transl": "Не розумію я вас. Мені от подобається така погода"
      }
     },
     {
      "text": {
       "orig": "You probably turned down your temperature sensitivity.",
       "transl": "Та ти, напевно, просто скрутила чутливість до температури."
      }
     },
     {
      "text": {
       "orig": "Nope, I just really like the heat.",
       "transl": "Ні, мені просто подобається тепло."
      }
     },
     {
      "text": {
       "orig": "I can't even...",
       "transl": "Це вже занадто..."
