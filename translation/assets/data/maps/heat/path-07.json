     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Woaah, \\v[lore.title.seeker]!\\. Those wicked rad scorpions sure were some thing.",
       "transl": "Woaah, Seeker!\\. Diese durchgeknallt Skorpione nicht ohne waren."
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Gave reading of high performance across all the parameter.\\. Sign of great machine parts and elite craft!",
       "transl": "Habe über alle Parameter hinweg hohe Leistung abgelesen.\\. Zeichen für großartig Maschinenteile und Spitzenhandwerk!"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Sad all of it went poof after receiving defeat.\\. But could find hint for location of secret lab!",
       "transl": "Aber nach Niederlage leider alles gelöst in Luft auf.\\. Konnte aber Hinweis auf Standort von Geheimlabor finden!"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Yes, yes, I am best information man of entire village.\\. Please admire but without distraction.",
       "transl": "Ja, ja, ich sein bester Informationsmann von ganze Dorf.\\. Bewundern erlaubt, aber davon nicht ablenken lassen."
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "When calm again, move to area of \\c[3]Long Piece\\c[0].\\. Next group there and very likely also the lab!",
       "transl": "Wenn wieder ruhig, du gehen in Bereich von \\c[3]Langes Stück\\c[0].\\. Nächste Gruppe dort und sehr wahrscheinlich auch Labor!"
