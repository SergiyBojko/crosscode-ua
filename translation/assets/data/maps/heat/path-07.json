  null,
  {
   "settings": {
    "event": [
     null,
     null,
     null,
     {
      "name": {
       "orig": "Ey'leet",
       "transl": "Ей'літ"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "person": {
       "person": "main.lea",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Woaah, \\v[lore.title.seeker]!\\. Those wicked rad scorpions sure were some thing.",
       "transl": "Ого, Шукачу!\\. Ті круті скорпіони це щось особливе."
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     },
     {
      "message": {
       "orig": "Gave reading of high performance across all the parameter.\\. Sign of great machine parts and elite craft!",
       "transl": "Бачив високі показники за всіма параметрами.\\. Значить добрі деталі й майстерна робота!"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Sad all of it went poof after receiving defeat.\\. But could find hint for location of secret lab!",
       "transl": "Шкода, все розчинилося в повітря.\\. Але знайшов підказку, де секретна лабораторія!"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     },
     {
      "message": {
       "orig": "Yes, yes, I am best information man of entire village.\\. Please admire but without distraction.",
       "transl": "Так, так, я найкращий інформаціянт в усьому селі.\\. Можеш захоплюватися, але без відволікання."
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "When calm again, move to area of \\c[3]Long Piece\\c[0].\\. Next group there and very likely also the lab!",
       "transl": "Коли знову спокійна, йди до \\c[3]Довга Фігура\\c[0].\\. Там наступна група і, дуже можливо, лабораторія!"
      },
      "person": {
       "person": "baki.male-steam1337",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Bye...",
       "transl": "Бувай..."
      },
      "person": {
       "person": "main.lea",
       "expression": "EXHAUSTED"
      }
     }
    ]
   }
  }
