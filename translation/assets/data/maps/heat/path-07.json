  {
   "settings": {
    "event": [
     null,
     {
      "message": {
       "orig": "They DID send me a message about the meeting, you see?",
       "transl": "OBWOHL sie eine Nachricht an alle Teilnehmer verschickt hatten."
      },
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "So guess what happened: it ended up as spam!",
       "transl": "Jetzt rate mal, was passiert ist? Genau! Im Spam-Ordner gelandet!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     },
     {
      "message": {
       "orig": "Of course I wouldn't see it. Who checks their spam on a regular basis, oui?",
       "transl": "Hab ich natürlich nicht gemerkt. Wer guckt schon regelmäßig in seinen Spam-Ordner rein?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Totally defeats the purpose.",
       "transl": "Das würde ja völlig den Zweck verfehlen, non?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[nickt]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
   }
  },
  null,
  null,
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Those are some really impressive stone arcs.",
       "transl": "Das sind wirklich beeindruckende Steinbögen."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "Those usually appear due to water erosion. There probably used to be a river at this place a long time ago.",
       "transl": "Die entstehen eigentlich durch Wassererosion. Wahrscheinlich war hier mal vor langer Zeit ein Fluss."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "...!",
