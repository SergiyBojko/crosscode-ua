  {
   "settings": {
    "event": [
     null,
     {
      "message": {
       "orig": "They DID send me a message about the meeting, you see?",
       "transl": "Звісно ж, вони мені НАПИСАЛИ, що має бути зустріч."
      },
      "person": {
       "person": "main.emilie",
       "expression": "MOPING"
      }
     },
     {
      "message": {
       "orig": "So guess what happened: it ended up as spam!",
       "transl": "І знаєш, що сталося? Те повідомлення потрапило в спам!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "EXHAUSTED"
      }
     },
     {
      "message": {
       "orig": "Of course I wouldn't see it. Who checks their spam on a regular basis, oui?",
       "transl": "Ну і звісно ж, я його не побачила. Хто взагалі регулярно перевіряє спам, oui?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "Totally defeats the purpose.",
       "transl": "Інакше який тоді в ньому сенс?"
      },
      "person": {
       "person": "main.emilie",
       "expression": "SUSPICIOUS"
      }
     },
     {
      "message": {
       "orig": "[nods]",
       "transl": "[киває]"
      },
      "person": {
       "person": "main.lea",
       "expression": "NOD"
      }
     }
    ]
   }
  },
  null,
  null,
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Those are some really impressive stone arcs.",
       "transl": "Ці кам'яні арки справді вражають."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "Those usually appear due to water erosion. There probably used to be a river at this place a long time ago.",
       "transl": "Зазвичай вони утворюються через водну ерозію. Мабуть, колись дуже давно тут текла річка."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "...!",
       "transl": "...!"
      },
      "person": {
       "person": "main.lea",
       "expression": "ASTONISHED"
      }
     }
    ]
   }
