  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "So, how is work?",
       "transl": "Ну що, як там робота?"
      }
     },
     {
      "text": {
       "orig": "Pretty good. \\c[3]ACF says we now have 50% of the galaxy mapped!\\c[0]",
       "transl": "Непогано. \\c[3]Кажуть, ми вже нанесли на карту більше 50% галактики!\\c[0]"
      },
      "event": [
       {
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "cross-worlds.hexacast-male-dark",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "Oh hey, you're interested in my job too?",
         "transl": "О, привіт, тобі теж цікаво, чим я займаюсь?"
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "She's an Explorer!",
         "transl": "Вона - Дослідниця!"
        },
        "person": {
         "person": "cross-worlds.hexacast-male-dark",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "ASTONISHED"
        }
       },
       {
        "message": {
         "orig": "Oh come on, it's not that big of a deal.",
         "transl": "Ой, та годі, в цьому немає нічого особливого."
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "I'm part of the \\v[lore.unlock.colony-federation]\\c[3]ACF's\\c[0] exploration team.",
         "transl": "Я в команді дослідників \\v[lore.unlock.colony-federation]\\c[3]УЗК\\c[0]."
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Once a year we're exploring and charting a new part of a larger sector.",
         "transl": "Раз на рік нам дають нову ділянку яку потрібно дослідити і картографувати."
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "It takes a long time as we can't just warp ourselves around.",
         "transl": "Та це займає багато часу, бо ми не можемо просто телепортуватися."
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "But it is pretty fun!",
         "transl": "Але це доволі весело!"
        },
        "person": {
         "person": "cross-worlds.pentafist-female-blue",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "And exciting!",
         "transl": "І захопливо!"
        },
        "person": {
         "person": "cross-worlds.hexacast-male-dark",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...!",
         "transl": "...!"
        },
        "person": {
         "person": "main.lea",
         "expression": "SMILE"
        }
       }
      ]
     },
     {
      "text": {
       "orig": "Oh boy! Only took us how long?",
       "transl": "Нічого собі! Скільки ж часу на це пішло?"
      }
     },
     {
      "text": {
       "orig": "Too long...",
       "transl": "Занадто багато..."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "More of these unique cliff structures...",
       "transl": "Знову ці дивні скельні утворення..."
      },
      "person": {
       "person": "main.glasses",
       "expression": "THOUGHTFUL"
      }
     },
     {
      "message": {
       "orig": "You sure you want to comment on those now? Better concentrate on jumping!",
       "transl": "Ти точно хочеш зараз це коментувати? Краще зосередься на стрибках!"
      },
      "person": {
       "person": "main.emilie",
       "expression": "CURIOUS"
      }
     }
    ]
   }
  }
 ]
