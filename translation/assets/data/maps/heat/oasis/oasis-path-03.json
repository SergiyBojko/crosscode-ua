   "settings": {
    "npcStates": [
     {
      "event": [
       {
        "name": {
         "orig": "Talatu Lips",
         "transl": "Талату Ліпс"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hey there sweetheart!",
         "transl": "Гей, серденько!"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "Phew, it's hotter'n blazes here, tell you what.",
         "transl": "Уф, тут гаряче, аж дух захоплює, от скажу тобі."
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "But the flora's quite a sight, ain't it?",
         "transl": "Але ж ота флора - очей не відвести, еге ж?"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Well, how 'bout y'all? Explorin' comin' along?",
         "transl": "Ну, а як у тебе? Мандри добре йдуть?"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED_TOWARD"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[киває]"
        },
        "person": {
         "person": "main.lea",
         "expression": "NOD"
        }
       },
       {
        "message": {
         "orig": "Glad ta hear it. Y'all be good now!",
         "transl": "Файно чути. Будь чемненька!"
        },
        "person": {
         "person": "greenies.female-researcher",
         "expression": "DEFAULT"
        }
       }
      ]
     }
