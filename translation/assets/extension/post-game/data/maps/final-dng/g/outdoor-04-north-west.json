  {
   "settings": {
    "event": [
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Such a huge crystal!\\. That's almost overkill to be honest.",
       "transl": "Was für ein riesiger Kristall! Das ist fast zu viel des Guten, um ehrlich zu sein."
      }
     },
     null,
     {
      "message": {
       "orig": "Oh yeah!\\. I heard about that one.",
       "transl": "Oh ja!\\. Davon habe ich gehört."
      }
     },
     {
      "message": {
       "orig": "This crystal serves as a unique landmark.",
       "transl": "Dieser Kristall dient als ein einzigartiger Wegpunkt."
      }
     },
     {
      "message": {
       "orig": "Apparently this helps players to not get lost.",
       "transl": "Offenbar hilft er den Spielern, sich nicht zu verirren."
      }
     },
     {
      "message": {
       "orig": "I see...",
       "transl": "Verstehe..."
      }
     },
     {
      "message": {
       "orig": "Thanks for the developer's commentary, I guess!",
       "transl": "Besten Dank für den Entwickler-Kommentar!"
      }
     },
     {
      "message": {
       "orig": "Let's go back!",
       "transl": "Lass uns zurückgehen!"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Wow!\\. So pretty.",
       "transl": "Wow!\\. Wie schön."
      }
     }
    ]
   }
  },
  null,
  null,
  {
   "settings": {
    "event": [
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "How is this POSSIBLE?!",
       "transl": "WIE ist das möglich?!"
      }
     },
     null,
     {
      "message": {
       "orig": "It was \\c[3]RIGHT THERE\\c[0]!",
       "transl": "Es war \\c[3]GENAU DA\\c[0]!"
      }
     },
     {
      "message": {
       "orig": "I don't know, it just happened!",
       "transl": "Ich weiß es nicht, es ist einfach passiert!"
      }
     },
     {
      "message": {
       "orig": "I mean...\\. you missed it as well, right?",
       "transl": "Ich meine...\\. Du hast es auch verpasst, oder?"
      }
     },
     {
      "message": {
       "orig": "Well, I jumped down without thinking because you were standing down here.",
       "transl": "Nun ja, ich bin ohne nachzudenken heruntergesprungen, weil du hier unten standest."
      }
     },
     {
      "message": {
       "orig": "Oh, so that's my fault now as well?",
       "transl": "Oh, dann ist das also auch meine Schuld?"
      }
     },
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "Hi...",
       "transl": "Hi..."
      }
     },
     null,
     {
      "message": {
       "orig": "Oh, hello Lea.",
       "transl": "Oh, hallo, Lea."
      }
     },
     {
      "message": {
       "orig": "What?",
       "transl": "Was?"
      }
     },
     {
      "message": {
       "orig": "Well...\\. we both jumped down here, but...",
       "transl": "Tja...\\. Wir sind beide hier runter gesprungen, aber..."
      }
     },
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "We forgot to press that floor switch first.",
       "transl": "Wir haben vergessen, vorher die Sprungplatte zu aktivieren."
      }
     },
     {
      "message": {
       "orig": "So the jump panel is still off and we're stuck down here.",
       "transl": "Die Sprungplatte ist also immer noch aus und wir sitzen hier unten fest."
      }
     },
     null,
     null,
     null,
     null,
     null,
     null,
     {
      "message": {
       "orig": "You remembered to push the switch, right?",
       "transl": "Du hast daran gedacht, die Platte zu aktivieren, oder?"
      }
     },
     {
      "thenStep": [
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        }
       },
       null,
       {
        "message": {
         "orig": "Good for you!",
         "transl": "Schön für dich dich!"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "...",
         "transl": "..."
        }
       },
       {
