  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "That's a whole lot of crystal enemies in this place!",
       "transl": "Gibt ganz schön viele Kristall-Gegner hier!"
      }
     },
     {
      "text": {
       "orig": "Let's crush them all and make colorful jewelry out of their remains!",
       "transl": "Am besten schmettern wir sie alle in Tausend Teile und machen bunten Schmuck draus!"
      }
     },
     {
      "text": {
       "orig": "Yuck!\\. You can't do that!",
       "transl": "Neee!\\. Kannste nich' machen!<<A<<[CHANGED 2021/05/22]"
      }
     },
     {
      "text": {
       "orig": "Yeah, I know...\\. one can only dream.",
       "transl": "Jaaa, weiß ich...\\. War nur so 'ne Idee."
      }
     },
     {
      "text": {
       "orig": "Please don't dream stuff like that!",
       "transl": "Du hast manchmal echt komische Ideen!"
      }
     }
    ]
   }
  },
