     {
      "thenStep": [
       {
        "message": {
         "orig": "Hah! Caught up with you, chérie!",
         "transl": "Hah! Hab dich eingeholt, Chérie!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "DETERMINED"
        }
       },
       {
        "message": {
         "orig": "That new wobbly puzzle thingee was a bit confusing at first...",
         "transl": "Das neue Wabbel-Rätsel-Ding war anfangs etwas verwirrend..."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       },
       {
        "message": {
         "orig": "But I got it now!\\. The race is still on!",
         "transl": "Aber jetzt habe ich den Dreh raus!\\. Das Rennen ist noch nicht vorbei!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "DETERMINED"
        }
       }
      ],
      "elseStep": [
       {
        "message": {
         "orig": "Hello, chérie!",
         "transl": "Hallo, Chérie!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Seems like most of the others are ahead, huh?",
         "transl": "Sieht so aus, als ob die anderen uns voraus sind, oder?"
        },
        "person": {
         "person": "main.emilie",
         "expression": "EXHAUSTED"
        }
       },
       {
        "message": {
         "orig": "Ah... who cares! It's not a race this time, oui?",
         "transl": "Aaach... egal! Diesmal machen wir kein Rennen draus, oui?"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       },
       {
        "message": {
         "orig": "I'll just take my sweet time!",
         "transl": "Diesmal nehme ich mir einfach die Zeit!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SHRUG"
        }
       }
