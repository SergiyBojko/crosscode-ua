   "settings": {
    "npcStates": [
     {
      "event": [
       null,
       null,
       {
        "message": {
         "orig": "Hey Lea!",
         "transl": "Hey, Lea!"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        }
       },
       {
        "message": {
         "orig": "You just fought those fast hummingbirds, didn't you?",
         "transl": "Du hast gerade gegen diese schnellen Kolibris gekämpft, oder?"
        }
       },
       {
        "message": {
         "orig": "[nods]",
         "transl": "[nickt]"
        }
       },
       {
        "message": {
         "orig": "Man, wished I could have seen it.",
         "transl": "Mann, das hätte ich gerne gesehen."
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        }
       },
       {
        "message": {
         "orig": "That fight was instanced.\\. You just barely notice it, though!",
         "transl": "Der Kampf war instanziert.\\. Man merkt es aber kaum!"
        }
       },
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       null,
       {
        "message": {
         "orig": "See?\\. This is how you appeared for me as well.",
         "transl": "Siehst du?\\. So bist du auch bei mir erschienen."
        }
       },
       {
        "message": {
         "orig": "I thought it would be perfect to play a little trick on somebody.",
         "transl": "Das wäre doch die perfekte Situation, jemandem einen kleinen Streich zu spielen."
        }
       },
       null,
       {
        "message": {
         "orig": "You know...\\. jumping right in front of them after they appear from the instance.",
         "transl": "Du weißt schon...\\. Direkt vor sie springen, nachdem sie aus der Instanz auftauchen!"
        }
       },
       {
        "message": {
         "orig": "Whhhyyyyy...?",
         "transl": "Waruuuuuum...?"
        }
       },
       {
        "message": {
         "orig": "Nyahahahahaha!",
         "transl": "Nyahahahahaha!"
        }
       },
       {
        "message": {
         "orig": "Unfortunately it's hard to pull that off in practice.",
         "transl": "Klappt in der Praxis leider nicht ganz so leicht."
        }
       },
       {
        "message": {
         "orig": "You never know where anyone will appear from exactly.",
         "transl": "Man weiß nämlich nie, woher jemand genau kommt."
        }
       },
       {
        "message": {
         "orig": "Oh well!\\. Time to move on!",
         "transl": "Na ja!\\. Machen wir mal weiter!"
        }
       }
      ]
     }
    ]
   }
