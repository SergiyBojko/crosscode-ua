  {
   "settings": {
    "event": [
     null,
     null,
     null,
     null,
     null,
     {
      "thenStep": [
       null,
       null,
       {
        "person": {
         "person": "main.emilie",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Bonjour, chérie!",
         "transl": "Bonjour, Chérie!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SMILE"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "I promised I'd call, non?",
         "transl": "Mein Anruf, wie versprochen!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "AWAY"
        }
       },
       {
        "message": {
         "orig": "Man, this dungeon has been going on for so long already...",
         "transl": "Boah, Mann, ey...\\. Dieser Dungeon geht mir viel zu lange..."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SWEATY_SMILE"
        }
       },
       {
        "message": {
         "orig": "But I think we're getting close to the finish line.",
         "transl": "Aber ich glaube, wir nähern uns langsam der Ziellinie."
        },
        "person": {
         "person": "main.emilie",
         "expression": "DETERMINED"
        }
       },
       {
        "thenStep": [
         {
          "message": {
           "orig": "Let us see who will be first!",
           "transl": "Mal sehen, wer Erster wird!"
          },
          "person": {
           "person": "main.emilie",
           "expression": "TAUNTING"
          }
         },
         {
          "message": {
           "orig": "...!",
           "transl": "...!"
          },
          "person": {
           "person": "main.lea",
           "expression": "DETERMINED"
          }
         }
        ],
        "elseStep": [
         {
          "message": {
           "orig": "[nods]",
           "transl": "[киває]"
          },
          "person": {
           "person": "main.lea",
           "expression": "NOD"
          }
         },
         {
          "message": {
           "orig": "Well... not that it really matters who'll be there first.",
           "transl": "Wobei das für mich jetzt nicht wirklich so wichtig ist, wer zuerst da sein wird."
          },
          "person": {
           "person": "main.emilie",
           "expression": "EMBARRASSED"
          }
         }
        ]
       },
       {
        "message": {
         "orig": "It has been really nice to run the dungeon with everyone else.",
         "transl": "Ich genieße das nämlich richtig, den Dungeon mit allen anderen machen zu können."
        },
        "person": {
         "person": "main.emilie",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Especially since there have been so many places where you can see other players.",
         "transl": "Zumal es so viele Orte gab, an denen man andere Spieler sehen konnte."
        },
        "person": {
         "person": "main.emilie",
         "expression": "AWAY"
        }
       },
       {
        "message": {
         "orig": "...",
         "transl": "..."
        },
        "person": {
         "person": "main.emilie",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "NERVOUS"
        }
       },
       {
        "message": {
         "orig": "And...\\. that will be it, I suppose?",
         "transl": "Tja...\\. Das war's dann wohl, nehme ich an?"
        },
        "person": {
         "person": "main.emilie",
         "expression": "CURIOUS"
        }
       },
       {
        "message": {
         "orig": "The final dungeon of CrossWorlds.",
         "transl": "Der letzte Dungeon von CrossWorlds."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SAD"
        }
       },
       {
        "message": {
         "orig": "The end of the game.",
         "transl": "Das Ende des Spiels."
        },
        "person": {
         "person": "main.emilie",
         "expression": "UNCERTAIN"
        }
       },
       {
        "message": {
         "orig": "[shakes head]",
         "transl": "[хитає головою]"
        },
        "person": {
         "person": "main.lea",
         "expression": "SHAKE_EYE_CLOSED"
        }
       },
       {
        "message": {
         "orig": "Wait...",
         "transl": "Зачекай..."
        },
        "person": {
         "person": "main.lea",
         "expression": "SAD"
        }
       },
       {
        "message": {
         "orig": "Don't worry, chérie!\\. It definitely won't be the end for me!",
         "transl": "Keine Sorge, Chérie!\\. Für mich ist das Spiel ganz sicher noch nicht zu Ende!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SMILE"
        }
       },
       {
        "message": {
         "orig": "...?",
         "transl": "...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "NERVOUS"
        }
       },
       {
        "message": {
         "orig": "Because you're in this game and you're my friend.",
         "transl": "Weil du in diesem Spiel bist und du meine Freundin bist."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SMILE"
        }
       },
       {
        "message": {
         "orig": "At the very least I'll login to drop by and visit you!",
         "transl": "Ich werde mich auf alle Fälle weiterhin einloggen, allein um dich zu besuchen!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Thanks...",
         "transl": "Дякую..."
        },
        "person": {
         "person": "main.lea",
         "expression": "TOUCHED"
        }
       },
       {
        "message": {
         "orig": "Come on, that's what friends do!",
         "transl": "Ach was, dafür sind Freunde doch da!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SMILE"
        }
       },
       {
        "message": {
         "orig": "See you at the end!",
         "transl": "Wir sehen uns am Ziel!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "DETERMINED"
        }
       },
       {
        "message": {
         "orig": "Bye!",
         "transl": "Бувай!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       }
      ]
     }
    ]
   }
