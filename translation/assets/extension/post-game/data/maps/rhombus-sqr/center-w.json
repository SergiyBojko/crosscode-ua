  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Homeowners only it said...",
       "transl": "Nur Hausbesitzer stand dort..."
      }
     },
     {
      "text": {
       "orig": "What a joke. I just wanna hang out with my friends at the private beach.",
       "transl": "Was für ein Witz. Ich will doch nur mit meinen Freunden am Privatstrand abhängen."
      }
     },
     {
      "text": {
       "orig": "I guess this is where they make all the money from, with all the content updates being free...",
       "transl": "Ich vermute mal, dass hier das ganze Geld verdient wird, da alle Content-Updates kostenlos sind..."
      }
     },
     {
      "text": {
       "orig": "That... actually makes sense. Dammit now I can't be mad.",
       "transl": "Das...\\. macht tatsächlich Sinn. Verdammt, jetzt kann ich nicht mehr sauer darüber sein."
      }
     }
    ]
   }
