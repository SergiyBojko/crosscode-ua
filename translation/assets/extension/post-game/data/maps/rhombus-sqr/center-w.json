  {
   "settings": {
    "analyzable": {
     "text": {
      "orig": "Cherry",
      "transl": "Cherry"
     }
    },
    "npcStates": [
     {
      "event": [
       {
        "name": {
         "orig": "Cherry",
         "transl": "Cherry"
        },
        "person": {
         "person": "guests.cherry",
         "expression": "DEFAULT"
        }
       },
       {
        "person": {
         "person": "main.lea",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi!",
         "transl": "Привіт!"
        },
        "person": {
         "person": "main.lea",
         "expression": "EXCITED"
        }
       },
       {
        "message": {
         "orig": "Great! Looks like I can just inject functionality by rewriting memory.",
         "transl": "Ey, super! Scheinbar kann ich neue Funktionen auch direkt in den Speicher schreiben."
        },
        "person": {
         "person": "guests.cherry",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi...",
         "transl": "Привіт..."
        },
        "person": {
         "person": "main.lea",
         "expression": "SURPRISED"
        }
       },
       {
        "message": {
         "orig": "This would mean no more replacing the executable...",
         "transl": "So muss ich die Programmdatei nicht immer ersetzen..."
        },
        "person": {
         "person": "guests.cherry",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Hi...?",
         "transl": "Привіт...?"
        },
        "person": {
         "person": "main.lea",
         "expression": "ANNOYED"
        }
       },
       {
        "message": {
         "orig": "Also UI changes should be feasible, maybe even inject entirely new UI.",
         "transl": "Außerdem sollten UI-Anpassungen machbar sein, vielleicht sogar eine ganz neue UI."
        },
        "person": {
         "person": "guests.cherry",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Maybe even highlight text commands... ",
         "transl": "Vielleicht kann ich sogar Texteingaben hervorheben..."
        },
        "person": {
         "person": "guests.cherry",
         "expression": "DEFAULT"
        }
       },
       {
        "message": {
         "orig": "Bye...",
         "transl": "Бувай..."
        },
        "person": {
         "person": "main.lea",
         "expression": "DISGUSTED"
        }
       }
      ]
     }
    ]
   }
