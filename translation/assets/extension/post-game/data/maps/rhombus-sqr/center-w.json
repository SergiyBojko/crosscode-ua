  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Please be advised to use the southern temporary bridge to cross the road safely.",
       "transl": "Bitte benutzen Sie die südliche Behelfsbrücke, um die Straße sicher zu überqueren."
      }
     },
     {
      "text": {
       "orig": "The new bridge will be finished soon.",
       "transl": "Die neue Brücke wird in Kürze fertiggestellt sein."
      }
     },
     {
      "text": {
       "orig": "This new bridge is sure gonna be a tight fit.",
       "transl": "Diese neue Brücke wird mit Sicherheit sehr eng sein."
      }
     },
     {
      "text": {
       "orig": "It's not like many people will use it anyway.",
       "transl": "Die werden wahrscheinlich sowieso nicht viele Leute benutzen."
      }
     },
     {
      "text": {
       "orig": "The rich folk over there have a personal teleporter. ",
       "transl": "Denn die reichen Leute da drüben haben einen eigenen Teleporter. "
      }
     },
     {
      "text": {
       "orig": "That's true.",
       "transl": "Stimmt."
      }
     }
    ]
   }
  },
