  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Huh...\\. those statues seem familiar.\\. Didn't expect to see those around here.",
       "transl": "Höh...\\. Diese Statuen kommen mir bekannt vor.\\. Hätte nicht erwartet, die hier zu sehen."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Well...\\. those faces sure are a landmark I suppose.",
       "transl": "Hm...\\. Diese Gesichter sind bestimmt ein Wegpunkt, nehme ich an."
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "message": {
       "orig": "Man, they really went full out with the jumping puzzles, didn't they?",
       "transl": "Oh Junge, mit den Sprungrätseln haben sie's aber auch wirklich, höh?"
      }
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "0": [
       {
        "message": {
         "orig": "It just!\\. Won't!\\. Stop!",
         "transl": "Es!\\. Hört!\\. Einfach!\\. Nicht!\\. Auf!"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "More...\\. stone...\\. hopping...",
         "transl": "Das Steinhüpfen nimmt kein Ende..."
        }
       }
      ],
      "2": [
       {
        "message": {
         "orig": "Japp, it surely would suck to miss a jump now.",
         "transl": "Japp, das wär' jetzt richtig übel, daneben zu springen."
        }
       }
      ],
      "3": [
       {
        "message": {
         "orig": "Better not slip now...",
         "transl": "Jetzt bloß nicht ausrutschen...<<A<<[CHANGED 2021/05/22]"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "0": [
       {
        "message": {
         "orig": "A checkpoint...\\. Is this end of this jumping trail or have the Ancients planned more for us?",
         "transl": "Ein Kontrollpunkt...\\. Das Ende des Sprungpfades oder haben die Ahnen noch mehr für uns geplant?<<A<<[CHANGED 2021/05/22]"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "Another Checkpoint!\\. So...\\. we're still not there yet?\\. Or is that it?",
         "transl": "Noch ein Kontrollpunkt!\\. Also...\\. sind wir immer noch nicht da?\\. Oder war's das jetzt endlich?"
        }
       }
      ],
      "2": [
       {
        "message": {
         "orig": "Another checkpoint?\\. This...\\. This is not it, isn't it? ",
         "transl": "Ein weiterer Kontrollpunkt?\\. Das...\\. Das war's noch nicht, oder? "
        }
       }
      ],
      "3": [
       {
        "message": {
         "orig": "It seems like this might be it...\\. but it probably isn't over yet.",
         "transl": "Sieht so aus, als wäre ein Ende in Sicht...\\. Oder auch nicht..."
        }
       }
      ]
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "0": [
       {
        "message": {
         "orig": "IT'S STILL NOT OVER YOU GOT TO BE KIDDING ME!!",
         "transl": "IMMER NOCH NICHT VORBEI!! DAS DARF DOCH NICHT WAHR SEIN!!"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "It...\\. still goes on.",
         "transl": "Es...\\. geht noch weiter..."
        }
       }
      ],
      "2": [
       {
        "message": {
         "orig": "Indeed, it looks the Ancients still have more plans for us.",
         "transl": "Es sieht in der Tat so aus, als hätten die Ahnen noch mehr Pläne mit uns."
        }
       }
      ],
      "3": [
       {
        "message": {
         "orig": "I was right again...\\. why do I have to be right again?!",
         "transl": "Ich hatte schon wieder recht...\\. Warum musste ich nur wieder recht haben?!"
        }
       }
      ]
     }
    ]
   }
  },
  null,
  null,
  null,
  null,
  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Whohooo~!",
       "transl": "Heeeerrlich!"
      }
     },
     {
      "text": {
       "orig": "Look at her go!",
       "transl": "Guck sie dir an!"
      }
     },
     {
      "text": {
       "orig": "Man, I wish they'd finally implement a proper swimming feature.",
       "transl": "Ach Mann, jetzt wünsch' ich mir wirklich, dass sie schon die Schwimmfunktion eingebaut hätten."
      }
     },
     {
      "text": {
       "orig": "This place is the best!",
       "transl": "Ein Träumchen ist das hier! Ein Träumchen!!"
      }
     }
    ]
   }
  }
 ]
