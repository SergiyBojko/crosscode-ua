  {
   "settings": {
    "dialog": [
     {
      "text": {
       "orig": "Hello, fellow Seeker!",
       "transl": "Hallo, Seeker-Kamerad!"
      }
     },
     {
      "text": {
       "orig": "Welcome to the Triblader corner!",
       "transl": "Willkommen zur Triblader-Ecke!"
      }
     },
     {
      "text": {
       "orig": "We wish you all the best on your journey.",
       "transl": "Wir wünschen dir alles Gute auf deinem Weg."
      }
     },
     {
      "text": {
       "orig": "Have a nice day!",
       "transl": "Einen schönen Tag noch!"
      }
     },
     {
      "text": {
       "orig": "And make sure to enjoy the weather!",
       "transl": "Und genieß das Wetter!"
      }
     }
    ]
   }
