  {
   "settings": {
    "event": [
     {
      "0": [
       {
        "message": {
         "orig": "As expected, the Ancients have prepared quite the formidable challenge!",
         "transl": "Wie erwartet, haben die Ahnen eine ziemlich gewaltige Herausforderung vorbereitet!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "SHOUTING"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "Oui...\\. It's going to be long.",
         "transl": "Oui...\\. Das wird lange dauern."
        },
        "person": {
         "person": "main.emilie",
         "expression": "SUSPICIOUS"
        }
       }
      ],
      "2": [
       {
        "message": {
         "orig": "And...\\. more jumping!",
         "transl": "Und...\\. noch mehr Springen!"
        },
        "person": {
         "person": "main.glasses",
         "expression": "EMBARRASSED"
        }
       }
      ],
      "3": [
       {
        "message": {
         "orig": "Looks like I was right...",
         "transl": "Sieht aus, als hätte ich recht gehabt..."
        },
        "person": {
         "person": "main.luke",
         "expression": "SKEPTICAL"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "settings": {
    "event": [
     {
      "0": [
       {
        "message": {
         "orig": "Oh it's a checkpoint!\\. How very nice of them.",
         "transl": "Oh, ein Kontrollpunkt!\\. Ist ja echt nett von denen."
        },
        "person": {
         "person": "main.luke",
         "expression": "EYES_CLOSED"
        }
       }
      ],
      "1": [
       {
        "message": {
         "orig": "Oh, that is a relief!\\. I was starting to get stressed out about the thought of falling down.",
         "transl": "Oh, was für eine Erleichterung!\\. Der Gedanke, herunterzufallen, hat mich nämlich schon ganz schön ins Schwitzen gebracht."
        },
        "person": {
         "person": "main.glasses",
         "expression": "EMBARRASSED"
        }
       }
      ],
      "2": [
       {
        "message": {
         "orig": "A checkpoint!\\. The Ancients mean well with us!",
         "transl": "Ein Kontrollpunkt!\\. Die Ahnen meinen es gut mit uns!"
        },
        "person": {
         "person": "antagonists.fancyguy",
         "expression": "CONTENT"
        }
       }
      ],
      "3": [
       {
        "message": {
         "orig": "Checkpoint! Nice!",
         "transl": "Kontrollpunkt!\\. Sehr schön!"
        },
        "person": {
         "person": "main.emilie",
         "expression": "SMILE"
        }
       }
      ]
     }
    ]
   }
  },
  null,
