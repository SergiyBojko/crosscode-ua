      "person": {
       "person": "main.luke",
       "expression": "LAUGH"
      }
     },
     {
      "person": {
       "person": "main.sergey-av",
       "expression": "DEFAULT"
      }
     },
     null,
     {
      "message": {
       "orig": "And yes...\\. That is pretty much all!",
       "transl": "Und ja...\\. Das wäre es so weit erst einmal!"
      },
      "person": {
       "person": "main.sergey-av",
       "expression": "DEFAULT"
      }
     },
     {
      "message": {
       "orig": "Thanks!",
       "transl": "Дякую!"
